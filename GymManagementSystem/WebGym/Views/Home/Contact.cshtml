@{
    ViewData["Title"] = "Liên Hệ";
}

<div class="text-center mb-5">
    <h1 class="fw-bold">Liên Hệ Với Chúng Tôi</h1>
    <p class="text-muted">Đội ngũ tư vấn luôn sẵn sàng hỗ trợ về gói tập, lịch PT 1-1 và lớp học nhóm</p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 text-center">
                <i class="bi bi-geo-alt-fill fs-1 text-danger mb-3"></i>
                <h5 class="fw-bold">Địa Chỉ</h5>
                <p class="text-muted mb-0">Tầng 3-4, Tòa nhà Pulse Fitness Center, Quận Cầu Giấy, Hà Nội</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 text-center">
                <i class="bi bi-telephone-fill fs-1 text-success mb-3"></i>
                <h5 class="fw-bold">Hotline &amp; Email</h5>
                <p class="text-muted mb-1">Hotline: <strong>1900 6868</strong></p>
                <p class="text-muted mb-0">Email: <strong>support@pulsegym.vn</strong></p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 text-center">
                <i class="bi bi-clock-fill fs-1 text-primary mb-3"></i>
                <h5 class="fw-bold">Giờ Mở Cửa</h5>
                <p class="text-muted mb-0">Thứ 2 – Chủ Nhật: <strong>05:00 – 23:00</strong></p>
            </div>
        </div>
    </div>
</div>
