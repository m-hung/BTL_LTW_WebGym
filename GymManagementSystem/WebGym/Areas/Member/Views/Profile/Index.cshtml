@model WebGym.Models.DTOs.Member.MemberProfileDto
@{
    ViewData["Title"] = "Chỉ Số Cơ Thể";
    var progressList = ViewBag.ProgressList as List<WebGym.Models.Entities.Progress> ?? new List<WebGym.Models.Entities.Progress>();
    double? bmi = (Model.Height > 0 && Model.Weight > 0) 
        ? Math.Round((double)Model.Weight.Value / Math.Pow((double)Model.Height.Value / 100, 2), 1) 
        : null;

    // Chuẩn bị dữ liệu cho Chart.js (Không dùng dữ liệu ảo cho tài khoản mới)
    var chartLabels = new List<string>();
    var weightData = new List<double>();
    var bodyFatData = new List<double>();
    bool hasProgressData = progressList.Any() && Model.Weight.HasValue && Model.Weight > 0;

    if (hasProgressData)
    {
        int step = 1;
        foreach (var p in progressList.OrderBy(x => x.RecordedDate))
        {
            chartLabels.Add($"T{step} ({p.RecordedDate:dd/MM})");
            weightData.Add(p.Weight);
            bodyFatData.Add(p.BodyFatPercentage ?? 0);
            step++;
        }
    }
}

<!-- 4 Key InBody Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="portal-stat-card">
            <div class="portal-stat-label" style="color: #b5bcaf;">
                <span>CÂN NẶNG</span>
            </div>
            <div class="portal-stat-val" style="color: #f2f5ef;">
                @if (Model.Weight > 0)
                {
                    @Model.Weight.Value.ToString("0.0") <span style="font-size: 15px; color: #9aa296; font-family: var(--portal-body); font-weight: normal;">kg</span>
                }
                else
                {
                    <span>--</span>
                }
            </div>
            <div class="portal-stat-sub" style="color: #a0a79c;">
                Chiều cao: @(Model.Height > 0 ? $"{Model.Height.Value:0} cm" : "--")
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="portal-stat-card">
            <div class="portal-stat-label" style="color: #b5bcaf;">
                <span>CHỈ SỐ BMI</span>
            </div>
            <div class="portal-stat-val" style="color: #f2f5ef;">
                @(bmi?.ToString("0.0") ?? "--")
            </div>
            <div class="portal-stat-sub">
                @if (bmi.HasValue)
                {
                    if (bmi < 18.5) { <span style="color: #8ed0e8;">Hơi gầy (Underweight)</span>; }
                    else if (bmi < 24.9) { <span style="color: #9dd872;">Chuẩn thể hình (Normal)</span>; }
                    else if (bmi < 29.9) { <span style="color: #f3c274;">Thừa cân (Overweight)</span>; }
                    else { <span style="color: #f38b8b;">Béo phì (Obese)</span>; }
                }
                else
                {
                    <span style="color: #a0a79c;">Chưa có dữ liệu InBody</span>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="portal-stat-card">
            <div class="portal-stat-label" style="color: #b5bcaf;">
                <span>TỶ LỆ MỠ CƠ THỂ</span>
            </div>
            <div class="portal-stat-val" style="color: #f2f5ef;">
                @if (Model.BodyFatPercentage > 0)
                {
                    @Model.BodyFatPercentage.Value.ToString("0.0") <span style="font-size: 15px; color: #9aa296; font-family: var(--portal-body); font-weight: normal;">%</span>
                }
                else
                {
                    <span>--</span>
                }
            </div>
            <div class="portal-stat-sub" style="color: #a0a79c;">
                Khối lượng cơ: @(Model.MuscleMass > 0 ? $"{Model.MuscleMass.Value:0.0} kg" : "--")
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="portal-stat-card">
            <div class="portal-stat-label" style="color: #b5bcaf;">
                <span>CHUYỂN HÓA BMR</span>
            </div>
            <div class="portal-stat-val" style="color: #f2f5ef;">
                @if (Model.BMR > 0)
                {
                    @Model.BMR.Value.ToString("0") <span style="font-size: 15px; color: #9aa296; font-family: var(--portal-body); font-weight: normal;">kcal</span>
                }
                else
                {
                    <span>--</span>
                }
            </div>
            <div class="portal-stat-sub" style="color: #a0a79c;">Tiêu hao năng lượng tối thiểu/ngày</div>
        </div>
    </div>
</div>

<!-- Detailed Body Measurements Grid (Vòng ngực, eo, mông, cơ bắp) -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="portal-stat-card py-3">
            <div class="portal-stat-label" style="color: #b5bcaf;">VÒNG NGỰC</div>
            <div class="portal-stat-val fs-3" style="color: #e5eae0;">
                @if (Model.Chest > 0)
                {
                    @Model.Chest.Value.ToString("0.0") <span style="font-size: 13px; color: #889084;">cm</span>
                }
                else
                {
                    <span>--</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="portal-stat-card py-3">
            <div class="portal-stat-label" style="color: #b5bcaf;">VÒNG EO</div>
            <div class="portal-stat-val fs-3" style="color: #e5eae0;">
                @if (Model.Waist > 0)
                {
                    @Model.Waist.Value.ToString("0.0") <span style="font-size: 13px; color: #889084;">cm</span>
                }
                else
                {
                    <span>--</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="portal-stat-card py-3">
            <div class="portal-stat-label" style="color: #b5bcaf;">VÒNG MÔNG</div>
            <div class="portal-stat-val fs-3" style="color: #e5eae0;">
                @if (Model.Hips > 0)
                {
                    @Model.Hips.Value.ToString("0.0") <span style="font-size: 13px; color: #889084;">cm</span>
                }
                else
                {
                    <span>--</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="portal-stat-card py-3">
            <div class="portal-stat-label" style="color: #b5bcaf;">KHỐI LƯỢNG CƠ</div>
            <div class="portal-stat-val fs-3" style="color: #e5eae0;">
                @if (Model.MuscleMass > 0)
                {
                    @Model.MuscleMass.Value.ToString("0.0") <span style="font-size: 13px; color: #889084;">kg</span>
                }
                else
                {
                    <span>--</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Evolution Line Chart (Yêu cầu 4 - Đồ thị biến thiên cân nặng & Body Fat) -->
<div class="portal-card p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
        <div>
            <h3 class="portal-title-accent mb-1 fs-3">BIẾN THIÊN <span>CÂN NẶNG & BODY FAT</span></h3>
            <div style="color: #a6ada2; font-size: 13.5px;">
                Theo dõi qua các lần đo InBody định kỳ
            </div>
        </div>

        @if (hasProgressData)
        {
            <!-- Chart Legend Indicator -->
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span style="width: 12px; height: 12px; border-radius: 50%; background-color: var(--portal-lime); display: inline-block;"></span>
                    <span class="small fw-semibold" style="color: #e5eae0;">Cân nặng (kg)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span style="width: 12px; height: 12px; border-radius: 50%; background-color: #48cae4; display: inline-block;"></span>
                    <span class="small fw-semibold" style="color: #e5eae0;">Body Fat (%)</span>
                </div>
            </div>
        }
    </div>

    @if (hasProgressData)
    {
        <!-- Chart Canvas Container -->
        <div style="position: relative; width: 100%; min-height: 320px; max-height: 420px;">
            <canvas id="inbodyChart"></canvas>
        </div>
    }
    else
    {
        <!-- Empty State: Chưa có dữ liệu InBody cho tài khoản mới -->
        <div class="text-center py-5 my-2" style="background: rgba(255, 255, 255, 0.01); border-radius: 8px; border: 1px dashed rgba(200, 255, 46, 0.25);">
            <div class="mb-3">
                <i class="bi bi-activity" style="font-size: 42px; color: var(--portal-lime); opacity: 0.85;"></i>
            </div>
            <h5 class="fw-bold mb-2" style="color: #f2f5ef; font-family: var(--portal-display); font-size: 19px; letter-spacing: 0.04em;">
                CHƯA CÓ DỮ LIỆU ĐO INBODY
            </h5>
            <p class="small mb-0 mx-auto" style="max-width: 500px; line-height: 1.6; color: #9aa296;">
                Tài khoản mới tạo chưa có lịch sử đo chỉ số cơ thể.
                Huấn luyện viên cá nhân (PT) sẽ tiến hành kiểm tra InBody và cập nhật tiến trình luyện tập của bạn tại phòng tập.
            </p>
        </div>
    }

    <!-- Notice Footer -->
    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <span class="small" style="color: #9aa296;">
            Ghi chú: Chỉ số được đo và cập nhật chuẩn xác bởi Huấn luyện viên (PT) thông qua thiết bị phân tích InBody chuyên dụng.
        </span>
        <a asp-area="Member" asp-controller="Booking" asp-action="Index" class="btn-pulse-outline btn-sm align-self-start align-self-md-auto text-nowrap">
            Đặt lịch đo lại chỉ số với PT
        </a>
    </div>
</div>

@section Scripts {
    <!-- Load Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (!hasProgressData) {
                <text>return;</text>
            }
            const ctx = document.getElementById('inbodyChart');
            if (!ctx) return;

            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartLabels));
            const weightData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(weightData));
            const bodyFatData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bodyFatData));

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Cân nặng (kg)',
                            data: weightData,
                            borderColor: '#c8ff2e',
                            backgroundColor: 'rgba(200, 255, 46, 0.12)',
                            pointBackgroundColor: '#c8ff2e',
                            pointBorderColor: '#0a0a0a',
                            pointBorderWidth: 2,
                            pointRadius: 6,
                            pointHoverRadius: 8,
                            tension: 0.25,
                            borderWidth: 3,
                            yAxisID: 'yWeight'
                        },
                        {
                            label: 'Body Fat (%)',
                            data: bodyFatData,
                            borderColor: '#48cae4',
                            backgroundColor: 'rgba(72, 202, 228, 0.08)',
                            pointBackgroundColor: '#48cae4',
                            pointBorderColor: '#0a0a0a',
                            pointBorderWidth: 2,
                            pointRadius: 6,
                            pointHoverRadius: 8,
                            borderDash: [6, 6],
                            tension: 0.25,
                            borderWidth: 2.5,
                            yAxisID: 'yFat'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: 'rgba(19, 23, 21, 0.95)',
                            titleColor: '#ffffff',
                            bodyColor: '#eef1eb',
                            borderColor: '#262e28',
                            borderWidth: 1,
                            padding: 12,
                            boxPadding: 6,
                            titleFont: {
                                family: 'Inter',
                                size: 14,
                                weight: '600'
                            },
                            bodyFont: {
                                family: 'Inter',
                                size: 13
                            },
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed.y !== null) {
                                        label += context.parsed.y + (context.datasetIndex === 0 ? ' kg' : ' %');
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                color: 'rgba(255, 255, 255, 0.05)',
                                drawBorder: false
                            },
                            ticks: {
                                color: '#b0b7ad',
                                font: {
                                    family: 'Inter',
                                    size: 12
                                }
                            }
                        },
                        yWeight: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            grid: {
                                color: 'rgba(255, 255, 255, 0.05)',
                                drawBorder: false
                            },
                            ticks: {
                                color: '#c8ff2e',
                                font: {
                                    family: 'Inter',
                                    size: 12,
                                    weight: '600'
                                },
                                callback: function(value) {
                                    return value + ' kg';
                                }
                            }
                        },
                        yFat: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            grid: {
                                drawOnChartArea: false
                            },
                            ticks: {
                                color: '#48cae4',
                                font: {
                                    family: 'Inter',
                                    size: 12,
                                    weight: '600'
                                },
                                callback: function(value) {
                                    return value + ' %';
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
