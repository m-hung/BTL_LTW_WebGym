@model WebGym.Models.DTOs.Admin.OrderFilterViewModel
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
}

<div class="container-fluid px-0">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center">
                <span class="badge bg-success bg-opacity-10 text-success p-2 me-2 rounded-3">
                    <i class="bi bi-receipt"></i>
                </span>
                Quản Lý Đơn Hàng
            </h3>
            <p class="text-muted mb-0 small">Theo dõi tất cả đơn bán lẻ tại quầy POS và đơn đặt online của hội viên.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="POS" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-calculator me-1"></i> Mở Quầy POS Bán Hàng
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-4 me-3 fs-4">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Tổng Doanh Thu Đơn</div>
                        <h4 class="fw-bold mb-0 text-success">@Model.TotalRevenue.ToString("N0") <small class="fs-6">đ</small></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 me-3 fs-4">
                        <i class="bi bi-cart-check-fill"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Tổng Đơn Hàng</div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalOrders</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-info bg-opacity-10 text-info p-3 rounded-4 me-3 fs-4">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Đơn Hoàn Thành</div>
                        <h4 class="fw-bold mb-0 text-info">@Model.CompletedOrders</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-4 me-3 fs-4">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Chờ Xử Lý / Đã Hủy</div>
                        <h4 class="fw-bold mb-0 text-warning">@(Model.PendingOrders + Model.CancelledOrders)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control bg-light border-0" placeholder="Mã đơn, Tên hoặc SĐT..." />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <select name="statusFilter" class="form-select bg-light border-0">
                        <option value="">-- Trạng thái --</option>
                        <option value="Hoàn thành" selected="@(Model.Status == "Hoàn thành")">Hoàn thành</option>
                        <option value="Đã thanh toán" selected="@(Model.Status == "Đã thanh toán")">Đã thanh toán</option>
                        <option value="Đang giao" selected="@(Model.Status == "Đang giao")">Đang giao</option>
                        <option value="Chờ xác nhận" selected="@(Model.Status == "Chờ xác nhận")">Chờ xác nhận</option>
                        <option value="Đã hủy" selected="@(Model.Status == "Đã hủy")">Đã hủy</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select name="paymentFilter" class="form-select bg-light border-0">
                        <option value="">-- Hình thức TT --</option>
                        <option value="Tiền mặt" selected="@(Model.PaymentMethod == "Tiền mặt")">Tiền mặt</option>
                        <option value="VNPay" selected="@(Model.PaymentMethod == "VNPay")">VNPay</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control bg-light border-0" title="Từ ngày" />
                </div>
                <div class="col-6 col-md-2">
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control bg-light border-0" title="Đến ngày" />
                </div>
                <div class="col-12 col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary rounded-3 w-100" title="Lọc đơn">
                        <i class="bi bi-funnel"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Status) || !string.IsNullOrEmpty(Model.PaymentMethod) || Model.FromDate.HasValue || Model.ToDate.HasValue || !string.IsNullOrEmpty(Model.SearchKeyword))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Đặt lại bộ lọc">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 110px;">MÃ ĐƠN</th>
                        <th>KHÁCH HÀNG</th>
                        <th>THỜI GIAN ĐẶT</th>
                        <th>SỐ MÓN</th>
                        <th>TỔNG TIỀN</th>
                        <th>THANH TOÁN</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-4" style="width: 150px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Orders.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-6 d-block mb-2 text-secondary opacity-50"></i>
                                Không tìm thấy đơn hàng nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model.Orders)
                        {
                            var statusBadge = order.Status switch
                            {
                                "Hoàn thành" => "badge-soft-success",
                                "Đã thanh toán" => "badge-soft-primary",
                                "Đang giao" => "badge-soft-info",
                                "Chờ xác nhận" => "badge-soft-warning",
                                "Đã hủy" => "badge-soft-danger",
                                _ => "badge-soft-secondary"
                            };

                            var customerName = order.Member?.User?.FullName ?? (order.User?.FullName ?? (order.ShippingAddress?.StartsWith("Khách vãng lai: ") == true ? order.ShippingAddress.Replace("Khách vãng lai: ", "") : "Khách lẻ tại quầy"));
                            var isMember = order.Member != null;

                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@order.OrderId" class="fw-bold text-primary text-decoration-none">
                                        #OD-@order.OrderId.ToString("D4")
                                    </a>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="me-2">
                                            @if (isMember)
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary p-2 rounded-circle">
                                                    <i class="bi bi-person-fill"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary p-2 rounded-circle">
                                                    <i class="bi bi-person-dash"></i>
                                                </span>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@customerName</div>
                                            <div class="text-muted small">
                                                @(order.PhoneNumber ?? "Không có SĐT")
                                                @if (isMember)
                                                {
                                                    <span class="badge bg-light text-primary border ms-1">Hội viên</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-secondary border ms-1">Khách vãng lai</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-dark">@order.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@order.OrderDate.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">
                                        @order.OrderDetails.Sum(od => od.Quantity) món
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-success fs-6">@order.TotalAmount.ToString("N0") đ</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 rounded-pill small">
                                        <i class="bi bi-credit-card me-1"></i>@order.PaymentMethod
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @statusBadge px-2 py-1 rounded-pill">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-outline-primary" title="Xem chi tiết hóa đơn">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="PrintReceipt" asp-route-id="@order.OrderId" target="_blank" class="btn btn-outline-secondary" title="In biên lai bán lẻ">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        @if (order.Status != "Đã hủy")
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-cancel-order"
                                                    data-id="@order.OrderId"
                                                    title="Hủy đơn & hoàn tồn kho">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Hidden Cancel Order Form -->
<form id="cancelOrderForm" method="post" asp-action="CancelOrder" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="cancelOrderId" name="id" value="" />
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const cancelButtons = document.querySelectorAll('.btn-cancel-order');
            cancelButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    Swal.fire({
                        title: 'Xác nhận hủy đơn hàng?',
                        text: `Bạn có chắc chắn muốn hủy đơn hàng #OD-${id.padStart(4, '0')}? Số lượng sản phẩm sẽ được tự động hoàn lại vào kho hàng.`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#ef4444',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'Đồng ý hủy đơn',
                        cancelButtonText: 'Quay lại'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const form = document.getElementById('cancelOrderForm');
                            document.getElementById('cancelOrderId').value = id;
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}

