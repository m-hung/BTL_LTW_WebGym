@model WebGym.Models.DTOs.Admin.MemberCreateViewModel
@{
    ViewData["Title"] = "Thêm Hội Viên Mới";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách hội viên
    </a>
    <h3 class="fw-bold text-dark mt-2">Đăng Ký Hội Viên Mới Tại Quầy</h3>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <h6 class="fw-bold text-primary mb-3"><i class="bi bi-person-badge me-2"></i>1. Thông Tin Tài Khoản</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="Username" class="form-control rounded-3 py-2" placeholder="username123" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="Password" type="password" class="form-control rounded-3 py-2" placeholder="Tối thiểu 6 ký tự" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="FullName" class="form-control rounded-3 py-2" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="Email" type="email" class="form-control rounded-3 py-2" placeholder="nguyenvana@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="PhoneNumber" class="form-control rounded-3 py-2" placeholder="0901234567" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Gender" class="form-label fw-bold small text-muted"></label>
                        <select asp-for="Gender" class="form-select rounded-3 py-2">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DateOfBirth" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="DateOfBirth" class="form-control rounded-3 py-2" />
                    </div>
                </div>

                <hr class="text-muted opacity-25 mb-4">

                <h6 class="fw-bold text-success mb-3"><i class="bi bi-heart-pulse me-2"></i>2. Chỉ Số Thể Chất & Số Đo Ban Đầu</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Height" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="Height" type="number" step="0.5" class="form-control rounded-start-3 py-2" placeholder="172" />
                            <span class="input-group-text bg-light text-muted">cm</span>
                        </div>
                        <span asp-validation-for="Height" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Weight" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="Weight" type="number" step="0.5" class="form-control rounded-start-3 py-2" placeholder="68.5" />
                            <span class="input-group-text bg-light text-muted">kg</span>
                        </div>
                        <span asp-validation-for="Weight" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BodyFatPercentage" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="BodyFatPercentage" type="number" step="0.1" class="form-control rounded-start-3 py-2" placeholder="18.5" />
                            <span class="input-group-text bg-light text-muted">%</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MuscleMass" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="MuscleMass" type="number" step="0.1" class="form-control rounded-start-3 py-2" placeholder="33.5" />
                            <span class="input-group-text bg-light text-muted">kg</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Chest" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="Chest" type="number" step="0.5" class="form-control rounded-start-3 py-2" placeholder="95" />
                            <span class="input-group-text bg-light text-muted">cm</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Waist" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="Waist" type="number" step="0.5" class="form-control rounded-start-3 py-2" placeholder="78" />
                            <span class="input-group-text bg-light text-muted">cm</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Hips" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="Hips" type="number" step="0.5" class="form-control rounded-start-3 py-2" placeholder="92" />
                            <span class="input-group-text bg-light text-muted">cm</span>
                        </div>
                    </div>
                </div>

                <hr class="text-muted opacity-25 mb-4">

                <h6 class="fw-bold text-warning mb-3"><i class="bi bi-credit-card me-2"></i>3. Kích Hoạt Gói Tập Ban Đầu (Tùy chọn)</h6>
                <div class="mb-4">
                    <label asp-for="SelectedPackageId" class="form-label fw-bold small text-muted"></label>
                    <select asp-for="SelectedPackageId" class="form-select rounded-3 py-2" asp-items="ViewBag.Packages">
                        <option value="">-- Chưa đăng ký gói ngay --</option>
                    </select>
                    <small class="text-muted">Nếu chọn gói tập, hệ thống sẽ tự động tạo gói hoạt động và ghi nhận thanh toán tiền mặt tại quầy.</small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 fw-bold shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Tạo Tài Khoản Hội Viên
                    </button>
                    <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-3 border">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>

