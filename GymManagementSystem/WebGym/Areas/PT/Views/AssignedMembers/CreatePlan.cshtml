@model WebGym.Models.DTOs.Trainer.WorkoutPlanDto
@{
    ViewData["Title"] = "Lên giáo án";
}

@section TopActions {
    <a class="cx-btn cx-btn--ghost" asp-action="Index">Quay lại danh sách</a>
}

@* Lưu ý: AssignedMembersController chưa có action CreatePlan (GET/POST) và DbContext chưa có bảng WorkoutPlans.
   View này đã sẵn giao diện; cần thêm action + migration thì mới dùng được. *@
<form asp-action="CreatePlan" method="post" class="cx-form">
    <input type="hidden" asp-for="MemberId" />
    <input type="hidden" asp-for="MemberName" />

    <header class="cx-form-head">
        <span class="cx-avatar cx-avatar--lg" aria-hidden="true">@CoachUi.Initials(Model.MemberName)</span>
        <div>
            <h2 class="cx-h2">Giáo án cho @Model.MemberName</h2>
            <p class="cx-sub">Học viên sẽ xem lộ trình tập và hướng dẫn dinh dưỡng này trong trang của mình.</p>
        </div>
    </header>

    <div asp-validation-summary="ModelOnly" class="cx-form-error"></div>

    <fieldset class="cx-fieldset">
        <legend>Mục tiêu và thời hạn</legend>
        <div class="cx-field">
            <label asp-for="Title">Tên lộ trình <abbr title="bắt buộc">*</abbr></label>
            <div class="cx-input"><input asp-for="Title" placeholder="Ví dụ: Giảm mỡ, giữ cơ trong 4 tuần" required /></div>
            <span asp-validation-for="Title" class="cx-field-err"></span>
        </div>
        <div class="cx-field">
            <label asp-for="Goal">Mục tiêu cụ thể</label>
            <div class="cx-input"><input asp-for="Goal" placeholder="Ví dụ: Giảm 3,5 kg mỡ, vòng eo dưới 78 cm" /></div>
        </div>
        <div class="cx-grid2">
            <div class="cx-field">
                <label asp-for="StartDate">Ngày bắt đầu</label>
                <div class="cx-input"><input asp-for="StartDate" type="date" /></div>
            </div>
            <div class="cx-field">
                <label asp-for="EndDate">Ngày kết thúc</label>
                <div class="cx-input"><input asp-for="EndDate" type="date" /></div>
            </div>
        </div>
    </fieldset>

    <fieldset class="cx-fieldset">
        <legend>Bài tập theo tuần</legend>
        <div class="cx-field">
            <label asp-for="RoutineDetails">Mỗi dòng một buổi: nhóm cơ, bài tập, số hiệp × số lần</label>
            <textarea asp-for="RoutineDetails" rows="7" placeholder="Thứ hai: Ngực, tay sau. Bench Press 4×10, Incline Dumbbell 3×12&#10;Thứ ba: Lưng, tay trước. Lat Pulldown 4×12, Barbell Row 4×10&#10;Thứ tư: Nghỉ, đi bộ nhẹ 20 phút"></textarea>
            <span asp-validation-for="RoutineDetails" class="cx-field-err"></span>
        </div>
    </fieldset>

    <fieldset class="cx-fieldset">
        <legend>Dinh dưỡng</legend>
        <div class="cx-field">
            <label asp-for="NutritionAdvice">Lượng calo, đạm và nước khuyến nghị</label>
            <textarea asp-for="NutritionAdvice" rows="3" placeholder="Ví dụ: 1,8 g đạm cho mỗi kg cân nặng, uống 2,5–3 lít nước mỗi ngày, hạn chế đồ ngọt."></textarea>
        </div>
    </fieldset>

    <div class="cx-form-bar">
        <button type="submit" class="cx-btn">Lưu và gửi cho học viên</button>
        <a class="cx-btn cx-btn--ghost" asp-action="Index">Huỷ</a>
    </div>
</form>
