@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject WebGym.Data.ApplicationDbContext Db
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var userName = User.Identity?.Name ?? "Huấn luyện viên";

    // Thông tin HLV đang đăng nhập + số yêu cầu chờ duyệt (hiện trên menu)
    var uid = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedId) ? parsedId : 0;
    var me = await Db.Trainers.AsNoTracking()
        .Where(t => t.UserId == uid)
        .Select(t => new { t.TrainerId, t.Specialization, t.AvatarUrl, t.Bio, t.User.FullName, t.User.Email, t.User.PhoneNumber })
        .FirstOrDefaultAsync();
    var pendingCount = me == null ? 0 : await Db.Bookings.CountAsync(b => b.TrainerId == me.TrainerId && b.Status == "Pending");
    var today = DateTime.Today;

    string NavClass(string controller) => "cx-link" + (currentController == controller ? " is-on" : "");
    string? Current(string controller) => currentController == controller ? "page" : null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pulse Gym Coach</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pt-portal.css" asp-append-version="true" />
</head>
<body class="cx">
    <a class="cx-skip" href="#cxMain">Bỏ qua menu</a>

    <div class="cx-shell">
        <!-- Menu bên trái (trên điện thoại: ngăn kéo mở bằng nút menu) -->
        <aside class="cx-side" id="cxSide" aria-label="Menu huấn luyện viên">
            <a class="cx-brand" asp-area="PT" asp-controller="Schedule" asp-action="Index">
                <i class="cx-bars" aria-hidden="true"></i>
                <span class="cx-brand-name">Pulse <b>Gym</b></span>
                <span class="cx-brand-tag">Coach</span>
            </a>

            <nav class="cx-nav">
                <a class="@NavClass("Schedule")" aria-current="@Current("Schedule")" asp-area="PT" asp-controller="Schedule" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="1.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
                    <span>Lịch dạy</span>
                </a>
                <a class="@NavClass("BookingApproval")" aria-current="@Current("BookingApproval")" asp-area="PT" asp-controller="BookingApproval" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l4.5 4.5L20 6" /></svg>
                    <span>Yêu cầu đặt lịch</span>
                    @if (pendingCount > 0)
                    {
                        <span class="cx-count" aria-label="@pendingCount yêu cầu đang chờ">@pendingCount</span>
                    }
                </a>
                <a class="@NavClass("AssignedMembers")" aria-current="@Current("AssignedMembers")" asp-area="PT" asp-controller="AssignedMembers" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8.5" r="3.5" /><path d="M2.5 20c.6-3.4 3.2-5.5 6.5-5.5s5.9 2.1 6.5 5.5M16 5.2a3.4 3.4 0 010 6.6M18.5 14.8c1.7.8 2.8 2.6 3 5.2" /></svg>
                    <span>Học viên</span>
                </a>

                <span class="cx-nav-sep" role="presentation"></span>

                <a class="cx-link" asp-area="" asp-controller="AI" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 01-11.6 7.1L4 20l1-4.6A8 8 0 1121 12z" /><path d="M13 8l-3 4h4l-3 4" /></svg>
                    <span>Trợ lý Pulse AI</span>
                </a>
                <a class="cx-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 11L12 4l8.5 7M6 9.5V20h12V9.5" /></svg>
                    <span>Trang chủ Pulse</span>
                </a>
            </nav>

            <div class="cx-me">
                <button type="button" class="cx-me-open" data-profile-open aria-controls="cxProfile" aria-expanded="false" title="Xem và sửa hồ sơ cá nhân">
                    <span class="cx-avatar" aria-hidden="true" data-profile-avatar>
                        @if (!string.IsNullOrWhiteSpace(me?.AvatarUrl))
                        {
                            <img src="@(me!.AvatarUrl)" alt="" loading="lazy" />
                        }
                        else
                        {
                            @WebGym.Helpers.CoachUi.Initials(userName)
                        }
                    </span>
                    <span class="cx-me-txt">
                        <strong data-profile-name>@userName</strong>
                        <small data-profile-spec>@(string.IsNullOrWhiteSpace(me?.Specialization) ? "Huấn luyện viên" : me!.Specialization)</small>
                    </span>
                    <span class="cx-visually-hidden">Mở hồ sơ cá nhân</span>
                </button>
                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="cx-logout">
                    <button type="submit" title="Đăng xuất" aria-label="Đăng xuất">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h5v16h-5M10 8l-4 4 4 4M6 12h10" /></svg>
                    </button>
                </form>
            </div>
        </aside>

        <div class="cx-main">
            <header class="cx-top" data-mark="Coach">
                <button type="button" class="cx-menu" aria-controls="cxSide" aria-expanded="false" aria-label="Mở menu">
                    <span></span><span></span><span></span>
                </button>
                <div class="cx-top-txt">
                    <p class="cx-today">@WebGym.Helpers.CoachUi.DayLong(today), @today.ToString("dd/MM/yyyy")</p>
                    <h1 class="cx-title">@ViewData["Title"]</h1>
                </div>
                <div class="cx-top-act">
                    @await RenderSectionAsync("TopActions", required: false)
                </div>
            </header>

            @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
            {
                <div class="cx-toasts" aria-live="polite">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="cx-toast cx-toast--ok" role="status">
                            <span>@TempData["SuccessMessage"]</span>
                            <button type="button" class="cx-toast-x" aria-label="Đóng thông báo">&times;</button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="cx-toast cx-toast--err" role="alert">
                            <span>@TempData["ErrorMessage"]</span>
                            <button type="button" class="cx-toast-x" aria-label="Đóng thông báo">&times;</button>
                        </div>
                    }
                </div>
            }

            <main class="cx-content" id="cxMain" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="cx-scrim" hidden></div>

    @if (me != null)
    {
        <!-- Bảng hồ sơ cá nhân: mở khi bấm ảnh đại diện ở góc dưới menu -->
        <div class="cx-drawer" id="cxProfile" role="dialog" aria-modal="true" aria-labelledby="cxProfileTitle" aria-hidden="true">
            <div class="cx-drawer-backdrop" data-profile-close></div>
            <section class="cx-drawer-panel">
                <header class="cx-drawer-head">
                    <h2 class="cx-h2" id="cxProfileTitle">Hồ sơ của bạn</h2>
                    <button type="button" class="cx-drawer-x" data-profile-close aria-label="Đóng hồ sơ">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                    </button>
                </header>

                <!-- Thẻ xem trước: học viên thấy bạn như thế này -->
                <div class="cx-card-preview" aria-live="polite">
                    <span class="cx-preview-photo" data-preview-photo>
                        @if (!string.IsNullOrWhiteSpace(me.AvatarUrl))
                        {
                            <img src="@me.AvatarUrl" alt="" />
                        }
                        else
                        {
                            <b>@WebGym.Helpers.CoachUi.Initials(me.FullName)</b>
                        }
                    </span>
                    <span class="cx-preview-txt">
                        <small>Học viên thấy bạn như thế này</small>
                        <strong data-preview-name>@me.FullName</strong>
                        <em data-preview-spec>@me.Specialization</em>
                    </span>
                </div>

                <form class="cx-profile-form" id="cxProfileForm" asp-area="PT" asp-controller="Profile" asp-action="Update" method="post" novalidate>
                    <div class="cx-drawer-notice" id="cxProfileNotice" role="status" hidden></div>

                    <fieldset class="cx-pf-group">
                        <legend>Thông tin liên hệ</legend>
                        <div class="cx-field">
                            <label for="pfName">Họ và tên</label>
                            <div class="cx-input"><input id="pfName" name="FullName" value="@me.FullName" maxlength="150" autocomplete="name" required /></div>
                            <p class="cx-field-err" data-err-for="FullName"></p>
                        </div>
                        <div class="cx-field">
                            <label for="pfEmail">Email đăng nhập</label>
                            <div class="cx-input"><input id="pfEmail" name="Email" type="email" value="@me.Email" maxlength="150" autocomplete="email" required /></div>
                            <p class="cx-field-err" data-err-for="Email"></p>
                        </div>
                        <div class="cx-field">
                            <label for="pfPhone">Số điện thoại</label>
                            <div class="cx-input"><input id="pfPhone" name="PhoneNumber" type="tel" value="@me.PhoneNumber" maxlength="20" autocomplete="tel" /></div>
                            <p class="cx-field-err" data-err-for="PhoneNumber"></p>
                        </div>
                    </fieldset>

                    <fieldset class="cx-pf-group">
                        <legend>Hồ sơ huấn luyện viên</legend>
                        <div class="cx-field">
                            <label for="pfSpec">Chuyên môn</label>
                            <div class="cx-input"><input id="pfSpec" name="Specialization" value="@me.Specialization" maxlength="200" placeholder="Ví dụ: Tăng cơ, giảm mỡ, HIIT" required /></div>
                            <p class="cx-field-err" data-err-for="Specialization"></p>
                        </div>
                        <div class="cx-field">
                            <label for="pfBio">Giới thiệu bản thân</label>
                            <textarea id="pfBio" name="Bio" rows="4" maxlength="1000" placeholder="Kinh nghiệm, chứng chỉ, phong cách huấn luyện…">@me.Bio</textarea>
                            <p class="cx-field-hint"><span data-bio-count>@(me.Bio?.Length ?? 0)</span>/1000 ký tự</p>
                            <p class="cx-field-err" data-err-for="Bio"></p>
                        </div>
                        <div class="cx-field">
                            <label for="pfAvatar">Ảnh đại diện (đường dẫn ảnh)</label>
                            <div class="cx-input"><input id="pfAvatar" name="AvatarUrl" type="url" value="@me.AvatarUrl" maxlength="500" placeholder="https://..." /></div>
                            <p class="cx-field-hint">Dán đường dẫn ảnh bắt đầu bằng https://. Để trống để dùng chữ viết tắt tên.</p>
                            <p class="cx-field-err" data-err-for="AvatarUrl"></p>
                        </div>
                    </fieldset>

                    <div class="cx-drawer-foot">
                        <button type="submit" class="cx-btn" id="cxProfileSave">Lưu hồ sơ</button>
                        <button type="button" class="cx-btn cx-btn--ghost" data-profile-close>Đóng</button>
                    </div>
                </form>
            </section>
        </div>
    }

    <script>
        (function () {
            var side = document.getElementById("cxSide");
            var btn = document.querySelector(".cx-menu");
            var scrim = document.querySelector(".cx-scrim");
            function setOpen(open) {
                document.body.classList.toggle("cx-nav-open", open);
                btn.setAttribute("aria-expanded", open ? "true" : "false");
                btn.setAttribute("aria-label", open ? "Đóng menu" : "Mở menu");
                scrim.hidden = !open;
                if (open) { var first = side.querySelector("a"); if (first) first.focus(); }
            }
            btn.addEventListener("click", function () { setOpen(!document.body.classList.contains("cx-nav-open")); });
            scrim.addEventListener("click", function () { setOpen(false); });
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && document.body.classList.contains("cx-nav-open")) { setOpen(false); btn.focus(); }
            });
            document.addEventListener("click", function (e) {
                var x = e.target.closest(".cx-toast-x");
                if (x) x.parentElement.remove();
            });
        })();
    </script>
    <script src="~/js/pt-profile.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
