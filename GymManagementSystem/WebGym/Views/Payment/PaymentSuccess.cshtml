@model WebGym.Models.Entities.Payment
@{
    ViewData["Title"] = "Thanh Toán Thành Công";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow rounded-4 p-5">
            <div class="text-success mb-3">
                <i class="bi bi-check-circle-fill" style="font-size: 5rem;"></i>
            </div>
            <h2 class="fw-bold text-success mb-3">Thanh Toán Thành Công!</h2>
            <p class="text-muted">Cảm ơn bạn đã đăng ký gói tập tại hệ thống WebGym. Thẻ tập đã được kích hoạt và email xác nhận đã gửi đến bạn.</p>

            <div class="bg-light p-3 rounded-3 text-start my-3">
                <p class="mb-1"><strong>Mã giao dịch:</strong> <code>@Model.TransactionCode</code></p>
                <p class="mb-1"><strong>Gói tập:</strong> @Model.Package?.PackageName</p>
                <p class="mb-1"><strong>Phương thức:</strong> @Model.PaymentMethod</p>
                <p class="mb-1"><strong>Số tiền:</strong> @Model.Amount.ToString("N0") VNĐ</p>
                <p class="mb-0"><strong>Thời gian:</strong> @Model.PaymentDate.ToString("dd/MM/yyyy HH:mm")</p>
            </div>

            <div class="mt-4">
                <a asp-area="Member" asp-controller="Profile" asp-action="Index" class="btn btn-primary px-4 py-2 me-2">Vào Trang Cá Nhân</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Về Trang Chủ</a>
            </div>
        </div>
    </div>
</div>
