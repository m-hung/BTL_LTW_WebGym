@model WebGym.Models.DTOs.Trainer.RecordProgressDto
@{
    ViewData["Title"] = "Cập Nhật Chỉ Số InBody";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h4 class="fw-bold mb-3"><i class="bi bi-speedometer text-primary me-2"></i> Đo Chỉ Số InBody Cho Học Viên: @Model.MemberName</h4>

            <form asp-action="RecordProgress" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MemberId" />
                <input type="hidden" asp-for="MemberName" />

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Weight" class="form-label fw-bold">Cân nặng (kg)</label>
                        <input asp-for="Weight" class="form-control" type="number" step="0.1" required />
                        <span asp-validation-for="Weight" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BodyFatPercentage" class="form-label fw-bold">Tỷ lệ mỡ Body Fat (%)</label>
                        <input asp-for="BodyFatPercentage" class="form-control" type="number" step="0.1" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MuscleMass" class="form-label fw-bold">Khối lượng cơ (kg)</label>
                        <input asp-for="MuscleMass" class="form-control" type="number" step="0.1" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Chest" class="form-label fw-bold">Vòng ngực (cm)</label>
                        <input asp-for="Chest" class="form-control" type="number" step="0.1" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Waist" class="form-label fw-bold">Vòng eo (cm)</label>
                        <input asp-for="Waist" class="form-control" type="number" step="0.1" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Hips" class="form-label fw-bold">Vòng hông (cm)</label>
                        <input asp-for="Hips" class="form-control" type="number" step="0.1" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label fw-bold">Nhận xét & đánh giá của HLV</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Ví dụ: Cơ bụng săn chắc hơn, cần tăng cường bổ sung protein..."></textarea>
                </div>

                <button type="submit" class="btn btn-warning px-4 fw-bold">
                    <i class="bi bi-check-circle-fill me-1"></i> Lưu Kết Quả Đo
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Quay Lại</a>
            </form>
        </div>
    </div>
</div>
