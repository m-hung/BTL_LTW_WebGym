@model WebGym.Models.DTOs.Admin.EquipmentFormViewModel
@{
    ViewData["Title"] = "Chỉnh Sửa Thiết Bị";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-muted small">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách thiết bị
            </a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm bg-white">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-warning">
                        <i class="bi bi-pencil-square fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Chỉnh Sửa Thiết Bị / Máy Móc</h4>
                        <p class="text-muted small mb-0">Cập nhật thông tin kỹ thuật, tình trạng vận hành và vị trí máy.</p>
                    </div>
                </div>

                <form asp-action="Edit" asp-route-id="@Model.EquipmentId" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EquipmentId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="EquipmentName" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="EquipmentName" class="form-control rounded-3" />
                            <span asp-validation-for="EquipmentName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="SerialNumber" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="SerialNumber" class="form-control rounded-3" />
                            <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Brand" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="Brand" class="form-control rounded-3" />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Area" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Area" class="form-select rounded-3">
                                <option value="Khu tạ tự do">Khu tạ tự do (Free Weights)</option>
                                <option value="Khu cardio">Khu cardio (Máy chạy, Xe đạp, Chèo)</option>
                                <option value="Khu máy khối">Khu máy khối (Pin-loaded Machines)</option>
                                <option value="Khu chức năng">Khu chức năng (Functional / Crossfit)</option>
                                <option value="Khu tập cơ chân">Khu tập cơ chân</option>
                            </select>
                            <span asp-validation-for="Area" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="RoomId" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="RoomId" class="form-select rounded-3" asp-items="ViewBag.RoomsList">
                                <option value="">-- Chưa gán phòng cụ thể --</option>
                            </select>
                            <span asp-validation-for="RoomId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PurchaseDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="PurchaseDate" type="date" class="form-control rounded-3" />
                            <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="LastMaintenanceDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="LastMaintenanceDate" type="date" class="form-control rounded-3" />
                            <span asp-validation-for="LastMaintenanceDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Status" class="form-select rounded-3">
                                <option value="Hoạt động tốt">Hoạt động tốt</option>
                                <option value="Cần bảo trì">Cần bảo trì</option>
                                <option value="Đang hỏng">Đang hỏng</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">Tải lên ảnh mới (thay thế ảnh cũ nếu có)</label>
                            <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ImageUrl" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="ImageUrl" class="form-control rounded-3" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Notes" class="form-control rounded-3" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 px-4">Hủy</a>
                        <button type="submit" class="btn btn-warning rounded-3 px-4 fw-semibold text-dark">
                            <i class="bi bi-check-lg me-1"></i> Cập Nhật Thiết Bị
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

