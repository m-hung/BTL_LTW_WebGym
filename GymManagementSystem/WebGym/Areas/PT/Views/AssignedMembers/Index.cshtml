@model IEnumerable<WebGym.Models.Entities.Member>
@{
    ViewData["Title"] = "Học Viên Phụ Trách";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold"><i class="bi bi-people-fill text-primary me-2"></i> Danh Sách Học Viên Của Bạn</h3>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Học Viên</th>
                    <th>Email</th>
                    <th>Số Điện Thoại</th>
                    <th>Chỉ Số Hiện Tại</th>
                    <th>Gói Tập</th>
                    <th>Cập Nhật InBody</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var m in Model)
                    {
                        var activeSub = m.Subscriptions.OrderByDescending(s => s.StartDate).FirstOrDefault(s => s.Status == "Active");
                        <tr>
                            <td class="fw-bold">@m.User.FullName</td>
                            <td>@m.User.Email</td>
                            <td>@(m.User.PhoneNumber ?? "Chưa có")</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(m.Weight.HasValue ? $"{m.Weight}kg" : "-") | @(m.BodyFatPercentage.HasValue ? $"{m.BodyFatPercentage}% mỡ" : "-")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">@(activeSub?.Package.PackageName ?? "Chưa đăng ký")</span>
                            </td>
                            <td>
                                <a asp-action="RecordProgress" asp-route-memberId="@m.MemberId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-speedometer2 me-1"></i> Đo InBody
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Chưa có học viên nào được phân công.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
