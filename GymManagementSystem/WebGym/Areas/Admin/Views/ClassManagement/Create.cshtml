@model WebGym.Models.DTOs.Admin.GymClassFormViewModel
@{
    ViewData["Title"] = "Tạo Lớp Học Nhóm Mới";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-muted small">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách lớp học
            </a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm bg-white">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary">
                        <i class="bi bi-person-video3 fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Tạo Lớp Học Nhóm Mới</h4>
                        <p class="text-muted small mb-0">Thiết lập thông tin môn học, lịch dạy, phân công huấn luyện viên và chọn phòng tập.</p>
                    </div>
                </div>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="ClassName" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="ClassName" class="form-control rounded-3" placeholder="Ví dụ: Yoga Buổi Sáng, Zumba Đốt Mỡ, BodyPump, Kickboxing..." />
                            <span asp-validation-for="ClassName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Status" class="form-select rounded-3">
                                <option value="Open">Mở đăng ký (Open)</option>
                                <option value="Full">Đã đầy (Full)</option>
                                <option value="Completed">Hoàn thành (Completed)</option>
                                <option value="Cancelled">Tạm ngưng / Hủy</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TrainerId" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="TrainerId" class="form-select rounded-3" asp-items="ViewBag.TrainersList">
                                <option value="">-- Chọn HLV phụ trách --</option>
                            </select>
                            <span asp-validation-for="TrainerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RoomId" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="RoomId" class="form-select rounded-3" asp-items="ViewBag.RoomsList">
                                <option value="">-- Chưa gán phòng cụ thể --</option>
                            </select>
                            <span asp-validation-for="RoomId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Schedule" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="Schedule" class="form-control rounded-3" placeholder="Ví dụ: Thứ 2 - 4 - 6 (18:00 - 19:30)" />
                            <span asp-validation-for="Schedule" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MaxCapacity" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <input asp-for="MaxCapacity" type="number" class="form-control rounded-start-3" min="1" max="200" />
                                <span class="input-group-text bg-light text-muted">học viên</span>
                            </div>
                            <span asp-validation-for="MaxCapacity" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="StartDate" type="date" class="form-control rounded-3" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="EndDate" type="date" class="form-control rounded-3" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">Tải lên ảnh bìa lớp học</label>
                            <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ImageUrl" class="form-label fw-semibold text-dark small">Hoặc nhập link URL ảnh</label>
                            <input asp-for="ImageUrl" class="form-control rounded-3" placeholder="https://example.com/class.jpg" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="3" 
                                      placeholder="Mô tả nội dung giáo trình, lợi ích thể chất, trang phục cần chuẩn bị..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 px-4">Hủy</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Lưu Lớp Học
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

