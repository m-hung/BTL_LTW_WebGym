@inject WebGym.Data.ApplicationDbContext _context
@using Microsoft.EntityFrameworkCore
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var userName = User.Identity?.Name ?? "Hội Viên";
    
    string currentPackageName = "Chưa có gói tập";
    string? userAvatar = null;
    var userIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    if (int.TryParse(userIdStr, out var uId))
    {
        var member = _context.Members
            .Include(m => m.Subscriptions)
                .ThenInclude(s => s.Package)
            .Include(m => m.User)
            .FirstOrDefault(m => m.UserId == uId);
            
        if (member != null)
        {
            if (!string.IsNullOrEmpty(member.User.FullName))
            {
                userName = member.User.FullName;
            }
            var activeSub = member.Subscriptions
                .OrderByDescending(s => s.StartDate)
                .FirstOrDefault(s => s.Status == "Active");
            if (activeSub != null)
            {
                currentPackageName = activeSub.Package.PackageName;
            }

            if (!string.IsNullOrEmpty(member.AvatarUrl))
            {
                userAvatar = member.AvatarUrl;
            }
        }
        
        if (string.IsNullOrEmpty(userAvatar))
        {
            var avatarDiskPath = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "uploads", "avatars", $"user_{uId}.jpg");
            if (System.IO.File.Exists(avatarDiskPath))
            {
                userAvatar = $"/uploads/avatars/user_{uId}.jpg";
            }
        }
    }

    var defaultAvatar = Url.Content("~/images/default-avatar.svg");
    var resolvedAvatar = !string.IsNullOrWhiteSpace(userAvatar)
        ? (userAvatar.StartsWith("http", StringComparison.OrdinalIgnoreCase) 
            ? userAvatar 
            : Url.Content(userAvatar.StartsWith("~") ? userAvatar : (userAvatar.StartsWith("/") ? userAvatar : "~/images/" + userAvatar)))
        : defaultAvatar;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pulse Gym Member</title>
    <!-- Fonts Pulse Gym (Hỗ trợ 100% tiếng Việt chuẩn có dấu: Barlow Condensed, Oswald, Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- CSS Libs -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/pulse-portal.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="portal-body">
    <!-- Backdrop for mobile sidebar -->
    <div class="portal-backdrop" id="portalBackdrop"></div>

    <div class="portal-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="portal-sidebar" id="portalSidebar">
            <!-- Brand / Logo (Trang chủ portal dẫn về Thông Tin Cá Nhân) -->
            <a asp-area="Member" asp-controller="Profile" asp-action="PersonalInfo" class="portal-brand">
                <i class="portal-logo-bars"></i>
                <div>
                    <div class="brand-title">PULSE <span>GYM</span></div>
                    <span class="portal-badge-role badge-role-member">HỘI VIÊN PORTAL</span>
                </div>
            </a>

            <!-- User Quick Snippet (Yêu cầu 2: Dưới tên hiển thị tên gói tập) -->
            <div class="portal-user-card">
                <div class="portal-user-avatar">
                    <img src="@resolvedAvatar" asp-append-version="true" alt="@userName" id="sidebarAvatarImg" />
                </div>
                <div class="portal-user-info">
                    <div class="portal-user-name" title="@userName">@userName</div>
                    <div class="portal-user-sub" style="color: var(--portal-lime); font-weight: 600; font-size: 12px; line-height: 1.35; word-break: break-word;" title="@currentPackageName">
                        @currentPackageName
                    </div>
                </div>
            </div>

            <!-- Main Menu (Yêu cầu 3, 4, 6) -->
            <div class="portal-nav-group-title">Không gian tập luyện</div>
            <ul class="portal-nav-list">
                <li>
                    <a asp-area="Member" asp-controller="Profile" asp-action="PersonalInfo" 
                       class="portal-nav-link @(currentController == "Profile" && currentAction == "PersonalInfo" ? "active" : "")">
                        <span>Thông Tin Cá Nhân</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Member" asp-controller="Profile" asp-action="Index" 
                       class="portal-nav-link @(currentController == "Profile" && currentAction == "Index" ? "active" : "")">
                        <span>Chỉ Số Cơ Thể</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Member" asp-controller="Booking" asp-action="Index" 
                       class="portal-nav-link @(currentController == "Booking" ? "active" : "")">
                        <span>Đặt Lịch Huấn Luyện Viên</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Member" asp-controller="Plan" asp-action="Index" 
                       class="portal-nav-link @(currentController == "Plan" ? "active" : "")">
                        <span>Giáo Án Của Tôi</span>
                    </a>
                    <a asp-area="Member" asp-controller="ClassBooking" asp-action="Index" 
                       class="portal-nav-link @(currentController == "ClassBooking" && currentAction == "Index" && Context.Request.Query["tab"] != "my-classes" ? "active" : "")">
                        <span>Đăng Ký Lớp Tập</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Member" asp-controller="ClassBooking" asp-action="MySchedule" 
                       class="portal-nav-link @(currentController == "ClassBooking" && (currentAction == "MySchedule" || Context.Request.Query["tab"] == "my-classes") ? "active" : "")">
                        <span>Lịch Tập Của Tôi</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Member" asp-controller="WorkoutSchedule" asp-action="Index" 
                       class="portal-nav-link @(currentController == "WorkoutSchedule" ? "active" : "")">
                        <span>Gói Tập</span>
                    </a>
                </li>
            </ul>

            <div class="portal-nav-group-title">Tiện ích thông minh</div>
            <ul class="portal-nav-list">
                <li>
                    <a asp-area="" asp-controller="AI" asp-action="Index" class="portal-nav-link">
                        <span class="text-info fw-semibold">Hỏi Đáp AI Fitness</span>
                    </a>
                </li>
            </ul>

            <!-- Sidebar Footer Actions -->
            <div class="portal-sidebar-footer">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="portal-btn-footer portal-btn-ghost">
                    Về Trang Chủ
                </a>
                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="portal-btn-footer portal-btn-danger">
                        Đăng Xuất
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Workspace -->
        <div class="portal-main">
            <!-- Topbar Header (Tối ưu responsive, tránh chạm chữ trên mobile) -->
            <header class="portal-topbar">
                <div class="portal-topbar-left">
                    <button type="button" class="portal-menu-toggle d-lg-none" id="sidebarToggle" aria-label="Toggle navigation">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <h1 class="portal-topbar-title mb-0">
                        <span>@ViewData["Title"]</span>
                    </h1>
                </div>
                <div class="portal-topbar-actions">
                    <span class="text-secondary small d-none d-md-inline">
                        Hệ thống sẵn sàng
                    </span>
                    <a asp-area="Member" asp-controller="Booking" asp-action="Index" class="btn-pulse-primary btn-sm d-none d-sm-inline-flex">
                        Đặt lịch PT
                    </a>
                </div>
            </header>

            <!-- Page Content Body -->
            <main class="portal-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="portal-alert portal-alert-success" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <span>@TempData["SuccessMessage"]</span>
                        </div>
                        <button type="button" class="portal-alert-close" onclick="this.parentElement.remove();">&times;</button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="portal-alert portal-alert-danger" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <span>@TempData["ErrorMessage"]</span>
                        </div>
                        <button type="button" class="portal-alert-close" onclick="this.parentElement.remove();">&times;</button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Xử lý Toggle Menu trên Mobile (Yêu cầu 1)
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('portalSidebar');
            const toggleBtn = document.getElementById('sidebarToggle');
            const backdrop = document.getElementById('portalBackdrop');

            if (toggleBtn && sidebar && backdrop) {
                toggleBtn.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                    backdrop.classList.toggle('show');
                });

                backdrop.addEventListener('click', function () {
                    sidebar.classList.remove('show');
                    backdrop.classList.remove('show');
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
