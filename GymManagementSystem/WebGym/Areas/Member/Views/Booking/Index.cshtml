@model IEnumerable<WebGym.Models.Entities.Booking>
@{
    ViewData["Title"] = "Đặt Lịch Huấn Luyện Viên";
    var trainers = ViewBag.Trainers as List<WebGym.Models.Entities.Trainer>;
}

<div class="row">
    <!-- Booking Form -->
    <div class="col-lg-4 mb-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-calendar-plus text-primary me-2"></i> Đăng Ký Lịch Tập Mới</h5>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-bold">Chọn Huấn Luyện Viên</label>
                    <select name="TrainerId" class="form-select" required>
                        <option value="">-- Chọn HLV phù hợp --</option>
                        @if (trainers != null)
                        {
                            foreach (var t in trainers)
                            {
                                <option value="@t.TrainerId">@t.User.FullName (@t.Specialization)</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Ngày Tập</label>
                    <input type="date" name="BookingDate" class="form-control" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Khung Giờ Tập (TimeSlot)</label>
                    <select name="TimeSlot" class="form-select" required>
                        <option value="08:00 - 09:30">08:00 - 09:30 (Buổi Sáng)</option>
                        <option value="09:30 - 11:00">09:30 - 11:00 (Buổi Sáng)</option>
                        <option value="14:00 - 15:30">14:00 - 15:30 (Buổi Chiều)</option>
                        <option value="16:00 - 17:30">16:00 - 17:30 (Buổi Chiều)</option>
                        <option value="17:30 - 19:00">17:30 - 19:00 (Khung Giờ Vàng)</option>
                        <option value="19:00 - 20:30">19:00 - 20:30 (Buổi Tối)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Ghi Chú Cho HLV</label>
                    <textarea name="Notes" class="form-control" rows="2" placeholder="Ví dụ: Tập trung bài tập ngực & tay sau, đau nhẹ cổ chân..."></textarea>
                </div>

                <button type="submit" class="btn btn-warning w-100 fw-bold py-2">
                    <i class="bi bi-send-check me-1"></i> Gửi Yêu Cầu Đặt Lịch
                </button>
            </form>
        </div>
    </div>

    <!-- Booking History -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-clock-history text-success me-2"></i> Lịch Sử Đặt Lịch Của Bạn</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Huấn Luyện Viên</th>
                            <th>Ngày Tập</th>
                            <th>Khung Giờ</th>
                            <th>Trạng Thái</th>
                            <th>Ghi Chú</th>
                            <th>Hủy</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var b in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@b.Trainer.User.FullName</td>
                                    <td>@b.BookingDate.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-light text-dark border">@b.TimeSlot</span></td>
                                    <td>
                                        <span class="badge @(b.Status == "Approved" ? "bg-success" : (b.Status == "Pending" ? "bg-warning text-dark" : (b.Status == "Completed" ? "bg-primary" : "bg-secondary")))">
                                            @b.Status
                                        </span>
                                    </td>
                                    <td><small class="text-muted">@(b.Notes ?? "-")</small></td>
                                    <td>
                                        @if (b.Status == "Pending")
                                        {
                                            <form asp-action="Cancel" asp-route-id="@b.BookingId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc muốn hủy ca tập này?');">Hủy</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Bạn chưa có lịch hẹn tập nào. Hãy đặt lịch ngay!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
