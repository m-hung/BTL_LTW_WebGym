@model WebGym.Models.DTOs.Trainer.RecordProgressDto
@{
    ViewData["Title"] = "Đo InBody";
}

@section TopActions {
    <a class="cx-btn cx-btn--ghost" asp-action="Index">Quay lại danh sách</a>
}

<form asp-action="RecordProgress" method="post" class="cx-form">
    <input type="hidden" asp-for="MemberId" />
    <input type="hidden" asp-for="MemberName" />

    <header class="cx-form-head">
        <span class="cx-avatar cx-avatar--lg" aria-hidden="true">@CoachUi.Initials(Model.MemberName)</span>
        <div>
            <h2 class="cx-h2">@Model.MemberName</h2>
            <p class="cx-sub">Các ô đang hiện số đo gần nhất của học viên. Sửa những chỉ số đã thay đổi rồi lưu, hệ thống sẽ ghi lại một lần đo mới với ngày hôm nay.</p>
        </div>
    </header>

    <div asp-validation-summary="ModelOnly" class="cx-form-error"></div>

    <fieldset class="cx-fieldset">
        <legend>Cân nặng và thành phần cơ thể</legend>
        <div class="cx-grid3">
            <div class="cx-field">
                <label asp-for="Weight">Cân nặng <abbr title="bắt buộc">*</abbr></label>
                <div class="cx-input"><input asp-for="Weight" type="number" step="0.1" min="20" max="300" required /><span>kg</span></div>
                <span asp-validation-for="Weight" class="cx-field-err"></span>
            </div>
            <div class="cx-field">
                <label asp-for="BodyFatPercentage">Tỷ lệ mỡ</label>
                <div class="cx-input"><input asp-for="BodyFatPercentage" type="number" step="0.1" min="0" max="70" /><span>%</span></div>
            </div>
            <div class="cx-field">
                <label asp-for="MuscleMass">Khối lượng cơ</label>
                <div class="cx-input"><input asp-for="MuscleMass" type="number" step="0.1" min="0" max="150" /><span>kg</span></div>
            </div>
        </div>
    </fieldset>

    <fieldset class="cx-fieldset">
        <legend>Số đo ba vòng</legend>
        <div class="cx-grid3">
            <div class="cx-field">
                <label asp-for="Chest">Vòng ngực</label>
                <div class="cx-input"><input asp-for="Chest" type="number" step="0.1" min="0" max="250" /><span>cm</span></div>
            </div>
            <div class="cx-field">
                <label asp-for="Waist">Vòng eo</label>
                <div class="cx-input"><input asp-for="Waist" type="number" step="0.1" min="0" max="250" /><span>cm</span></div>
            </div>
            <div class="cx-field">
                <label asp-for="Hips">Vòng mông</label>
                <div class="cx-input"><input asp-for="Hips" type="number" step="0.1" min="0" max="250" /><span>cm</span></div>
            </div>
        </div>
    </fieldset>

    <fieldset class="cx-fieldset">
        <legend>Nhận xét của bạn</legend>
        <div class="cx-field">
            <label asp-for="Notes">Học viên sẽ đọc được nhận xét này trong hồ sơ</label>
            <textarea asp-for="Notes" rows="4" placeholder="Ví dụ: Vòng eo giảm 1,5 cm so với lần trước. Giữ chế độ ăn hiện tại, tuần tới tăng tạ Squat lên 5 kg."></textarea>
        </div>
    </fieldset>

    <div class="cx-form-bar">
        <button type="submit" class="cx-btn">Lưu lần đo</button>
        <a class="cx-btn cx-btn--ghost" asp-action="Index">Huỷ</a>
    </div>
</form>
