@model WebGym.Models.DTOs.Admin.MemberEditViewModel
@{
    ViewData["Title"] = "Chỉnh Sửa Hội Viên";
}

<div class="mb-4">
    <a asp-action="Details" asp-route-id="@Model.MemberId" class="text-decoration-none text-muted small fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Quay lại chi tiết hội viên
    </a>
    <h3 class="fw-bold text-dark mt-2">Cập Nhật Thông Tin Hội Viên</h3>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4">
            <form asp-action="Edit" asp-route-id="@Model.MemberId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MemberId" />
                <input type="hidden" asp-for="UserId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <h6 class="fw-bold text-primary mb-3"><i class="bi bi-person-badge me-2"></i>1. Thông Tin Cá Nhân</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="FullName" class="form-control rounded-3 py-2" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="Email" type="email" class="form-control rounded-3 py-2" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="PhoneNumber" class="form-control rounded-3 py-2" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Gender" class="form-label fw-bold small text-muted"></label>
                        <select asp-for="Gender" class="form-select rounded-3 py-2">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DateOfBirth" class="form-label fw-bold small text-muted"></label>
                        <input asp-for="DateOfBirth" class="form-control rounded-3 py-2" />
                    </div>
                    <div class="col-md-12">
                        <label asp-for="AvatarUrl" class="form-label fw-bold small text-muted">Đường dẫn ảnh đại diện (Avatar URL)</label>
                        <input asp-for="AvatarUrl" class="form-control rounded-3 py-2" placeholder="/uploads/avatars/member.jpg hoặc https://..." />
                        <span asp-validation-for="AvatarUrl" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="text-muted opacity-25 mb-4">

                <h6 class="fw-bold text-success mb-3"><i class="bi bi-heart-pulse me-2"></i>2. Chỉ Số Thể Chất & Số Đo</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Height" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="Height" type="number" step="0.5" class="form-control rounded-start-3 py-2" />
                            <span class="input-group-text bg-light text-muted">cm</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Weight" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="Weight" type="number" step="0.5" class="form-control rounded-start-3 py-2" />
                            <span class="input-group-text bg-light text-muted">kg</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BodyFatPercentage" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="BodyFatPercentage" type="number" step="0.1" class="form-control rounded-start-3 py-2" />
                            <span class="input-group-text bg-light text-muted">%</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MuscleMass" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="MuscleMass" type="number" step="0.1" class="form-control rounded-start-3 py-2" />
                            <span class="input-group-text bg-light text-muted">kg</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Chest" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="Chest" type="number" step="0.5" class="form-control rounded-start-3 py-2" />
                            <span class="input-group-text bg-light text-muted">cm</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Waist" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="Waist" type="number" step="0.5" class="form-control rounded-start-3 py-2" />
                            <span class="input-group-text bg-light text-muted">cm</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Hips" class="form-label fw-bold small text-muted"></label>
                        <div class="input-group">
                            <input asp-for="Hips" type="number" step="0.5" class="form-control rounded-start-3 py-2" />
                            <span class="input-group-text bg-light text-muted">cm</span>
                        </div>
                    </div>
                </div>

                <hr class="text-muted opacity-25 mb-4">

                <h6 class="fw-bold text-danger mb-3"><i class="bi bi-shield-lock me-2"></i>3. Thiết Lập Mật Khẩu (Nếu muốn cấp lại)</h6>
                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label fw-bold small text-muted"></label>
                    <input asp-for="NewPassword" type="password" class="form-control rounded-3 py-2" placeholder="Để trống nếu không muốn đổi mật khẩu" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 fw-bold shadow-sm">
                        <i class="bi bi-save me-1"></i> Lưu Cập Nhật
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.MemberId" class="btn btn-light px-4 py-2 rounded-3 border">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>

