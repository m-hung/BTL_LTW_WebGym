@model IEnumerable<WebGym.Models.Entities.Payment>
@{
    ViewData["Title"] = "Báo Cáo Doanh Thu";
    var report = ViewBag.ReportData as WebGym.Models.DTOs.Admin.RevenueReportDto;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-bar-chart-line-fill text-danger"></i> Báo Cáo Doanh Thu</h2>
</div>

<!-- Filter card -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-bold">Năm</label>
            <input type="number" name="year" class="form-control" value="@(report?.Year ?? DateTime.Now.Year)" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">Tháng (Tùy chọn)</label>
            <select name="month" class="form-select">
                <option value="">-- Cả năm --</option>
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" selected="@(report?.Month == i)">Tháng @i</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Lọc Dữ Liệu</button>
        </div>
    </form>
</div>

<!-- Summary statistics -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-primary text-white">
            <span class="fs-6">Tổng Doanh Thu Ghi Nhận</span>
            <h2 class="fw-bold my-2">@(report?.TotalRevenue.ToString("N0") ?? "0") VNĐ</h2>
            <small>Dựa trên các giao dịch thanh toán thành công trong kỳ</small>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-success text-white">
            <span class="fs-6">Tổng Số Giao Dịch Thành Công</span>
            <h2 class="fw-bold my-2">@(report?.TotalTransactions ?? 0)</h2>
            <small>Bao gồm thanh toán qua VNPay, Momo và Chuyển khoản ngân hàng</small>
        </div>
    </div>
</div>

<!-- Transactions details table -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-3">
    <h5 class="fw-bold mb-3">Chi Tiết Giao Dịch</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã Giao Dịch</th>
                    <th>Hội Viên</th>
                    <th>Gói Tập</th>
                    <th>Số Tiền</th>
                    <th>Phương Thức</th>
                    <th>Thời Gian</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <code>@p.TransactionCode</code>
                        </td>
                        <td class="fw-semibold">@p.Member.User.FullName</td>
                        <td>@p.Package.PackageName</td>
                        <td class="text-success fw-bold">@p.Amount.ToString("N0") đ</td>
                        <td><span class="badge bg-secondary">@p.PaymentMethod</span></td>
                        <td>@p.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
