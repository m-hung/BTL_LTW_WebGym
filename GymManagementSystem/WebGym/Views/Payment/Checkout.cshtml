@model WebGym.Models.DTOs.Payment.PaymentRequestDto
@{
    ViewData["Title"] = "Thanh Toán Gói Tập";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card border-0 shadow rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white text-center py-4">
                <h4 class="fw-bold mb-0"><i class="bi bi-credit-card-2-front me-2"></i> Xác Nhận Thanh Toán</h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info">
                    <h5 class="fw-bold">@Model.PackageName</h5>
                    <p class="mb-0">Số tiền cần thanh toán: <strong class="fs-4 text-danger">@Model.Amount.ToString("N0") VNĐ</strong></p>
                </div>

                <form asp-action="CreateVnPayPayment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PackageId" />
                    <input type="hidden" asp-for="PackageName" />
                    <input type="hidden" asp-for="Amount" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nội dung chuyển khoản / giao dịch</label>
                        <input asp-for="OrderDescription" class="form-control" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Phương thức thanh toán</label>
                        <div class="border rounded-3 p-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="PaymentMethod" id="vnpayRadio" value="VnPay" checked>
                                <label class="form-check-label fw-bold text-primary" for="vnpayRadio">
                                    <i class="bi bi-qr-code me-1"></i> Cổng thanh toán VNPay QR (ATM/Visa/MasterCard/Ví VNPay)
                                </label>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 fw-bold py-3 fs-5 shadow-sm">
                        <i class="bi bi-shield-lock-fill me-1"></i> Chuyển Đến Cổng Thanh Toán VNPay
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
