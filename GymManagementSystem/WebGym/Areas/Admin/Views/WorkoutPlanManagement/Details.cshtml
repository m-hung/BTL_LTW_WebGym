@model WebGym.Models.DTOs.Admin.WorkoutPlanViewModel
@{
    ViewData["Title"] = $"Chi Tiết Giáo Án - {Model.Title}";
    var isAi = Model.PlanSource == "AI";
    var member = ViewBag.MemberEntity as WebGym.Models.Entities.Member;
}

<div class="container-fluid px-0" style="max-width: 1100px;">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h3 class="fw-bold text-dark mb-0">@Model.Title</h3>
                @if (isAi)
                {
                    <span class="badge rounded-pill px-3 py-1 text-white shadow-sm" style="background: linear-gradient(135deg, #8b5cf6, #3b82f6);">
                        <i class="bi bi-robot me-1"></i> AI Smart Plan
                    </span>
                }
                else
                {
                    <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-1">
                        <i class="bi bi-person-badge-fill me-1"></i> Giáo án HLV soạn
                    </span>
                }
                @if (Model.IsActive)
                {
                    <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-3 py-1">Đang áp dụng</span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-25 text-secondary rounded-pill px-3 py-1">Tạm dừng</span>
                }
            </div>
            <p class="text-muted mb-0 small">
                Thời gian áp dụng: <strong>@Model.StartDate.ToString("dd/MM/yyyy")</strong> đến <strong>@Model.EndDate.ToString("dd/MM/yyyy")</strong>
                &bull; Tạo ngày: @Model.CreatedAt.ToString("dd/MM/yyyy")
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-3 shadow-sm">
                <i class="bi bi-pencil-square me-1"></i> Chỉnh Sửa
            </a>
        </div>
    </div>

    <!-- Goal Banner -->
    <div class="alert bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-4 p-3 mb-4">
        <div class="d-flex align-items-center">
            <div class="bg-primary text-white p-2 rounded-3 me-3 fs-4">
                <i class="bi bi-flag-fill"></i>
            </div>
            <div>
                <div class="fw-bold text-primary">Mục Tiêu Tập Luyện Cốt Lõi (Goal):</div>
                <div class="text-dark">@Model.Goal</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- LEFT: Routine Details & Nutrition Advice -->
        <div class="col-12 col-lg-8">
            <!-- Routine Details Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-calendar3-week text-primary me-2"></i>
                        Lịch Tập &amp; Chi Tiết Bài Tập
                    </h5>
                    <span class="badge bg-light text-dark border">Giáo trình chuẩn</span>
                </div>
                <div class="card-body p-4">
                    @if (string.IsNullOrWhiteSpace(Model.RoutineDetails))
                    {
                        <p class="text-muted mb-0">Chưa có thông tin bài tập chi tiết.</p>
                    }
                    else
                    {
                        <div class="routine-content" style="line-height: 1.8; font-size: 0.95rem; white-space: pre-line;">@Model.RoutineDetails</div>
                    }
                </div>
            </div>

            <!-- Nutrition Advice Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-egg-fried text-success me-2"></i>
                        Tư Vấn Dinh Dưỡng &amp; Mục Tiêu Calo
                    </h5>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Dinh dưỡng khoa học</span>
                </div>
                <div class="card-body p-4">
                    @if (string.IsNullOrWhiteSpace(Model.NutritionAdvice))
                    {
                        <p class="text-muted mb-0">Chưa có hướng dẫn dinh dưỡng cụ thể.</p>
                    }
                    else
                    {
                        <div class="nutrition-content" style="line-height: 1.8; font-size: 0.95rem; white-space: pre-line;">@Model.NutritionAdvice</div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT: Member InBody & Trainer Info -->
        <div class="col-12 col-lg-4">
            <!-- Member InBody Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3 d-flex align-items-center">
                        <i class="bi bi-person-bounding-box text-primary me-2 fs-5"></i>
                        Hồ Sơ &amp; Chỉ Số Hội Viên
                    </h6>
                    <div class="mb-3">
                        <strong class="text-dark fs-5 d-block">@Model.MemberName</strong>
                        <span class="text-muted small">SĐT: @(string.IsNullOrEmpty(Model.MemberPhone) ? "Chưa có" : Model.MemberPhone)</span>
                    </div>

                    @if (member != null)
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <div class="bg-light p-2 rounded-3 text-center">
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Chiều cao</small>
                                    <strong class="text-dark">@(member.Height.HasValue ? $"{member.Height} cm" : "---")</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light p-2 rounded-3 text-center">
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Cân nặng</small>
                                    <strong class="text-dark">@(member.Weight.HasValue ? $"{member.Weight} kg" : "---")</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light p-2 rounded-3 text-center">
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">BMR Chuyển hóa</small>
                                    <strong class="text-dark">@(member.BMR.HasValue ? $"{member.BMR} kcal" : "---")</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light p-2 rounded-3 text-center">
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Tỷ lệ mỡ</small>
                                    <strong class="text-dark">@(member.BodyFatPercentage.HasValue ? $"{member.BodyFatPercentage} %" : "---")</strong>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Trainer Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3 d-flex align-items-center">
                        <i class="bi bi-person-workspace text-warning me-2 fs-5"></i>
                        Huấn Luyện Viên Phụ Trách
                    </h6>
                    <div class="mb-2">
                        <strong class="text-dark fs-6 d-block">@Model.TrainerName</strong>
                        <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-25 mt-1">
                            @Model.TrainerSpecialization
                        </span>
                    </div>
                </div>
            </div>

            <!-- Quick Status Form -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3">Thao Tác Quản Trị</h6>
                    <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-@(Model.IsActive ? "warning" : "success") w-100 rounded-pill">
                            <i class="bi bi-toggle-@(Model.IsActive ? "on" : "off") me-1"></i>
                            @(Model.IsActive ? "Tạm Dừng Giáo Án" : "Kích Hoạt Lại Giáo Án")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

