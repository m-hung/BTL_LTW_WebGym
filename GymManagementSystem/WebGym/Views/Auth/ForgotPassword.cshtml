@model WebGym.Models.DTOs.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên Mật Khẩu";
    var sentMessage = ViewBag.SentMessage as string;
    var devLink = ViewBag.DevLink as string;
}

@* Trang dự phòng (khi tắt JavaScript). Bình thường "Quên mật khẩu?" mở ngay trong modal đăng nhập. *@
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card border-0 shadow rounded-4 p-4 text-center">
            <i class="bi bi-envelope-at text-primary fs-1 mb-3"></i>
            <h4 class="fw-bold">Khôi Phục Mật Khẩu</h4>
            <p class="text-muted small">Nhập email đăng ký của bạn để nhận liên kết đặt lại mật khẩu</p>

            @if (!string.IsNullOrEmpty(sentMessage))
            {
                <div class="alert alert-success small text-start">@sentMessage</div>
            }
            @if (!string.IsNullOrEmpty(devLink))
            {
                <div class="alert alert-warning small text-start">
                    <strong>Chế độ phát triển:</strong> nếu chưa cấu hình gửi email, dùng liên kết này:
                    <a href="@devLink" class="d-block mt-1 text-break">Mở liên kết đặt lại mật khẩu</a>
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="mb-3 text-start">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mb-3">Gửi Hướng Dẫn</button>
            </form>

            <a asp-action="Login" class="small text-decoration-none">Quay lại trang đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
