@model IEnumerable<WebGym.Models.Entities.GymRoom>
@{
    ViewData["Title"] = "Quản Lý Phòng Tập & Studio";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-door-open-fill text-primary me-2"></i>Quản Lý Phòng Tập / Studio
        </h3>
        <p class="text-muted small mb-0">Quản lý không gian tập luyện, sức chứa, phân bố trang thiết bị và lớp học nhóm.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span class="fw-semibold">Thêm Phòng Tập Mới</span>
        </a>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Tổng số phòng</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@ViewBag.TotalRooms</h3>
                </div>
                <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary">
                    <i class="bi bi-building fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Đang hoạt động</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@ViewBag.ActiveRooms</h3>
                </div>
                <div class="p-3 bg-success bg-opacity-10 rounded-3 text-success">
                    <i class="bi bi-check-circle-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Đang bảo trì</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@ViewBag.MaintenanceRooms</h3>
                </div>
                <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-warning">
                    <i class="bi bi-tools fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Tạm ngưng / Đóng</span>
                    <h3 class="fw-bold text-danger mb-0 mt-1">@ViewBag.ClosedRooms</h3>
                </div>
                <div class="p-3 bg-danger bg-opacity-10 rounded-3 text-danger">
                    <i class="bi bi-pause-circle-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 bg-white p-3 mb-4 rounded-4 shadow-sm">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="searchKeyword" class="form-control bg-light border-start-0" 
                       placeholder="Tìm theo tên phòng, vị trí hoặc mô tả..." value="@ViewBag.SearchKeyword" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="statusFilter" class="form-select bg-light">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Hoạt động" selected="@(ViewBag.StatusFilter == "Hoạt động")">Hoạt động</option>
                <option value="Bảo trì" selected="@(ViewBag.StatusFilter == "Bảo trì")">Đang bảo trì</option>
                <option value="Tạm đóng" selected="@(ViewBag.StatusFilter == "Tạm đóng")">Tạm đóng</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100 rounded-3">
                <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchKeyword as string) || !string.IsNullOrWhiteSpace(ViewBag.StatusFilter as string))
        {
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-3">Xóa lọc</a>
            </div>
        }
    </form>
</div>

<!-- Rooms Grid -->
<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white">
                <i class="bi bi-door-closed display-4 text-muted mb-3"></i>
                <h5 class="fw-bold text-dark">Chưa có phòng tập nào phù hợp</h5>
                <p class="text-muted small">Vui lòng thử lại với từ khóa khác hoặc bấm nút "Thêm Phòng Tập Mới".</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var room in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 border-0 rounded-4 shadow-sm position-relative overflow-hidden">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <!-- Header Card -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">@room.RoomName</h5>
                                    <div class="text-muted small">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@room.Location
                                    </div>
                                </div>
                                @if (room.Status == "Hoạt động")
                                {
                                    <span class="badge badge-soft-success rounded-pill px-3 py-2 small">
                                        <i class="bi bi-check-circle me-1"></i> Hoạt động
                                    </span>
                                }
                                else if (room.Status == "Bảo trì")
                                {
                                    <span class="badge badge-soft-warning rounded-pill px-3 py-2 small">
                                        <i class="bi bi-tools me-1"></i> Bảo trì
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-danger rounded-pill px-3 py-2 small">
                                        <i class="bi bi-x-circle me-1"></i> Tạm đóng
                                    </span>
                                }
                            </div>

                            <!-- Description -->
                            <p class="text-muted small mb-3 text-truncate-2" style="min-height: 38px;">
                                @(room.Description ?? "Phòng tập tiêu chuẩn, trang bị đầy đủ hệ thống thông gió và điều hòa.")
                            </p>

                            <!-- Quick Stats Info Badges -->
                            <div class="row g-2 mb-3">
                                <div class="col-4">
                                    <div class="bg-light p-2 rounded-3 text-center">
                                        <div class="text-muted small" style="font-size: 0.75rem;">Sức chứa</div>
                                        <div class="fw-bold text-dark fs-6 mt-1">@room.Capacity <small class="text-muted">người</small></div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="bg-light p-2 rounded-3 text-center">
                                        <div class="text-muted small" style="font-size: 0.75rem;">Thiết bị</div>
                                        <div class="fw-bold text-primary fs-6 mt-1">@room.Equipments.Count <small class="text-muted">máy</small></div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="bg-light p-2 rounded-3 text-center">
                                        <div class="text-muted small" style="font-size: 0.75rem;">Lớp học</div>
                                        <div class="fw-bold text-warning fs-6 mt-1">@room.GymClasses.Count <small class="text-muted">lớp</small></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Active Classes in Room -->
                            @if (room.GymClasses.Any())
                            {
                                <div class="mb-3">
                                    <span class="text-muted small fw-semibold d-block mb-1">
                                        <i class="bi bi-calendar-event me-1"></i>Lớp học tại phòng:
                                    </span>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var gc in room.GymClasses.Take(3))
                                        {
                                            <span class="badge bg-light text-dark border small fw-normal">
                                                @gc.ClassName
                                            </span>
                                        }
                                        @if (room.GymClasses.Count > 3)
                                        {
                                            <span class="badge bg-light text-muted border small fw-normal">+@(room.GymClasses.Count - 3) lớp nữa</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Card Footer & Quick Actions -->
                        <div class="border-top pt-3 mt-auto">
                            <!-- Quick Status Switch -->
                            <div class="dropdown mb-2">
                                <button class="btn btn-outline-secondary btn-sm w-100 rounded-3 dropdown-toggle d-flex align-items-center justify-content-between" 
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span><i class="bi bi-arrow-repeat me-1"></i> Đổi trạng thái phòng</span>
                                    <small class="text-muted fw-bold">@room.Status</small>
                                </button>
                                <ul class="dropdown-menu w-100 shadow-sm border-0">
                                    <li>
                                        <form asp-action="ToggleStatus" asp-route-id="@room.RoomId" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="Hoạt động" />
                                            <button type="submit" class="dropdown-item py-2 text-success">
                                                <i class="bi bi-check-circle me-2"></i> Chuyển sang Hoạt động
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-action="ToggleStatus" asp-route-id="@room.RoomId" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="Bảo trì" />
                                            <button type="submit" class="dropdown-item py-2 text-warning">
                                                <i class="bi bi-tools me-2"></i> Chuyển sang Đang bảo trì
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-action="ToggleStatus" asp-route-id="@room.RoomId" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="Tạm đóng" />
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-pause-circle me-2"></i> Chuyển sang Tạm ngưng / Đóng
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>

                            <!-- Buttons -->
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@room.RoomId" class="btn btn-light btn-sm flex-grow-1 rounded-3 border fw-semibold">
                                    <i class="bi bi-eye text-info me-1"></i> Chi tiết
                                </a>
                                <a asp-action="Edit" asp-route-id="@room.RoomId" class="btn btn-light btn-sm flex-grow-1 rounded-3 border fw-semibold">
                                    <i class="bi bi-pencil-square text-primary me-1"></i> Sửa
                                </a>
                                <form asp-action="Delete" asp-route-id="@room.RoomId" method="post" id="deleteForm-@room.RoomId">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-3 btn-delete-room" 
                                            data-form-id="deleteForm-@room.RoomId"
                                            data-room-name="@room.RoomName"
                                            title="Xóa phòng">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-delete-room').forEach(btn => {
            btn.addEventListener('click', function () {
                const formId = this.getAttribute('data-form-id');
                const roomName = this.getAttribute('data-room-name') || 'này';
                confirmAction(formId, 'Bạn có chắc chắn muốn xóa phòng "' + roomName + '"? Các thiết bị và lớp học sẽ được gỡ liên kết an toàn.');
            });
        });
    </script>
}

