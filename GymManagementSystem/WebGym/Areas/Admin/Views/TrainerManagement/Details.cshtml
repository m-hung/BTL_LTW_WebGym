@model WebGym.Models.Entities.Trainer
@{
    ViewData["Title"] = $"Chi Tiết HLV - {Model.User.FullName}";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách HLV
    </a>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-2">
        <h3 class="fw-bold text-dark mb-0">Hồ Sơ Huấn Luyện Viên</h3>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.TrainerId" class="btn btn-primary btn-sm px-3 py-2 rounded-3">
                <i class="bi bi-pencil me-1"></i> Sửa thông tin
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái: Thông tin cá nhân -->
    <div class="col-lg-4">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4 text-center mb-4">
            @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
            {
                var dImg = Model.AvatarUrl.Trim();
                var dSrc = dImg.StartsWith("http") ? dImg : Url.Content(dImg.StartsWith("~") ? dImg : (dImg.StartsWith("/") ? dImg : "~/images/" + dImg));
                <img src="@dSrc" alt="@Model.User.FullName" class="rounded-circle object-fit-cover shadow mx-auto mb-3" style="width: 90px; height: 90px;" />
            }
            else
            {
                <div class="avatar bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold mx-auto mb-3 shadow" 
                     style="width: 90px; height: 90px; font-size: 2.2rem;">
                    @(Model.User.FullName?.Substring(0, 1).ToUpper() ?? "P")
                </div>
            }

            <h5 class="fw-bold text-dark mb-1">@Model.User.FullName</h5>
            <div class="badge badge-soft-primary px-3 py-1 mb-3">@Model.Specialization</div>
            
            <p class="text-muted small mb-3">
                @(Model.Bio ?? "Chưa có thông tin tiểu sử cá nhân.")
            </p>

            <ul class="list-group list-group-flush text-start small">
                <li class="list-group-item d-flex justify-content-between px-0 py-2">
                    <span class="text-muted"><i class="bi bi-person me-2"></i>Tên đăng nhập</span>
                    <code>@Model.User.Username</code>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0 py-2">
                    <span class="text-muted"><i class="bi bi-envelope me-2"></i>Email</span>
                    <span class="fw-semibold text-dark">@Model.User.Email</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0 py-2">
                    <span class="text-muted"><i class="bi bi-telephone me-2"></i>Số điện thoại</span>
                    <span class="fw-semibold text-dark">@(Model.User.PhoneNumber ?? "Chưa có")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0 py-2">
                    <span class="text-muted"><i class="bi bi-clock-history me-2"></i>Ngày gia nhập</span>
                    <span class="fw-semibold text-dark">@Model.User.CreatedAt.ToString("dd/MM/yyyy")</span>
                </li>
            </ul>
        </div>
    </div>

    <!-- Cột phải: Các ca tập được đặt -->
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-calendar2-check text-warning me-2"></i>Lịch Huấn Luyện Hội Viên</h5>
                <span class="badge bg-light text-dark border">Tổng: @Model.Bookings.Count ca tập</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Hội Viên</th>
                            <th>Ngày Tập</th>
                            <th>Khung Giờ</th>
                            <th>Trạng Thái</th>
                            <th>Ghi Chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Bookings.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Chưa có hội viên nào đặt lịch với HLV này.</td>
                            </tr>
                        }
                        @foreach (var b in Model.Bookings.OrderByDescending(x => x.BookingDate))
                        {
                            <tr>
                                <td class="fw-bold text-dark">@b.Member.User.FullName</td>
                                <td>@b.BookingDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@b.TimeSlot</span></td>
                                <td>
                                    @if (b.Status == "Approved")
                                    {
                                        <span class="badge badge-soft-success">Đã duyệt</span>
                                    }
                                    else if (b.Status == "Pending")
                                    {
                                        <span class="badge badge-soft-warning">Chờ duyệt</span>
                                    }
                                    else if (b.Status == "Completed")
                                    {
                                        <span class="badge badge-soft-primary">Hoàn thành</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-secondary">Đã hủy</span>
                                    }
                                </td>
                                <td><small class="text-muted">@(b.Notes ?? "-")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

