@model IEnumerable<WebGym.Models.Entities.Booking>
@{
    ViewData["Title"] = "Yêu cầu đặt lịch";
    var pendingList = Model?.ToList() ?? new List<WebGym.Models.Entities.Booking>();
    var now = DateTime.Now;
    var lateCount = pendingList.Count(b => CoachUi.EndAt(b.BookingDate, b.TimeSlot) < now);
}

@section TopActions {
    <a class="cx-btn cx-btn--ghost" asp-controller="Schedule" asp-action="Index">Xem lịch dạy</a>
}

<section class="cx-panel" aria-labelledby="cxReqTitle">
    <header class="cx-panel-head">
        <div>
            <h2 class="cx-h2" id="cxReqTitle">
                @(pendingList.Count == 0 ? "Không có yêu cầu nào" : $"{pendingList.Count} yêu cầu đang chờ bạn")
            </h2>
            <p class="cx-sub">Duyệt để xác nhận ca tập với học viên, hoặc từ chối kèm lý do để học viên chọn giờ khác.</p>
        </div>
        @if (lateCount > 0)
        {
            <p class="cx-flag">@lateCount yêu cầu đã quá giờ tập</p>
        }
    </header>

    @if (pendingList.Any())
    {
        <ul class="cx-reqs">
            @foreach (var b in pendingList)
            {
                var late = CoachUi.EndAt(b.BookingDate, b.TimeSlot) < now;
                var reasonId = $"reason-{b.BookingId}";
                <li class="cx-req @(late ? "is-late" : "")">
                    <span class="cx-date cx-date--lg">
                        <b>@b.BookingDate.ToString("dd")</b>
                        <small>@CoachUi.DayShort(b.BookingDate)</small>
                        <small>@($"Th{b.BookingDate.Month}")</small>
                    </span>

                    <div class="cx-req-main">
                        <p class="cx-req-when">
                            <strong>@CoachUi.SlotText(b.TimeSlot)</strong>
                            <span class="@(late ? "cx-late" : "cx-soon")">@(late ? "Đã quá giờ tập" : CoachUi.RelativeDay(b.BookingDate))</span>
                        </p>
                        <div class="cx-req-who">
                            <span class="cx-avatar cx-avatar--sm" aria-hidden="true">@CoachUi.Initials(b.Member.User.FullName)</span>
                            <span>
                                <strong>@b.Member.User.FullName</strong>
                                <small>@(b.Member.User.PhoneNumber ?? b.Member.User.Email)</small>
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(b.Notes))
                        {
                            <blockquote class="cx-quote">@b.Notes</blockquote>
                        }
                        else
                        {
                            <p class="cx-quote cx-quote--none">Học viên không để lại ghi chú.</p>
                        }
                    </div>

                    <div class="cx-req-act">
                        <form asp-action="Approve" asp-route-id="@b.BookingId" method="post">
                            <button type="submit" class="cx-btn">Duyệt ca này</button>
                        </form>

                        <details class="cx-reject">
                            <summary class="cx-btn cx-btn--danger">Từ chối</summary>
                            <form asp-action="Reject" asp-route-id="@b.BookingId" method="post" class="cx-reject-form">
                                <label for="@reasonId">Lý do gửi cho học viên</label>
                                <textarea id="@reasonId" name="reason" rows="2" maxlength="250" placeholder="Ví dụ: Khung giờ này tôi đã kín lịch, bạn chọn 17:30–19:00 nhé."></textarea>
                                <button type="submit" class="cx-btn cx-btn--danger-solid">Xác nhận từ chối</button>
                            </form>
                        </details>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="cx-empty">
            <p><strong>Bạn đã xử lý hết yêu cầu.</strong> Khi học viên đặt lịch mới với bạn, yêu cầu sẽ hiện ở đây và số lượng sẽ hiện cạnh mục Yêu cầu đặt lịch trên menu.</p>
            <a class="cx-btn cx-btn--ghost" asp-controller="Schedule" asp-action="Index">Về lịch dạy</a>
        </div>
    }
</section>
