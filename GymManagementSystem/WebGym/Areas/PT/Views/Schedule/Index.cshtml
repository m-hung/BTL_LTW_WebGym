@model IEnumerable<WebGym.Models.DTOs.Trainer.TrainerScheduleDto>
@{
    ViewData["Title"] = "Lịch Dạy Của HLV";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold"><i class="bi bi-calendar-week-fill text-warning me-2"></i> Lịch Dạy Huấn Luyện Viên</h3>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Học Viên</th>
                    <th>Số Điện Thoại</th>
                    <th>Ngày Dạy</th>
                    <th>Khung Giờ</th>
                    <th>Trạng Thái</th>
                    <th>Ghi Chú</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-bold">@s.MemberName</td>
                            <td>@(s.MemberPhone ?? "Chưa có")</td>
                            <td>@s.BookingDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-light text-dark border">@s.TimeSlot</span></td>
                            <td>
                                <span class="badge @(s.Status == "Approved" ? "bg-success" : (s.Status == "Pending" ? "bg-warning text-dark" : (s.Status == "Completed" ? "bg-primary" : "bg-secondary")))">
                                    @s.Status
                                </span>
                            </td>
                            <td><small class="text-muted">@(s.Notes ?? "-")</small></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Chưa có ca dạy nào trong lịch.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
