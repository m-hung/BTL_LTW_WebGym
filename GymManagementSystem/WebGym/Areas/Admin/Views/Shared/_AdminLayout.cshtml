<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebGym Quản Trị Hệ Thống</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="bg-dark text-white p-3 min-vh-100" style="width: 260px;">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="d-flex align-items-center mb-4 text-warning text-decoration-none fs-4 fw-bold">
                <i class="bi bi-shield-lock-fill me-2"></i> Admin Panel
            </a>
            <hr class="border-secondary">
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item mb-2">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard Tổng Quan
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a asp-area="Admin" asp-controller="MemberManagement" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-people-fill me-2"></i> Quản Lý Hội Viên
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a asp-area="Admin" asp-controller="TrainerManagement" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-person-badge me-2"></i> Quản Lý Huấn Luyện Viên
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a asp-area="Admin" asp-controller="BookingManagement" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-calendar-check me-2"></i> Lịch Đặt PT Toàn Hệ Thống
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a asp-area="Admin" asp-controller="Report" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-bar-chart-line-fill me-2"></i> Báo Cáo Doanh Thu
                    </a>
                </li>
            </ul>
            <hr class="border-secondary mt-4">
            <div>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm w-100 mb-2">
                    <i class="bi bi-box-arrow-left me-1"></i> Ra Trang Chủ Khách Hàng
                </a>
                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm w-100">
                        <i class="bi bi-power me-1"></i> Đăng Xuất
                    </button>
                </form>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="flex-grow-1 p-4" style="min-height: 100vh;">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
