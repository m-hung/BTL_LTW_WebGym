@model IEnumerable<WebGym.Models.Entities.Member>
@{
    ViewData["Title"] = "Quản Lý Hội Viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-people-fill text-primary"></i> Danh Sách Hội Viên</h2>
</div>

<!-- Search box -->
<form method="get" class="mb-4">
    <div class="input-group" style="max-width: 450px;">
        <input type="text" name="searchKeyword" class="form-control" placeholder="Tìm theo tên, email hoặc số điện thoại..." value="@ViewBag.SearchKeyword" />
        <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Tìm</button>
    </div>
</form>

<div class="card border-0 shadow-sm rounded-4 bg-white p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Họ và Tên</th>
                    <th>Email</th>
                    <th>Số Điện Thoại</th>
                    <th>Chỉ Số InBody</th>
                    <th>Gói Tập Hiện Tại</th>
                    <th>Hạn Gói</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    var activeSub = m.Subscriptions.OrderByDescending(s => s.StartDate).FirstOrDefault(s => s.Status == "Active");
                    <tr>
                        <td class="fw-bold">@m.User.FullName</td>
                        <td>@m.User.Email</td>
                        <td>@(m.User.PhoneNumber ?? "Chưa cập nhật")</td>
                        <td>
                            <small class="text-muted">
                                @(m.Weight.HasValue ? $"{m.Weight}kg" : "-") / @(m.BodyFatPercentage.HasValue ? $"{m.BodyFatPercentage}% mỡ" : "-") / BMR: @(m.BMR ?? 0)
                            </small>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">@(activeSub?.Package.PackageName ?? "Chưa đăng ký")</span>
                        </td>
                        <td>@(activeSub != null ? activeSub.EndDate.ToString("dd/MM/yyyy") : "-")</td>
                        <td>
                            <span class="badge bg-success">Hoạt động</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
