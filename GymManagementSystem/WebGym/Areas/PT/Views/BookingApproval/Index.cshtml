@model IEnumerable<WebGym.Models.Entities.Booking>
@{
    ViewData["Title"] = "Duyệt Lịch Đặt Của Học Viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold"><i class="bi bi-clock-history text-danger me-2"></i> Yêu Cầu Chờ Duyệt</h3>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Học Viên</th>
                    <th>Ngày Đặt</th>
                    <th>Khung Giờ</th>
                    <th>Ghi Chú</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var b in Model)
                    {
                        <tr>
                            <td class="fw-bold">@b.Member.User.FullName</td>
                            <td>@b.BookingDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-light text-dark border">@b.TimeSlot</span></td>
                            <td><small class="text-muted">@(b.Notes ?? "-")</small></td>
                            <td>
                                <form asp-action="Approve" asp-route-id="@b.BookingId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success me-1">
                                        <i class="bi bi-check-lg"></i> Duyệt
                                    </button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@b.BookingId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn muốn từ chối yêu cầu này?');">
                                        <i class="bi bi-x-lg"></i> Từ Chối
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Hiện không có yêu cầu nào đang chờ duyệt.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
