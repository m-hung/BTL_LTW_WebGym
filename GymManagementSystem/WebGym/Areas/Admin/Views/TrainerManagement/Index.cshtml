@model IEnumerable<WebGym.Models.Entities.Trainer>
@{
    ViewData["Title"] = "Quản Lý Huấn Luyện Viên";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-person-workspace text-primary me-2"></i>Đội Ngũ Huấn Luyện Viên (PT)
        </h3>
        <p class="text-muted small mb-0">Quản lý danh sách HLV, thông tin chuyên môn và các ca tập phụ trách.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm">
            <i class="bi bi-person-plus-fill"></i>
            <span class="fw-semibold">Thêm HLV Mới</span>
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 bg-white p-3 mb-4 rounded-4 shadow-sm">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="searchKeyword" class="form-control bg-light border-start-0" 
                       placeholder="Tìm theo tên HLV, email hoặc chuyên môn..." value="@ViewBag.SearchKeyword" />
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100 rounded-3">
                <i class="bi bi-funnel me-1"></i> Tìm kiếm
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchKeyword as string))
        {
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-3">Xóa lọc</a>
            </div>
        }
    </form>
</div>

<!-- Trainers Grid & Table -->
<div class="row g-4 mb-4">
    @foreach (var t in Model)
    {
        var activeBookings = t.Bookings.Count(b => b.Status == "Approved" || b.Status == "Pending");
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 rounded-4 bg-white shadow-sm p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrWhiteSpace(t.AvatarUrl))
                        {
                            <img src="@t.AvatarUrl" alt="@t.User.FullName" class="rounded-circle object-fit-cover shadow-sm" style="width: 56px; height: 56px;" />
                        }
                        else
                        {
                            <div class="avatar bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" 
                                 style="width: 56px; height: 56px; font-size: 1.4rem;">
                                @(t.User.FullName?.Substring(0, 1).ToUpper() ?? "P")
                            </div>
                        }
                        <div>
                            <a asp-action="Details" asp-route-id="@t.TrainerId" class="fw-bold text-dark text-decoration-none fs-5">
                                @t.User.FullName
                            </a>
                            <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@t.User.Email</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <span class="badge badge-soft-primary px-2 py-1"><i class="bi bi-award me-1"></i>@t.Specialization</span>
                    </div>

                    <p class="text-muted small mb-3 text-truncate-3" style="min-height: 40px;">
                        @(t.Bio ?? "Huấn luyện viên thể hình chuyên nghiệp với nhiều năm kinh nghiệm.")
                    </p>
                </div>

                <div class="border-top pt-3 mt-auto">
                    <div class="d-flex justify-content-between align-items-center mb-3 small text-muted">
                        <span>Lịch tập đang phụ trách:</span>
                        <span class="badge bg-warning text-dark fw-bold">@activeBookings ca tập</span>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@t.TrainerId" class="btn btn-light btn-sm w-100 rounded-3 border fw-semibold">
                            <i class="bi bi-eye text-primary me-1"></i> Chi tiết
                        </a>
                        <a asp-action="Edit" asp-route-id="@t.TrainerId" class="btn btn-light btn-sm w-100 rounded-3 border fw-semibold">
                            <i class="bi bi-pencil text-secondary me-1"></i> Sửa
                        </a>
                        <form asp-action="Delete" asp-route-id="@t.TrainerId" method="post" id="delTrainer-@t.TrainerId" class="w-100">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-outline-danger btn-sm w-100 rounded-3 fw-semibold"
                                    onclick="confirmAction('delTrainer-@t.TrainerId', 'Bạn có chắc muốn xóa HLV \'@t.User.FullName\'?')">
                                <i class="bi bi-trash3 me-1"></i> Xóa
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
