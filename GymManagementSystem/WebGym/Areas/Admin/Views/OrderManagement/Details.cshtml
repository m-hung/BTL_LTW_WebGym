@model WebGym.Models.Entities.Order
@{
    ViewData["Title"] = $"Chi Tiết Đơn Hàng #OD-{Model.OrderId:D4}";
    var statusBadge = Model.Status switch
    {
        "Hoàn thành" => "badge-soft-success",
        "Đã thanh toán" => "badge-soft-primary",
        "Đang giao" => "badge-soft-info",
        "Chờ xác nhận" => "badge-soft-warning",
        "Đã hủy" => "badge-soft-danger",
        _ => "badge-soft-secondary"
    };

    var customerName = Model.Member?.User?.FullName ?? (Model.User?.FullName ?? (Model.ShippingAddress?.StartsWith("Khách vãng lai: ") == true ? Model.ShippingAddress.Replace("Khách vãng lai: ", "") : "Khách lẻ tại quầy"));
    var customerPhone = Model.PhoneNumber ?? (Model.Member?.User?.PhoneNumber ?? Model.User?.PhoneNumber);
    var customerEmail = Model.Member?.User?.Email ?? Model.User?.Email;
}

<div class="container-fluid px-0" style="max-width: 1000px;">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h3 class="fw-bold text-dark mb-0">Đơn Hàng #OD-@Model.OrderId.ToString("D4")</h3>
                <span class="badge @statusBadge rounded-pill px-3 py-1 fs-6">@Model.Status</span>
            </div>
            <p class="text-muted mb-0 small">
                Ngày đặt: <strong>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</strong> &bull; Hình thức thanh toán: <strong>@Model.PaymentMethod</strong>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Danh Sách Đơn
            </a>
            <a asp-action="PrintReceipt" asp-route-id="@Model.OrderId" target="_blank" class="btn btn-primary rounded-pill px-3 shadow-sm">
                <i class="bi bi-printer-fill me-1"></i> In Hóa Đơn / Biên Lai
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main: Order Items List -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-bag-check-fill text-primary me-2"></i>
                        Danh Sách Sản Phẩm (@Model.OrderDetails.Count mặt hàng)
                    </h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 60px;">ẢNH</th>
                                <th>SẢN PHẨM</th>
                                <th class="text-center">ĐƠN GIÁ</th>
                                <th class="text-center">SỐ LƯỢNG</th>
                                <th class="text-end pe-4">THÀNH TIỀN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="rounded-3 overflow-hidden bg-light d-flex align-items-center justify-content-center border" style="width: 48px; height: 48px;">
                                            @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                            {
                                                <img src="@Url.Content(item.Product.ImageUrl)" alt="@item.Product.ProductName" class="img-fluid object-fit-cover w-100 h-100" onerror="this.onerror=null; this.src='/images/default-product.svg';" />
                                            }
                                            else
                                            {
                                                <img src="/images/default-product.svg" alt="Sản phẩm" class="img-fluid object-fit-cover w-100 h-100" />
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@(item.Product?.ProductName ?? "Sản phẩm")</div>
                                        <small class="text-muted">@(item.Product?.Category?.CategoryName ?? "")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-dark">@item.UnitPrice.ToString("N0") đ</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">
                                            x @item.Quantity
                                        </span>
                                    </td>
                                    <td class="text-end pe-4 fw-bold text-primary">
                                        @item.TotalPrice.ToString("N0") đ
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end fw-semibold text-muted">Tổng cộng tiền hàng:</td>
                                <td class="text-end pe-4 fw-bold text-dark fs-6">@Model.TotalAmount.ToString("N0") đ</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end fw-semibold text-muted">Chiết khấu / Giảm giá:</td>
                                <td class="text-end pe-4 fw-semibold text-muted">0 đ</td>
                            </tr>
                            <tr class="table-active">
                                <td colspan="4" class="text-end fw-bold text-dark fs-5">TỔNG THANH TOÁN:</td>
                                <td class="text-end pe-4 fw-bold text-success fs-5">@Model.TotalAmount.ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="col-12 col-lg-4">
            <!-- Customer Info -->
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3 d-flex align-items-center">
                        <i class="bi bi-person-circle text-primary me-2 fs-5"></i>
                        Thông Tin Khách Hàng
                    </h6>
                    <div class="mb-2">
                        <span class="text-muted small d-block">Họ và tên:</span>
                        <strong class="text-dark fs-6">@customerName</strong>
                        @if (Model.Member != null)
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary ms-1 small">Hội viên chính thức</span>
                        }
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small d-block">Số điện thoại:</span>
                        <span class="text-dark">@(string.IsNullOrEmpty(customerPhone) ? "Chưa cập nhật" : customerPhone)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(customerEmail))
                    {
                        <div class="mb-2">
                            <span class="text-muted small d-block">Email:</span>
                            <span class="text-dark">@customerEmail</span>
                        </div>
                    }
                    <div class="mb-2">
                        <span class="text-muted small d-block">Địa điểm giao nhận / Bán:</span>
                        <span class="text-dark">@(Model.ShippingAddress ?? "Bán lẻ tại quầy POS")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mt-3 p-2 bg-light rounded-3">
                            <span class="text-muted small fw-semibold d-block">Ghi chú:</span>
                            <span class="small text-dark">@Model.Notes</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Status Control -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3 d-flex align-items-center">
                        <i class="bi bi-sliders text-primary me-2 fs-5"></i>
                        Cập Nhật Trạng Thái Đơn
                    </h6>
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OrderId" />
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Trạng thái hiện tại:</label>
                            <select name="newStatus" class="form-select rounded-3">
                                <option value="Hoàn thành" selected="@(Model.Status == "Hoàn thành")">Hoàn thành</option>
                                <option value="Đã thanh toán" selected="@(Model.Status == "Đã thanh toán")">Đã thanh toán</option>
                                <option value="Đang giao" selected="@(Model.Status == "Đang giao")">Đang giao</option>
                                <option value="Chờ xác nhận" selected="@(Model.Status == "Chờ xác nhận")">Chờ xác nhận</option>
                                <option value="Đã hủy" selected="@(Model.Status == "Đã hủy")">Đã hủy</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-outline-primary w-100 rounded-pill shadow-sm">
                            <i class="bi bi-arrow-repeat me-1"></i> Lưu Trạng Thái
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

