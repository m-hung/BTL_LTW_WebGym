@model WebGym.Models.DTOs.Admin.WorkoutPlanFormViewModel
@{
    ViewData["Title"] = "Chỉnh Sửa Giáo Án";
}

<div class="container-fluid px-0" style="max-width: 900px;">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center">
                <span class="badge bg-primary bg-opacity-10 text-primary p-2 me-2 rounded-3">
                    <i class="bi bi-pencil-square"></i>
                </span>
                Chỉnh Sửa Giáo Án Tập Luyện
            </h3>
            <p class="text-muted mb-0 small">Cập nhật lịch tập, bài tập hoặc điều chỉnh chế độ dinh dưỡng cho hội viên.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 rounded-3"></div>

                <div class="row g-3">
                    <!-- Nguồn tạo giáo án (AI vs HLV) -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-dark">Nguồn tạo giáo án (PlanSource)</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="radio" class="btn-check" asp-for="PlanSource" value="Trainer" id="sourceTrainer">
                                <label class="btn btn-outline-warning w-100 rounded-3 py-2 text-start" for="sourceTrainer">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-person-badge fs-4 me-2"></i>
                                        <div>
                                            <strong class="d-block">HLV Soạn Riêng</strong>
                                            <small class="text-muted">Huấn luyện viên trực tiếp thiết kế bài tập</small>
                                        </div>
                                    </div>
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" asp-for="PlanSource" value="AI" id="sourceAI">
                                <label class="btn btn-outline-primary w-100 rounded-3 py-2 text-start" for="sourceAI">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-robot fs-4 me-2"></i>
                                        <div>
                                            <strong class="d-block">AI Smart Plan</strong>
                                            <small class="text-muted">Tự động phân tích chỉ số cá nhân hóa</small>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Tên giáo án -->
                    <div class="col-12">
                        <label asp-for="Title" class="form-label fw-semibold text-dark">
                            Tên lộ trình / Giáo án <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title" class="form-control rounded-3" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Hội viên -->
                    <div class="col-12 col-md-6">
                        <label asp-for="MemberId" class="form-label fw-semibold text-dark">
                            Hội viên áp dụng <span class="text-danger">*</span>
                        </label>
                        <select asp-for="MemberId" asp-items="ViewBag.MembersList" class="form-select rounded-3">
                            <option value="">-- Chọn hội viên --</option>
                        </select>
                        <span asp-validation-for="MemberId" class="text-danger small"></span>
                    </div>

                    <!-- HLV Phụ trách -->
                    <div class="col-12 col-md-6">
                        <label asp-for="TrainerId" class="form-label fw-semibold text-dark">
                            Huấn luyện viên phụ trách <span class="text-danger">*</span>
                        </label>
                        <select asp-for="TrainerId" asp-items="ViewBag.TrainersList" class="form-select rounded-3">
                            <option value="">-- Chọn HLV --</option>
                        </select>
                        <span asp-validation-for="TrainerId" class="text-danger small"></span>
                    </div>

                    <!-- Mục tiêu -->
                    <div class="col-12">
                        <label asp-for="Goal" class="form-label fw-semibold text-dark">
                            Mục tiêu tập luyện cốt lõi (Goal) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Goal" class="form-control rounded-3" />
                        <span asp-validation-for="Goal" class="text-danger small"></span>
                    </div>

                    <!-- Thời gian bắt đầu - kết thúc -->
                    <div class="col-12 col-md-6">
                        <label asp-for="StartDate" class="form-label fw-semibold text-dark">
                            Ngày bắt đầu <span class="text-danger">*</span>
                        </label>
                        <input asp-for="StartDate" type="date" class="form-control rounded-3" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="EndDate" class="form-label fw-semibold text-dark">
                            Ngày kết thúc <span class="text-danger">*</span>
                        </label>
                        <input asp-for="EndDate" type="date" class="form-control rounded-3" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>

                    <!-- Lịch tập chi tiết -->
                    <div class="col-12">
                        <label asp-for="RoutineDetails" class="form-label fw-semibold text-dark">
                            Lịch tập &amp; Chi tiết bài tập theo tuần <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="RoutineDetails" class="form-control rounded-3 font-monospace" rows="6"></textarea>
                        <span asp-validation-for="RoutineDetails" class="text-danger small"></span>
                    </div>

                    <!-- Lời khuyên dinh dưỡng -->
                    <div class="col-12">
                        <label asp-for="NutritionAdvice" class="form-label fw-semibold text-dark">
                            Lời khuyên dinh dưỡng &amp; Mục tiêu Calo
                        </label>
                        <textarea asp-for="NutritionAdvice" class="form-control rounded-3 font-monospace" rows="5"></textarea>
                        <span asp-validation-for="NutritionAdvice" class="text-danger small"></span>
                    </div>

                    <!-- Trạng thái kích hoạt -->
                    <div class="col-12">
                        <div class="form-check form-switch fs-6">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" />
                            <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">
                                Kích hoạt lộ trình này cho hội viên
                            </label>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="col-12 d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Cập Nhật Giáo Án
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

