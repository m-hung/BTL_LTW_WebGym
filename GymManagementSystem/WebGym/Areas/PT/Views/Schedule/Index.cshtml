@model IEnumerable<WebGym.Models.DTOs.Trainer.TrainerScheduleDto>
@using System.Globalization
@{
    ViewData["Title"] = "Lịch dạy";
    var all = Model?.ToList() ?? new List<WebGym.Models.DTOs.Trainer.TrainerScheduleDto>();
    var now = DateTime.Now;
    var today = DateTime.Today;
    var coachFirstName = CoachUi.FirstName(User.Identity?.Name);

    // Bước 5: Các ca trong cửa sổ 24h cần PT xác nhận kết quả (Approved + đã tới giờ tập + chưa quá 24h)
    var actionWindowSessions = all
        .Where(s => s.Status == "Approved" && CoachUi.IsIn24HourWindow(s.BookingDate, s.TimeSlot))
        .OrderBy(s => CoachUi.StartAt(s.BookingDate, s.TimeSlot))
        .ToList();
    var actionWindowCount = actionWindowSessions.Count;

    // Ca chưa kết thúc (đã xác nhận hoặc đang chờ duyệt), sắp theo thời gian
    var upcoming = all
        .Where(s => (s.Status == "Approved" || s.Status == "Pending") && CoachUi.EndAt(s.BookingDate, s.TimeSlot) >= now)
        .OrderBy(s => CoachUi.StartAt(s.BookingDate, s.TimeSlot))
        .ToList();
    var next = upcoming.FirstOrDefault(s => s.Status == "Approved");
    var nextPending = upcoming.FirstOrDefault(s => s.Status == "Pending");
    var nextActionable = actionWindowSessions.FirstOrDefault();

    var upcomingApproved = upcoming.Count(s => s.Status == "Approved");
    var pendingTotal = all.Count(s => s.Status == "Pending");
    var completedTotal = all.Count(s => s.Status == "Completed");
    var memberTotal = all.Select(s => s.MemberName).Distinct().Count();

    // Danh sách đầy đủ: ca trong cửa sổ 24h hoặc sắp tới (gần nhất trước), rồi ca đã qua (mới nhất trước)
    var ordered = upcoming
        .Concat(all.Except(upcoming).OrderByDescending(s => CoachUi.StartAt(s.BookingDate, s.TimeSlot)))
        .ToList();

    var week = Enumerable.Range(0, 7).Select(i => today.AddDays(i)).ToList();

    // Thước thời gian hôm nay: giờ mở cửa 05:00 - 23:00
    var inv = CultureInfo.InvariantCulture;
    var openAt = today.AddHours(5);
    var closeAt = today.AddHours(23);
    var dayMinutes = (closeAt - openAt).TotalMinutes;
    string Pct(DateTime t) => Math.Clamp((t - openAt).TotalMinutes / dayMinutes * 100, 0, 100).ToString("0.##", inv);
    var todaySessions = all
        .Where(s => s.BookingDate.Date == today && s.Status != "Cancelled")
        .OrderBy(s => CoachUi.SlotStart(s.TimeSlot))
        .ToList();

    void Dayline()
    {
        <div class="cx-dayline">
            <p class="cx-dayline-label">
                Hôm nay
                <span>@(todaySessions.Count == 0 ? "không có ca nào" : $"{todaySessions.Count} ca")</span>
            </p>
            <div class="cx-dayline-track" role="img" aria-label="Các ca hôm nay theo giờ, từ 05:00 đến 23:00">
                @foreach (var s in todaySessions)
                {
                    var from = CoachUi.StartAt(s.BookingDate, s.TimeSlot);
                    var to = CoachUi.EndAt(s.BookingDate, s.TimeSlot);
                    var st = CoachUi.SessionState(s.Status, s.BookingDate, s.TimeSlot);
                    var width = Math.Max((to - from).TotalMinutes / dayMinutes * 100, 1.5).ToString("0.##", inv);
                    <span class="cx-dl-block cx-dl-block--@st.Css" style="left:@Pct(from)%;width:@width%" title="@CoachUi.SlotText(s.TimeSlot) @s.MemberName (@st.Label)"></span>
                }
                @if (now > openAt && now < closeAt)
                {
                    <span class="cx-dl-now" style="left:@Pct(now)%"><b>@now.ToString("HH:mm")</b></span>
                }
            </div>
            <ol class="cx-dayline-ticks" aria-hidden="true">
                @for (var h = 5; h <= 23; h += 3)
                {
                    <li style="left:@Pct(today.AddHours(h))%">@($"{h:00}:00")</li>
                }
            </ol>
        </div>
    }
}

@section TopActions {
    <a class="cx-btn cx-btn--ghost" asp-controller="AssignedMembers" asp-action="Index">Học viên của tôi</a>
    @if (pendingTotal > 0)
    {
        <a class="cx-btn" asp-controller="BookingApproval" asp-action="Index">Duyệt @pendingTotal yêu cầu</a>
    }
}

<div class="cx-overview">
<!-- Ca tiếp theo hoặc ca đang trong khung 24h cần xác nhận kết quả -->
@if (next != null)
{
    var start = CoachUi.StartAt(next.BookingDate, next.TimeSlot);
    var live = start <= now;
    var inWindow = CoachUi.IsIn24HourWindow(next.BookingDate, next.TimeSlot);
    <section class="cx-next" aria-labelledby="cxNextTitle">
        <div class="cx-next-time">
            <span class="cx-next-clock">@CoachUi.SlotStart(next.TimeSlot).ToString("hh\\:mm")</span>
            <span class="cx-next-day">@CoachUi.RelativeDay(next.BookingDate)</span>
        </div>
        <div class="cx-next-body">
            <p class="cx-next-kicker" id="cxNextTitle">@(live ? "Đang diễn ra / Cần chốt" : "Ca dạy tiếp theo")</p>
            <h2 class="cx-next-name">@next.MemberName</h2>
            <p class="cx-next-meta">
                @CoachUi.DayLong(next.BookingDate), @next.BookingDate.ToString("dd/MM")
                <span class="cx-sep" aria-hidden="true"></span>
                @CoachUi.SlotText(next.TimeSlot)
                @if (!string.IsNullOrEmpty(next.MemberPhone))
                {
                    <span class="cx-sep" aria-hidden="true"></span>
                    <a href="tel:@next.MemberPhone">@next.MemberPhone</a>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(next.Notes))
            {
                <p class="cx-next-note">“@next.Notes”</p>
            }

            @if (inWindow)
            {
                <div class="cx-next-actions" style="margin-top: 14px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center;">
                    <span class="cx-window-pill">
                        <i class="bi bi-clock-history"></i> Cửa sổ 24h: @CoachUi.WindowCountdown(next.BookingDate, next.TimeSlot)
                    </span>
                    <form asp-action="Complete" asp-route-id="@next.BookingId" method="post" style="display:inline;margin:0;">
                        <button type="submit" class="cx-btn-action cx-btn-action--ok">
                            <i class="bi bi-check-circle-fill"></i> Hoàn thành
                        </button>
                    </form>
                    <details class="cx-reject cx-inline-details">
                        <summary class="cx-btn-action cx-btn-action--cancel">
                            <i class="bi bi-x-circle"></i> Báo vắng / Hủy ca
                        </summary>
                        <form asp-action="Cancel" asp-route-id="@next.BookingId" method="post" class="cx-popover-form">
                            <label>Lý do hủy hoặc báo vắng:</label>
                            <input type="text" name="reason" placeholder="VD: Học viên bận đột xuất..." required maxlength="200" />
                            <button type="submit" class="cx-btn-action cx-btn-action--danger-solid">Xác nhận</button>
                        </form>
                    </details>
                </div>
            }
        </div>
        <p class="cx-next-count">@(live ? (inWindow ? "Đang trong 24h cập nhật" : "Học viên đang tập") : CoachUi.Countdown(start))</p>
        @{ Dayline(); }
    </section>
}
else if (nextActionable != null)
{
    var start = CoachUi.StartAt(nextActionable.BookingDate, nextActionable.TimeSlot);
    <section class="cx-next" aria-labelledby="cxNextTitle" style="border-left: 4px solid #fbbf24;">
        <div class="cx-next-time">
            <span class="cx-next-clock">@CoachUi.SlotStart(nextActionable.TimeSlot).ToString("hh\\:mm")</span>
            <span class="cx-next-day">@CoachUi.RelativeDay(nextActionable.BookingDate)</span>
        </div>
        <div class="cx-next-body">
            <p class="cx-next-kicker" id="cxNextTitle" style="color: #fbbf24;">
                <i class="bi bi-exclamation-circle-fill"></i> Cần xác nhận kết quả ca dạy
            </p>
            <h2 class="cx-next-name">@nextActionable.MemberName</h2>
            <p class="cx-next-meta">
                @CoachUi.DayLong(nextActionable.BookingDate), @nextActionable.BookingDate.ToString("dd/MM")
                <span class="cx-sep" aria-hidden="true"></span>
                @CoachUi.SlotText(nextActionable.TimeSlot)
                @if (!string.IsNullOrEmpty(nextActionable.MemberPhone))
                {
                    <span class="cx-sep" aria-hidden="true"></span>
                    <a href="tel:@nextActionable.MemberPhone">@nextActionable.MemberPhone</a>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(nextActionable.Notes))
            {
                <p class="cx-next-note">“@nextActionable.Notes”</p>
            }

            <div class="cx-next-actions" style="margin-top: 14px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center;">
                <span class="cx-window-pill">
                    <i class="bi bi-clock-history"></i> Cửa sổ 24h: @CoachUi.WindowCountdown(nextActionable.BookingDate, nextActionable.TimeSlot)
                </span>
                <form asp-action="Complete" asp-route-id="@nextActionable.BookingId" method="post" style="display:inline;margin:0;">
                    <button type="submit" class="cx-btn-action cx-btn-action--ok">
                        <i class="bi bi-check-circle-fill"></i> Xác nhận Hoàn thành
                    </button>
                </form>
                <details class="cx-reject cx-inline-details">
                    <summary class="cx-btn-action cx-btn-action--cancel">
                        <i class="bi bi-x-circle"></i> Báo vắng / Hủy ca
                    </summary>
                    <form asp-action="Cancel" asp-route-id="@nextActionable.BookingId" method="post" class="cx-popover-form">
                        <label>Lý do học viên vắng / hủy:</label>
                        <input type="text" name="reason" placeholder="VD: Học viên bận đột xuất..." required maxlength="200" />
                        <button type="submit" class="cx-btn-action cx-btn-action--danger-solid">Xác nhận</button>
                    </form>
                </details>
            </div>
        </div>
        <p class="cx-next-count" style="color: #fbbf24;">@CoachUi.WindowCountdown(nextActionable.BookingDate, nextActionable.TimeSlot)</p>
        @{ Dayline(); }
    </section>
}
else if (nextPending != null)
{
    <section class="cx-next cx-next--wait" aria-labelledby="cxNextTitle">
        <div class="cx-next-time">
            <span class="cx-next-clock">@CoachUi.SlotStart(nextPending.TimeSlot).ToString("hh\\:mm")</span>
            <span class="cx-next-day">@CoachUi.RelativeDay(nextPending.BookingDate)</span>
        </div>
        <div class="cx-next-body">
            <p class="cx-next-kicker" id="cxNextTitle">Chưa có ca nào được xác nhận</p>
            <h2 class="cx-next-name">@nextPending.MemberName đang chờ bạn duyệt</h2>
            <p class="cx-next-meta">
                @CoachUi.DayLong(nextPending.BookingDate), @nextPending.BookingDate.ToString("dd/MM")
                <span class="cx-sep" aria-hidden="true"></span>
                @CoachUi.SlotText(nextPending.TimeSlot)
            </p>
        </div>
        <a class="cx-btn" asp-controller="BookingApproval" asp-action="Index">Xem yêu cầu</a>
        @{ Dayline(); }
    </section>
}
else
{
    <section class="cx-next cx-next--empty">
        <div class="cx-next-body">
            <p class="cx-next-kicker">Lịch đang trống</p>
            <h2 class="cx-next-name">Chào @coachFirstName, chưa có ca nào sắp tới</h2>
            <p class="cx-next-meta">Khi học viên đặt lịch với bạn, yêu cầu sẽ hiện ở mục Yêu cầu đặt lịch để bạn duyệt.</p>
        </div>
        @{ Dayline(); }
    </section>
}

<!-- Số liệu nhanh -->
<dl class="cx-stats">
    <div class="cx-stat">
        <dt>Ca sắp tới đã xác nhận</dt>
        <dd>@upcomingApproved</dd>
    </div>
    <div class="cx-stat @(pendingTotal > 0 ? "cx-stat--wait" : "")">
        <dt>Yêu cầu chờ duyệt</dt>
        <dd>
            @if (pendingTotal > 0)
            {
                <a asp-controller="BookingApproval" asp-action="Index">@pendingTotal</a>
            }
            else
            {
                @pendingTotal
            }
        </dd>
    </div>
    <div class="cx-stat">
        <dt>Buổi đã hoàn thành</dt>
        <dd>@completedTotal</dd>
    </div>
    <div class="cx-stat">
        <dt>Học viên từng tập cùng bạn</dt>
        <dd>@memberTotal</dd>
    </div>
</dl>

</div>

<!-- 7 ngày tới: mỗi ca là một vạch nghiêng như logo Pulse -->
<section class="cx-panel" aria-labelledby="cxWeekTitle">
    <header class="cx-panel-head">
        <h2 class="cx-h2" id="cxWeekTitle">7 ngày tới</h2>
        <p class="cx-legend">
            <span><i class="cx-key cx-key--ok"></i>Đã xác nhận</span>
            <span><i class="cx-key cx-key--wait"></i>Chờ duyệt</span>
        </p>
    </header>
    <ol class="cx-week">
        @foreach (var d in week)
        {
            var dayItems = all
                .Where(s => s.BookingDate.Date == d && (s.Status == "Approved" || s.Status == "Pending"))
                .OrderBy(s => CoachUi.SlotStart(s.TimeSlot))
                .ToList();
            var label = dayItems.Count == 0 ? "trống" : $"{dayItems.Count} ca";
            <li class="cx-day @(d == today ? "is-today" : "") @(dayItems.Count == 0 ? "is-free" : "")"
                aria-label="@CoachUi.DayLong(d) @d.ToString("dd/MM"): @label">
                <span class="cx-day-dow">@(d == today ? "Hôm nay" : CoachUi.DayShort(d))</span>
                <span class="cx-day-num">@d.Day</span>
                <span class="cx-day-bars" aria-hidden="true">
                    @foreach (var s in dayItems.Take(6))
                    {
                        <i class="@(s.Status == "Approved" ? "ok" : "wait")" title="@CoachUi.SlotText(s.TimeSlot) @s.MemberName"></i>
                    }
                </span>
                <span class="cx-day-sum">@label</span>
                @if (dayItems.Count > 0)
                {
                    <span class="cx-day-times">@(string.Join(", ", dayItems.Take(3).Select(x => CoachUi.SlotStart(x.TimeSlot).ToString("hh\\:mm"))))@(dayItems.Count > 3 ? "…" : "")</span>
                }
            </li>
        }
    </ol>
</section>

<!-- Toàn bộ ca dạy, lọc nhanh theo trạng thái -->
<section class="cx-panel" aria-labelledby="cxListTitle">
    <header class="cx-panel-head">
        <h2 class="cx-h2" id="cxListTitle">Tất cả ca dạy</h2>
        <div class="cx-filters" role="group" aria-label="Lọc ca dạy">
            <button type="button" class="cx-chip is-on" data-filter="all" aria-pressed="true">Tất cả <b>@all.Count</b></button>
            @if (actionWindowCount > 0)
            {
                <button type="button" class="cx-chip" data-filter="actionable" aria-pressed="false" style="color:#fbbf24;border-color:rgba(251,191,36,0.4);">
                    <i class="bi bi-clock-history"></i> Cần chốt 24h <b>@actionWindowCount</b>
                </button>
            }
            <button type="button" class="cx-chip" data-filter="upcoming" aria-pressed="false">Sắp tới <b>@upcoming.Count</b></button>
            <button type="button" class="cx-chip" data-filter="pending" aria-pressed="false">Chờ duyệt <b>@pendingTotal</b></button>
            <button type="button" class="cx-chip" data-filter="done" aria-pressed="false">Đã dạy / Hoàn thành</button>
            <button type="button" class="cx-chip" data-filter="cancelled" aria-pressed="false">Đã huỷ</button>
        </div>
    </header>

    @if (ordered.Any())
    {
        <ul class="cx-list" id="cxList">
            @foreach (var s in ordered)
            {
                var st = CoachUi.SessionState(s.Status, s.BookingDate, s.TimeSlot);
                var inWindow = s.Status == "Approved" && CoachUi.IsIn24HourWindow(s.BookingDate, s.TimeSlot);
                var reasonId = $"reason-row-{s.BookingId}";
                <li class="cx-row cx-row--@st.Css" data-groups="all @st.Groups">
                    <span class="cx-date">
                        <b>@s.BookingDate.ToString("dd")</b>
                        <small>@CoachUi.DayShort(s.BookingDate)</small>
                        <small>@($"Th{s.BookingDate.Month}")</small>
                    </span>
                    <span class="cx-row-time">@CoachUi.SlotText(s.TimeSlot)</span>
                    <span class="cx-row-who">
                        <span class="cx-avatar cx-avatar--sm" aria-hidden="true">@CoachUi.Initials(s.MemberName)</span>
                        <span>
                            <strong>@s.MemberName</strong>
                            <small>@(string.IsNullOrEmpty(s.MemberPhone) ? "Chưa có số điện thoại" : s.MemberPhone)</small>
                        </span>
                    </span>
                    <span class="cx-row-note">@(string.IsNullOrWhiteSpace(s.Notes) ? "Không có ghi chú" : s.Notes)</span>
                    
                    <div class="cx-row-status-col">
                        @if (inWindow)
                        {
                            <div class="cx-act-cell">
                                <span class="cx-window-pill" title="Trong khung 24h kể từ thời gian bắt đầu ca tập">
                                    <i class="bi bi-clock-history"></i> @CoachUi.WindowCountdown(s.BookingDate, s.TimeSlot)
                                </span>
                                <div class="cx-act-buttons">
                                    <form asp-action="Complete" asp-route-id="@s.BookingId" method="post" style="display:inline;margin:0;">
                                        <button type="submit" class="cx-btn-action cx-btn-action--ok" title="Xác nhận hoàn thành buổi tập">
                                            <i class="bi bi-check-lg"></i> Hoàn thành
                                        </button>
                                    </form>
                                    <details class="cx-reject cx-inline-details">
                                        <summary class="cx-btn-action cx-btn-action--cancel" title="Báo học viên vắng mặt hoặc hủy ca">
                                            <i class="bi bi-x-lg"></i> Hủy / Vắng
                                        </summary>
                                        <form asp-action="Cancel" asp-route-id="@s.BookingId" method="post" class="cx-popover-form">
                                            <label for="@reasonId">Lý do hủy / báo vắng:</label>
                                            <input id="@reasonId" type="text" name="reason" placeholder="VD: Học viên bận đột xuất..." required maxlength="200" />
                                            <button type="submit" class="cx-btn-action cx-btn-action--danger-solid">Xác nhận</button>
                                        </form>
                                    </details>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="cx-st cx-st--@st.Css">@st.Label</span>
                        }
                    </div>
                </li>
            }
        </ul>
        <p class="cx-empty-filter" id="cxListEmpty" hidden>Không có ca nào trong mục này.</p>
    }
    else
    {
        <div class="cx-empty">
            <p><strong>Chưa có ca dạy nào.</strong> Học viên đặt lịch với bạn ở trang Đặt lịch HLV; ca đã duyệt sẽ hiện ở đây.</p>
        </div>
    }
</section>

@section Scripts {
    <script>
        (function () {
            var chips = document.querySelectorAll(".cx-filters .cx-chip");
            var rows = document.querySelectorAll("#cxList .cx-row");
            var empty = document.getElementById("cxListEmpty");
            chips.forEach(function (chip) {
                chip.addEventListener("click", function () {
                    var f = chip.dataset.filter, shown = 0;
                    chips.forEach(function (c) { var on = c === chip; c.classList.toggle("is-on", on); c.setAttribute("aria-pressed", on ? "true" : "false"); });
                    rows.forEach(function (r) {
                        var match = (" " + r.dataset.groups + " ").indexOf(" " + f + " ") !== -1;
                        r.hidden = !match; if (match) shown++;
                    });
                    if (empty) empty.hidden = shown !== 0;
                });
            });
        })();
    </script>
}
