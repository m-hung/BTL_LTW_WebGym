@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject WebGym.Data.ApplicationDbContext Db
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var userName = User.Identity?.Name ?? "Huấn luyện viên";

    // Thông tin HLV đang đăng nhập + số yêu cầu chờ duyệt (hiện trên menu)
    var uid = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedId) ? parsedId : 0;
    var me = await Db.Trainers.AsNoTracking()
        .Where(t => t.UserId == uid)
        .Select(t => new { t.TrainerId, t.Specialization, t.AvatarUrl })
        .FirstOrDefaultAsync();
    var pendingCount = me == null ? 0 : await Db.Bookings.CountAsync(b => b.TrainerId == me.TrainerId && b.Status == "Pending");
    // Giáo án AI của học viên (gói kèm PT) đang chờ HLV này xem
    var planReviewCount = me == null ? 0 : await Db.WorkoutPlans.CountAsync(p =>
        p.Status == WorkoutPlanStatuses.PendingReview && p.IsActive && !p.IsDeleted &&
        Db.Bookings.Any(b => b.MemberId == p.MemberId && b.TrainerId == me.TrainerId && (b.Status == "Approved" || b.Status == "Completed")));
    var today = DateTime.Today;
    var avatarPath = WebGym.Helpers.CoachUi.AvatarPath(me?.AvatarUrl);
    var avatarSrc = avatarPath == null ? null : Url.Content(avatarPath);

    string NavClass(string controller) => "cx-link" + (currentController == controller ? " is-on" : "");
    string? Current(string controller) => currentController == controller ? "page" : null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pulse Gym Coach</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/pt-portal.css" asp-append-version="true" />
</head>
<body class="cx">
    <a class="cx-skip" href="#cxMain">Bỏ qua menu</a>

    <div class="cx-shell">
        <!-- Menu bên trái (trên điện thoại: ngăn kéo mở bằng nút menu) -->
        <aside class="cx-side" id="cxSide" aria-label="Menu huấn luyện viên">
            <a class="cx-brand" asp-area="PT" asp-controller="Schedule" asp-action="Index">
                <i class="cx-bars" aria-hidden="true"></i>
                <span class="cx-brand-name">Pulse <b>Gym</b></span>
                <span class="cx-brand-tag">Coach</span>
            </a>

            <nav class="cx-nav">
                <a class="@NavClass("Schedule")" aria-current="@Current("Schedule")" asp-area="PT" asp-controller="Schedule" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="1.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
                    <span>Lịch dạy</span>
                </a>
                <a class="@NavClass("BookingApproval")" aria-current="@Current("BookingApproval")" asp-area="PT" asp-controller="BookingApproval" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l4.5 4.5L20 6" /></svg>
                    <span>Yêu cầu đặt lịch</span>
                    @if (pendingCount > 0)
                    {
                        <span class="cx-count" aria-label="@pendingCount yêu cầu đang chờ">@pendingCount</span>
                    }
                </a>
                <a class="@NavClass("AssignedMembers")" aria-current="@Current("AssignedMembers")" asp-area="PT" asp-controller="AssignedMembers" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8.5" r="3.5" /><path d="M2.5 20c.6-3.4 3.2-5.5 6.5-5.5s5.9 2.1 6.5 5.5M16 5.2a3.4 3.4 0 010 6.6M18.5 14.8c1.7.8 2.8 2.6 3 5.2" /></svg>
                    <span>Học viên</span>
                </a>
                <a class="@NavClass("PlanReview")" aria-current="@Current("PlanReview")" asp-area="PT" asp-controller="PlanReview" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5h9l3.5 3.5v13.5H6z" /><path d="M14.5 3.5V7.5H18.5M9 12.5l2 2 4-4.5" /></svg>
                    <span>Giáo án chờ duyệt</span>
                    @if (planReviewCount > 0)
                    {
                        <span class="cx-count" aria-label="@planReviewCount giáo án đang chờ">@planReviewCount</span>
                    }
                </a>
                <a class="@NavClass("Profile")" aria-current="@Current("Profile")" asp-area="PT" asp-controller="Profile" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 20.5c.8-4 4-6.5 8-6.5s7.2 2.5 8 6.5" /></svg>
                    <span>Thông tin cá nhân</span>
                </a>

                <span class="cx-nav-sep" role="presentation"></span>

                <a class="cx-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 11L12 4l8.5 7M6 9.5V20h12V9.5" /></svg>
                    <span>Trang chủ Pulse</span>
                </a>
            </nav>

            <div class="cx-me">
                <a class="cx-me-open" asp-area="PT" asp-controller="Profile" asp-action="Index" title="Thông tin cá nhân">
                    <span class="cx-avatar" aria-hidden="true">
                        @if (avatarSrc != null)
                        {
                            <img src="@avatarSrc" alt="" loading="lazy" asp-append-version="true" />
                        }
                        else
                        {
                            @WebGym.Helpers.CoachUi.Initials(userName)
                        }
                    </span>
                    <span class="cx-me-txt">
                        <strong>@userName</strong>
                        <small>@(string.IsNullOrWhiteSpace(me?.Specialization) ? "Huấn luyện viên" : me!.Specialization)</small>
                    </span>
                    <span class="cx-visually-hidden">Mở trang thông tin cá nhân</span>
                </a>
                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="cx-logout">
                    <button type="submit" title="Đăng xuất" aria-label="Đăng xuất">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h5v16h-5M10 8l-4 4 4 4M6 12h10" /></svg>
                    </button>
                </form>
            </div>
        </aside>

        <div class="cx-main">
            <header class="cx-top" data-mark="Coach">
                <button type="button" class="cx-menu" aria-controls="cxSide" aria-expanded="false" aria-label="Mở menu">
                    <span></span><span></span><span></span>
                </button>
                <div class="cx-top-txt">
                    <p class="cx-today">@WebGym.Helpers.CoachUi.DayLong(today), @today.ToString("dd/MM/yyyy")</p>
                    <h1 class="cx-title">@ViewData["Title"]</h1>
                </div>
                <div class="cx-top-act">
                    @await RenderSectionAsync("TopActions", required: false)
                </div>
            </header>

            @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
            {
                <div class="cx-toasts" aria-live="polite">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="cx-toast cx-toast--ok" role="status">
                            <span>@TempData["SuccessMessage"]</span>
                            <button type="button" class="cx-toast-x" aria-label="Đóng thông báo">&times;</button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="cx-toast cx-toast--err" role="alert">
                            <span>@TempData["ErrorMessage"]</span>
                            <button type="button" class="cx-toast-x" aria-label="Đóng thông báo">&times;</button>
                        </div>
                    }
                </div>
            }

            <main class="cx-content" id="cxMain" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="cx-scrim" hidden></div>

    <script>
        (function () {
            var side = document.getElementById("cxSide");
            var btn = document.querySelector(".cx-menu");
            var scrim = document.querySelector(".cx-scrim");
            function setOpen(open) {
                document.body.classList.toggle("cx-nav-open", open);
                btn.setAttribute("aria-expanded", open ? "true" : "false");
                btn.setAttribute("aria-label", open ? "Đóng menu" : "Mở menu");
                scrim.hidden = !open;
                if (open) { var first = side.querySelector("a"); if (first) first.focus(); }
            }
            btn.addEventListener("click", function () { setOpen(!document.body.classList.contains("cx-nav-open")); });
            scrim.addEventListener("click", function () { setOpen(false); });
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && document.body.classList.contains("cx-nav-open")) { setOpen(false); btn.focus(); }
            });
            document.addEventListener("click", function (e) {
                var x = e.target.closest(".cx-toast-x");
                if (x) x.parentElement.remove();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
