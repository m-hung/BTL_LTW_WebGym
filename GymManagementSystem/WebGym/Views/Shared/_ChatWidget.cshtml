@* Chatbot Pulse AI — nút nổi + khung chat ở góc trái màn hình.
   Không hiện ở trang /AI (đã là trang chat riêng). Gọi POST /AI/AskAssistant. *@
@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var showChat = !string.Equals(controllerName, "AI", StringComparison.OrdinalIgnoreCase);
    var fullName = User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : null;
    var firstName = string.IsNullOrWhiteSpace(fullName) ? "" : fullName!.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Last();
}
@if (showChat)
{
    <div class="pc" id="pulseChat" data-endpoint="@Url.Action("AskAssistant", "AI", new { area = "" })" data-name="@firstName">

        <!-- Lời chào nhỏ nhô ra cạnh nút -->
        <div class="pc-teaser" id="pcTeaser" hidden>
            <button type="button" class="pc-teaser-x" id="pcTeaserX" aria-label="Ẩn lời chào">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <span>Cần tư vấn gói tập hay PT?</span>
            <b>Hỏi Pulse AI nhé 👋</b>
        </div>

        <!-- Nút mở chat -->
        <button type="button" class="pc-fab" id="pcFab" aria-label="Mở trợ lý Pulse AI" aria-expanded="false" aria-controls="pcPanel">
            <span class="pc-fab-in">
                <svg class="pc-fab-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 01-11.6 7.1L4 20l1-4.6A8 8 0 1121 12z" /><path d="M13 8l-3 4h4l-3 4" /></svg>
                <span class="pc-fab-label">Hỏi Pulse AI</span>
            </span>
            <i class="pc-dot" aria-hidden="true"></i>
        </button>

        <!-- Khung chat -->
        <section class="pc-panel" id="pcPanel" role="dialog" aria-label="Trợ lý Pulse AI" aria-hidden="true">
            <header class="pc-head">
                <span class="pc-mark" aria-hidden="true"><i class="pc-bars"></i></span>
                <div class="pc-head-txt">
                    <strong>PULSE <em>AI</em></strong>
                    <small><i class="pc-live"></i>Trợ lý Pulse Gym · Trực tuyến</small>
                </div>
                <button type="button" class="pc-icon-btn" id="pcReset" aria-label="Xoá cuộc trò chuyện" title="Cuộc trò chuyện mới">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 109-9 9 9 0 00-6.4 2.6L3 8" /><path d="M3 3v5h5" /></svg>
                </button>
                <button type="button" class="pc-icon-btn" id="pcClose" aria-label="Đóng">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </header>

            <div class="pc-log" id="pcLog" role="log" aria-live="polite" aria-relevant="additions"></div>

            <div class="pc-chips" id="pcChips" aria-label="Gợi ý câu hỏi"></div>

            <form class="pc-form" id="pcForm" autocomplete="off">
                <textarea id="pcInput" rows="1" maxlength="500" placeholder="Hỏi về gói tập, PT, giờ mở cửa…" aria-label="Nhập câu hỏi"></textarea>
                <button type="submit" class="pc-send" id="pcSend" aria-label="Gửi">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
            </form>
            <p class="pc-note">Pulse AI có thể sai sót — hãy xác nhận thông tin quan trọng với lễ tân.</p>
        </section>
    </div>
}
