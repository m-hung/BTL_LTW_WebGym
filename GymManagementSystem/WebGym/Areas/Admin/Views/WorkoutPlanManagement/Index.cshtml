@model WebGym.Models.DTOs.Admin.WorkoutPlanFilterViewModel
@{
    ViewData["Title"] = "Giám Sát & Quản Lý Giáo Án Tập Luyện";
}

<div class="container-fluid px-0">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center">
                <span class="badge bg-info bg-opacity-10 text-info p-2 me-2 rounded-3">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </span>
                Giám Sát & Quản Lý Giáo Án Tập Luyện
            </h3>
            <p class="text-muted mb-0 small">Tra cứu nhanh lộ trình tập luyện, phân bổ bài tập và mục tiêu calo để giải đáp cho hội viên tại quầy.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Tạo Giáo Án Mới
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 me-3 fs-4">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Tổng Lộ Trình</div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalPlans</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-purple bg-opacity-10 text-purple p-3 rounded-4 me-3 fs-4" style="background-color: #f3e8ff; color: #9333ea;">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Giáo Án AI Tạo</div>
                        <h4 class="fw-bold mb-0" style="color: #9333ea;">@Model.AiPlansCount</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-4 me-3 fs-4">
                        <i class="bi bi-person-workspace"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Giáo Án HLV Soạn</div>
                        <h4 class="fw-bold mb-0 text-warning">@Model.TrainerPlansCount</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-4 me-3 fs-4">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Đang Áp Dụng</div>
                        <h4 class="fw-bold mb-0 text-success">@Model.ActivePlansCount</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control bg-light border-0" placeholder="Tìm tên giáo án, mục tiêu, hội viên..." />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="planSourceFilter" class="form-select bg-light border-0">
                        <option value="All" selected="@(Model.PlanSource == "All" || string.IsNullOrEmpty(Model.PlanSource))">-- Tất cả nguồn tạo --</option>
                        <option value="AI" selected="@(Model.PlanSource == "AI")">🤖 Giáo án AI tạo tự động (PlanSource = AI)</option>
                        <option value="Trainer" selected="@(Model.PlanSource == "Trainer")">🏋️ Giáo án HLV soạn riêng (PlanSource = Trainer)</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select name="trainerFilter" class="form-select bg-light border-0">
                        <option value="">-- Tất cả HLV phụ trách --</option>
                        @foreach (var t in Model.Trainers)
                        {
                            <option value="@t.TrainerId" selected="@(Model.TrainerId == t.TrainerId)">@t.User.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select name="memberFilter" class="form-select bg-light border-0">
                        <option value="">-- Tất cả hội viên --</option>
                        @foreach (var m in Model.Members)
                        {
                            <option value="@m.MemberId" selected="@(Model.MemberId == m.MemberId)">@m.User.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary rounded-3 w-100" title="Lọc">
                        <i class="bi bi-funnel"></i>
                    </button>
                    @if (Model.PlanSource != "All" || Model.TrainerId.HasValue || Model.MemberId.HasValue || !string.IsNullOrEmpty(Model.SearchKeyword))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Đặt lại">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Table of Workout Plans -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">TÊN LỘ TRÌNH & MỤC TIÊU</th>
                        <th>NGUỒN TẠO</th>
                        <th>HỘI VIÊN ÁP DỤNG</th>
                        <th>HLV PHỤ TRÁCH</th>
                        <th>THỜI GIAN ÁP DỤNG</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-4" style="width: 140px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Plans.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-clipboard2-x display-6 d-block mb-2 text-secondary opacity-50"></i>
                                Không tìm thấy giáo án tập luyện nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var plan in Model.Plans)
                        {
                            var isAi = plan.PlanSource == "AI";

                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@plan.Id" class="fw-bold text-dark text-decoration-none d-block fs-6 hover-primary">
                                        @plan.Title
                                    </a>
                                    <div class="text-muted small text-truncate" style="max-width: 320px;" title="@plan.Goal">
                                        <i class="bi bi-bullseye text-danger me-1"></i>@plan.Goal
                                    </div>
                                </td>
                                <td>
                                    @if (isAi)
                                    {
                                        <span class="badge rounded-pill px-3 py-1 text-white shadow-sm" style="background: linear-gradient(135deg, #8b5cf6, #3b82f6);">
                                            <i class="bi bi-robot me-1"></i> AI Smart
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-1">
                                            <i class="bi bi-person-badge-fill me-1"></i> HLV Soạn
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@plan.MemberName</div>
                                    <div class="text-muted small">
                                        @(plan.MemberPhone ?? "Chưa có SĐT")
                                        @if (plan.MemberWeight.HasValue)
                                        {
                                            <span class="badge bg-light text-secondary border ms-1">@plan.MemberWeight kg</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="text-dark fw-medium">@plan.TrainerName</div>
                                    <small class="text-muted d-block text-truncate" style="max-width: 180px;">@plan.TrainerSpecialization</small>
                                </td>
                                <td>
                                    <div class="text-dark small">@plan.StartDate.ToString("dd/MM/yyyy") - @plan.EndDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">(@Math.Max(1, (plan.EndDate - plan.StartDate).Days / 7) tuần)</div>
                                </td>
                                <td>
                                    @if (plan.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-2 py-1">Đang kích hoạt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary rounded-pill px-2 py-1">Tạm dừng</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@plan.Id" class="btn btn-outline-primary" title="Xem chi tiết bài tập & dinh dưỡng">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-outline-secondary" title="Sửa giáo án">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger btn-delete-plan"
                                                data-id="@plan.Id"
                                                data-title="@plan.Title"
                                                title="Xóa giáo án">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Hidden Delete Form -->
<form id="deletePlanForm" method="post" asp-action="Delete" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deletePlanId" name="id" value="" />
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteButtons = document.querySelectorAll('.btn-delete-plan');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const title = this.getAttribute('data-title');

                    Swal.fire({
                        title: 'Xác nhận xóa giáo án?',
                        text: `Bạn có chắc chắn muốn xóa lộ trình "${title}"?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#ef4444',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'Đồng ý xóa',
                        cancelButtonText: 'Hủy bỏ'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const form = document.getElementById('deletePlanForm');
                            document.getElementById('deletePlanId').value = id;
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}

