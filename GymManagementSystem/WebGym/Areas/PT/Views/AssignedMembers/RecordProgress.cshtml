@model WebGym.Models.DTOs.Trainer.RecordProgressDto
@{
    ViewData["Title"] = "Cập Nhật Chỉ Số InBody";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="portal-card p-4">
            <div class="mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <h3 class="portal-title-accent fs-3 mb-1">ĐO CHỈ SỐ INBODY <span>HỌC VIÊN: @Model.MemberName</span></h3>
                <div style="color: #a6ada2; font-size: 13.5px;">
                    Ghi nhận các chỉ số cơ thể định kỳ để đánh giá mức độ tiến bộ và điều chỉnh cường độ bài tập
                </div>
            </div>

            <form asp-action="RecordProgress" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MemberId" />
                <input type="hidden" asp-for="MemberName" />

                <!-- Group 1: Weight & Composition -->
                <div class="mb-4">
                    <div class="portal-section-eyebrow">
                        01. THÔNG SỐ CÂN NẶNG & THÀNH PHẦN CƠ THỂ
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Weight" class="form-label">Cân nặng (kg) <span style="color: #ff6b6b;">*</span></label>
                            <input asp-for="Weight" class="form-control" type="number" step="0.1" required />
                            <span asp-validation-for="Weight" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BodyFatPercentage" class="form-label">Tỷ lệ mỡ Body Fat (%)</label>
                            <input asp-for="BodyFatPercentage" class="form-control" type="number" step="0.1" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MuscleMass" class="form-label">Khối lượng cơ (kg)</label>
                            <input asp-for="MuscleMass" class="form-control" type="number" step="0.1" />
                        </div>
                    </div>
                </div>

                <!-- Group 2: Circumferences -->
                <div class="mb-4">
                    <div class="portal-section-eyebrow">
                        02. SỐ ĐO 3 VÒNG CƠ THỂ
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Chest" class="form-label">Vòng ngực (cm)</label>
                            <input asp-for="Chest" class="form-control" type="number" step="0.1" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Waist" class="form-label">Vòng eo (cm)</label>
                            <input asp-for="Waist" class="form-control" type="number" step="0.1" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Hips" class="form-label">Vòng mông (cm)</label>
                            <input asp-for="Hips" class="form-control" type="number" step="0.1" />
                        </div>
                    </div>
                </div>

                <!-- Group 3: Notes -->
                <div class="mb-4">
                    <div class="portal-section-eyebrow">
                        03. ĐÁNH GIÁ CHUYÊN MÔN CỦA HLV
                    </div>
                    <label asp-for="Notes" class="form-label">Nhận xét chi tiết sau buổi đo</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" 
                              placeholder="Ví dụ: Cơ bụng săn chắc rõ rệt, tỷ lệ mỡ giảm 1.5%. Cần giữ vững phong độ dinh dưỡng và tăng thêm khối lượng tạ bài Squat..."></textarea>
                </div>

                <div class="pt-3 border-top border-secondary border-opacity-25 d-flex gap-3">
                    <button type="submit" class="btn-pulse-primary">
                        LƯU KẾT QUẢ ĐO
                    </button>
                    <a asp-action="Index" class="btn-pulse-outline">
                        Quay Lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
