@model IEnumerable<WebGym.Models.Entities.Booking>
@{
    ViewData["Title"] = "Quản Lý Lịch Tập PT";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-calendar2-week-fill text-primary me-2"></i>Lịch Đặt Huấn Luyện Viên Toàn Hệ Thống
        </h3>
        <p class="text-muted small mb-0">Theo dõi, điều phối và phê duyệt các ca tập 1:1 giữa hội viên và HLV.</p>
    </div>
</div>

<!-- Quick Stat Counters -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">CHỜ DUYỆT</span>
                    <h3 class="fw-bold text-warning my-1">@ViewBag.TotalPending</h3>
                </div>
                <div class="fs-1 text-warning opacity-75"><i class="bi bi-hourglass-split"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">ĐÃ DUYỆT / CHUẨN BỊ</span>
                    <h3 class="fw-bold text-success my-1">@ViewBag.TotalApproved</h3>
                </div>
                <div class="fs-1 text-success opacity-75"><i class="bi bi-check2-circle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">ĐÃ HOÀN THÀNH</span>
                    <h3 class="fw-bold text-primary my-1">@ViewBag.TotalCompleted</h3>
                </div>
                <div class="fs-1 text-primary opacity-75"><i class="bi bi-trophy"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filters -->
<div class="card border-0 bg-white p-3 mb-4 rounded-4 shadow-sm">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="statusFilter" class="form-select bg-light">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Chờ duyệt (Pending)</option>
                <option value="Approved" selected="@(ViewBag.StatusFilter == "Approved")">Đã duyệt (Approved)</option>
                <option value="Completed" selected="@(ViewBag.StatusFilter == "Completed")">Đã hoàn thành (Completed)</option>
                <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled")">Đã hủy (Cancelled)</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="trainerId" class="form-select bg-light" asp-items="ViewBag.Trainers">
                <option value="">-- Tất cả HLV --</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="date" name="bookingDate" class="form-control bg-light" value="@ViewBag.SelectedDate" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100 rounded-3">
                <i class="bi bi-funnel me-1"></i> Lọc
            </button>
        </div>
        <div class="col-md-1">
            <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-3" title="Xóa bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Bookings Table -->
<div class="card border-0 rounded-4 bg-white shadow-sm p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-table me-2 text-secondary"></i>Danh Sách Lịch Tập</h5>
        <span class="badge bg-primary rounded-pill">Tổng: @Model.Count() lịch hẹn</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Hội Viên</th>
                    <th>HLV Phụ Trách</th>
                    <th>Ngày Tập</th>
                    <th>Khung Giờ</th>
                    <th>Trạng Thái</th>
                    <th>Ghi Chú</th>
                    <th class="text-end">Xử Lý Nhanh</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Không có lịch tập nào khớp với bộ lọc.</td>
                    </tr>
                }
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="text-muted fw-bold">#@b.BookingId</td>
                        <td>
                            <div class="fw-bold text-dark">@b.Member.User.FullName</div>
                            <small class="text-muted">@b.Member.User.PhoneNumber</small>
                        </td>
                        <td>
                            <div class="fw-semibold text-primary">@b.Trainer.User.FullName</div>
                            <small class="text-muted">@b.Trainer.Specialization</small>
                        </td>
                        <td>
                            <div class="fw-bold">@b.BookingDate.ToString("dd/MM/yyyy")</div>
                            <small class="text-muted">@b.BookingDate.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border px-2 py-1">
                                <i class="bi bi-clock me-1 text-primary"></i>@b.TimeSlot
                            </span>
                        </td>
                        <td>
                            @if (b.Status == "Approved")
                            {
                                <span class="badge badge-soft-success">Đã duyệt</span>
                            }
                            else if (b.Status == "Pending")
                            {
                                <span class="badge badge-soft-warning">Chờ duyệt</span>
                            }
                            else if (b.Status == "Completed")
                            {
                                <span class="badge badge-soft-primary">Hoàn thành</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-danger">Đã hủy</span>
                            }
                        </td>
                        <td>
                            <small class="text-muted">@(b.Notes ?? "-")</small>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                @if (b.Status == "Pending")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.BookingId" />
                                        <input type="hidden" name="status" value="Approved" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-3" title="Duyệt lịch">
                                            <i class="bi bi-check-lg"></i> Duyệt
                                        </button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.BookingId" />
                                        <input type="hidden" name="status" value="Cancelled" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Hủy lịch">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                }
                                else if (b.Status == "Approved")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.BookingId" />
                                        <input type="hidden" name="status" value="Completed" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-3" title="Xác nhận đã tập xong">
                                            <i class="bi bi-check2-all me-1"></i>Xong
                                        </button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.BookingId" />
                                        <input type="hidden" name="status" value="Cancelled" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Hủy lịch">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
