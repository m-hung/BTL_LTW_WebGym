@model IEnumerable<WebGym.Models.Entities.Booking>
@{
    ViewData["Title"] = "Quản Lý Lịch Tập";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-calendar-check-fill text-warning"></i> Toàn Bộ Lịch Đặt PT Toàn Hệ Thống</h2>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã Lịch</th>
                    <th>Hội Viên</th>
                    <th>HLV Phụ Trách</th>
                    <th>Ngày Tập</th>
                    <th>Khung Giờ</th>
                    <th>Trạng Thái</th>
                    <th>Ghi Chú</th>
                    <th>Duyệt Nhanh</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>#@b.BookingId</td>
                        <td class="fw-bold">@b.Member.User.FullName</td>
                        <td>@b.Trainer.User.FullName</td>
                        <td>@b.BookingDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge bg-light text-dark border">@b.TimeSlot</span></td>
                        <td>
                            <span class="badge @(b.Status == "Approved" ? "bg-success" : (b.Status == "Pending" ? "bg-warning text-dark" : (b.Status == "Completed" ? "bg-primary" : "bg-secondary")))">
                                @b.Status
                            </span>
                        </td>
                        <td><small class="text-muted">@(b.Notes ?? "-")</small></td>
                        <td>
                            @if (b.Status == "Pending")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@b.BookingId" />
                                    <input type="hidden" name="status" value="Approved" />
                                    <button type="submit" class="btn btn-sm btn-success me-1">Duyệt</button>
                                </form>
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@b.BookingId" />
                                    <input type="hidden" name="status" value="Cancelled" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
