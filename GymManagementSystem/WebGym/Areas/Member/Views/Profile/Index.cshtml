@model WebGym.Models.DTOs.Member.MemberProfileDto
@{
    ViewData["Title"] = "Chỉ Số Cơ Thể & Thẻ Hội Viên";
    var progressList = ViewBag.ProgressList as List<WebGym.Models.Entities.Progress> ?? new List<WebGym.Models.Entities.Progress>();
    double? bmi = (Model.Height > 0 && Model.Weight > 0) 
        ? Math.Round((double)Model.Weight.Value / Math.Pow((double)Model.Height.Value / 100, 2), 1) 
        : null;

    // Chuẩn bị dữ liệu cho Chart.js (Không dùng dữ liệu ảo cho tài khoản mới)
    var chartLabels = new List<string>();
    var weightData = new List<double>();
    var bodyFatData = new List<double>();
    bool hasProgressData = progressList.Any() && Model.Weight.HasValue && Model.Weight > 0;

    if (hasProgressData)
    {
        int step = 1;
        foreach (var p in progressList.OrderBy(x => x.RecordedDate))
        {
            chartLabels.Add($"T{step} ({p.RecordedDate:dd/MM})");
            weightData.Add(p.Weight);
            bodyFatData.Add(p.BodyFatPercentage ?? 0);
            step++;
        }
    }
}

<!-- Lối vào giáo án AI (Member/Plan) -->
<div class="portal-card p-3 p-md-4 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3" style="border-color: rgba(200, 255, 46, 0.35);">
    <div>
        <div class="portal-section-eyebrow mb-1">Giáo án cá nhân</div>
        <div style="color: #f2f5ef; font-size: 15px;">Dùng số đo trên để AI gợi ý lịch tập, calo và thực đơn món Việt dành riêng cho bạn.</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-area="Member" asp-controller="Plan" asp-action="Create" class="btn-pulse-primary">Tạo lộ trình cùng AI</a>
        <a asp-area="Member" asp-controller="Plan" asp-action="Index" class="btn-pulse-outline">Giáo án của tôi</a>
    </div>
</div>
<!-- SECTION: THẺ HỘI VIÊN ĐIỆN TỬ DẠNG ATM SANG TRỌNG TRÊN TRANG CÁ NHÂN -->
<div class="portal-card p-3 p-md-4 mb-4">
    <div class="row g-4 align-items-center">
        <!-- Cột trái: Thẻ ATM điện tử sang trọng -->
        <div class="col-lg-5 col-xl-5 text-center">
            <partial name="_DigitalMemberCard" model="Model.ToCardModel()" />
        </div>

        <!-- Cột phải: Lời chào và tóm tắt thông tin hội viên -->
        <div class="col-lg-7 col-xl-7">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="portal-badge" style="background: rgba(200, 255, 46, 0.12); color: var(--portal-lime); border: 1px solid rgba(200, 255, 46, 0.3);">
                    HỘI VIÊN CHÍNH THỨC
                </span>
                <a asp-action="PersonalInfo" class="small fw-semibold link-ul" style="color: var(--portal-lime); text-decoration: none;">
                    Hồ sơ chi tiết & Cài đặt ➔
                </a>
            </div>
            <h2 class="portal-title-accent mb-2 fs-3">XIN CHÀO, <span>@Model.FullName</span></h2>
            <p class="small text-muted mb-3" style="line-height: 1.6;">
                Thẻ hội viên điện tử tích hợp mã QR cá nhân đã sẵn sàng. Bạn có thể xuất trình trực tiếp trên điện thoại để Admin / Lễ tân quét điểm danh vào phòng tập nhanh chóng.
            </p>
            <div class="d-flex flex-wrap gap-2 pt-1">
                <div class="p-2 px-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <small class="d-block text-muted" style="font-size: 10.5px;">MÃ THẺ HỘI VIÊN</small>
                    <strong style="color: var(--portal-lime); font-family: monospace; font-size: 13.5px;">@(Model.CardCode ?? $"GYM-MB-{Model.Id:D4}")</strong>
                </div>
                <div class="p-2 px-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <small class="d-block text-muted" style="font-size: 10.5px;">GÓI TẬP HIỆN TẠI</small>
                    <strong style="color: #ffffff; font-size: 13.5px;">@(Model.CurrentPackageName ?? "Chưa đăng ký gói")</strong>
                </div>
                <div class="p-2 px-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <small class="d-block text-muted" style="font-size: 10.5px;">NGÀY HẾT HẠN</small>
                    <strong style="color: #ffffff; font-size: 13.5px;">@(Model.MembershipEndDate?.ToString("dd/MM/yyyy") ?? "Vô thời hạn")</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 4 Key InBody Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="portal-stat-card">
            <div class="portal-stat-label" style="color: #b5bcaf;">
                <span>CÂN NẶNG</span>
            </div>
            <div class="portal-stat-val" style="color: #f2f5ef;">
                @if (Model.Weight > 0)
                {
                    @Model.Weight.Value.ToString("0.0") <span style="font-size: 15px; color: #9aa296; font-family: var(--portal-body); font-weight: normal;">kg</span>
                }
                else
                {
                    <span>--</span>
                }
            </div>
            <div class="portal-stat-sub" style="color: #a0a79c;">
                Chiều cao: @(Model.Height > 0 ? $"{Model.Height.Value:0} cm" : "--")
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="portal-stat-card">
            <div class="portal-stat-label" style="color: #b5bcaf;">
                <span>CHỈ SỐ BMI</span>
            </div>
            <div class="portal-stat-val" style="color: #f2f5ef;">
                @(bmi?.ToString("0.0") ?? "--")
            </div>
            <div class="portal-stat-sub">
                @if (bmi.HasValue)
                {
                    if (bmi < 18.5) { <span style="color: #48cae4;">Thiếu cân</span>; }
                    else if (bmi < 24.9) { <span style="color: var(--portal-lime); font-weight: 600;">Cân đối (Chuẩn)</span>; }
                    else if (bmi < 29.9) { <span style="color: #f5b041;">Thừa cân</span>; }
                    else { <span style="color: #ff7675;">Béo phì</span>; }
                }
                else
                {
                    <span style="color: #a0a79c;">Chưa có dữ liệu InBody</span>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="portal-stat-card">
            <div class="portal-stat-label" style="color: #b5bcaf;">
                <span>TỶ LỆ MỠ CƠ THỂ</span>
            </div>
            <div class="portal-stat-val" style="color: #f2f5ef;">
                @if (Model.BodyFatPercentage > 0)
                {
                    @Model.BodyFatPercentage.Value.ToString("0.0") <span style="font-size: 15px; color: #9aa296; font-family: var(--portal-body); font-weight: normal;">%</span>
                }
                else
                {
                    <span>--</span>
                }
            </div>
            <div class="portal-stat-sub" style="color: #a0a79c;">
                Khối lượng cơ: @(Model.MuscleMass > 0 ? $"{Model.MuscleMass.Value:0.0} kg" : "--")
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="portal-stat-card">
            <div class="portal-stat-label" style="color: #b5bcaf;">
                <span>CHUYỂN HÓA BMR</span>
            </div>
            <div class="portal-stat-val" style="color: #f2f5ef;">
                @if (Model.BMR > 0)
                {
                    @Model.BMR.Value.ToString("0") <span style="font-size: 15px; color: #9aa296; font-family: var(--portal-body); font-weight: normal;">kcal</span>
                }
                else
                {
                    <span>--</span>
                }
            </div>
            <div class="portal-stat-sub" style="color: #a0a79c;">Năng lượng tiêu hao cơ bản</div>
        </div>
    </div>
</div>

<!-- Detailed Body Circumference Measurements -->
<div class="portal-card p-4 mb-4">
    <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-25">
        <h3 class="portal-title-accent fs-4 mb-0">SỐ ĐO HÌNH THỂ <span>CHI TIẾT</span></h3>
    </div>
    <div class="row g-3 text-center">
        <div class="col-6 col-md-3">
            <div class="p-3 rounded" style="background-color: var(--portal-bg2); border: 1px solid var(--portal-line);">
                <div class="small mb-1" style="color: #9aa296;">Vòng Ngực</div>
                <div class="fs-4 fw-bold" style="color: #e5eae0;">
                    @if (Model.Chest > 0)
                    {
                        @Model.Chest.Value.ToString("0.0") <span style="font-size: 13px; color: #889084;">cm</span>
                    }
                    else
                    {
                        <span>--</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded" style="background-color: var(--portal-bg2); border: 1px solid var(--portal-line);">
                <div class="small mb-1" style="color: #9aa296;">Vòng Eo</div>
                <div class="fs-4 fw-bold" style="color: #e5eae0;">
                    @if (Model.Waist > 0)
                    {
                        @Model.Waist.Value.ToString("0.0") <span style="font-size: 13px; color: #889084;">cm</span>
                    }
                    else
                    {
                        <span>--</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded" style="background-color: var(--portal-bg2); border: 1px solid var(--portal-line);">
                <div class="small mb-1" style="color: #9aa296;">Vòng Hông</div>
                <div class="fs-4 fw-bold" style="color: #e5eae0;">
                    @if (Model.Hips > 0)
                    {
                        @Model.Hips.Value.ToString("0.0") <span style="font-size: 13px; color: #889084;">cm</span>
                    }
                    else
                    {
                        <span>--</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded" style="background-color: var(--portal-bg2); border: 1px solid var(--portal-line);">
                <div class="small mb-1" style="color: #9aa296;">Khối Lượng Cơ</div>
                <div class="fs-4 fw-bold" style="color: #e5eae0;">
                    @if (Model.MuscleMass > 0)
                    {
                        @Model.MuscleMass.Value.ToString("0.0") <span style="font-size: 13px; color: #889084;">kg</span>
                    }
                    else
                    {
                        <span>--</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Evolution Line Chart (Đồ thị biến thiên cân nặng & Body Fat) -->
<div class="portal-card p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
        <div>
            <h3 class="portal-title-accent fs-4 mb-0">BIỂU ĐỒ THEO DÕI <span>TIẾN TRÌNH LUYỆN TẬP</span></h3>
            <div style="color: #a6ada2; font-size: 13.5px;">
                Theo dõi sự thay đổi của Cân nặng và Tỷ lệ mỡ cơ thể qua các lần kiểm tra InBody
            </div>
        </div>

        @if (hasProgressData)
        {
            <!-- Chart Legend Indicator -->
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span style="width: 12px; height: 12px; border-radius: 50%; background-color: var(--portal-lime); display: inline-block;"></span>
                    <span class="small fw-semibold" style="color: #e5eae0;">Cân nặng (kg)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span style="width: 12px; height: 12px; border-radius: 50%; background-color: #48cae4; display: inline-block;"></span>
                    <span class="small fw-semibold" style="color: #e5eae0;">Body Fat (%)</span>
                </div>
            </div>
        }
    </div>

    @if (hasProgressData)
    {
        <!-- Chart Canvas Container -->
        <div style="position: relative; width: 100%; min-height: 320px; max-height: 420px;">
            <canvas id="inbodyChart"></canvas>
        </div>
    }
    else
    {
        <!-- Empty State: Chưa có dữ liệu InBody cho tài khoản mới -->
        <div class="text-center py-5 my-2" style="background: rgba(255, 255, 255, 0.01); border-radius: 8px; border: 1px dashed rgba(200, 255, 46, 0.25);">
            <div class="mb-3">
                <i class="bi bi-activity" style="font-size: 42px; color: var(--portal-lime); opacity: 0.85;"></i>
            </div>
            <h5 class="fw-bold mb-2" style="color: #f2f5ef; font-family: var(--portal-display); font-size: 19px; letter-spacing: 0.04em;">
                CHƯA CÓ DỮ LIỆU ĐO INBODY
            </h5>
            <p class="small mb-0 mx-auto" style="max-width: 500px; line-height: 1.6; color: #9aa296;">
                Tài khoản mới tạo chưa có lịch sử đo chỉ số cơ thể.
                Huấn luyện viên cá nhân (PT) sẽ tiến hành kiểm tra InBody và cập nhật tiến trình luyện tập của bạn tại phòng tập.
            </p>
        </div>
    }

    <!-- Notice Footer -->
    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div class="small" style="color: #9aa296;">
            <i class="bi bi-info-circle me-1" style="color: var(--portal-lime);"></i> Chỉ số hình thể được cập nhật chính xác nhất bởi Huấn luyện viên (PT) thông qua máy đo InBody chuyên dụng.
        </div>
        <a asp-action="PersonalInfo" class="btn-pulse-outline btn-sm py-1 px-3">
            Chỉnh sửa thông tin liên hệ
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (!hasProgressData) {
                <text>return;</text>
            }
            const ctx = document.getElementById('inbodyChart');
            if (!ctx) return;

            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartLabels));
            const weights = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(weightData));
            const bodyFats = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bodyFatData));

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Cân nặng (kg)',
                            data: weights,
                            borderColor: '#c8ff2e',
                            backgroundColor: 'rgba(200, 255, 46, 0.08)',
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.3,
                            pointBackgroundColor: '#c8ff2e',
                            pointBorderColor: '#121714',
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            pointHoverRadius: 7,
                            yAxisID: 'yWeight'
                        },
                        {
                            label: 'Tỷ lệ mỡ (%)',
                            data: bodyFats,
                            borderColor: '#48cae4',
                            backgroundColor: 'rgba(72, 202, 228, 0.05)',
                            borderWidth: 2,
                            borderDash: [4, 4],
                            fill: false,
                            tension: 0.3,
                            pointBackgroundColor: '#48cae4',
                            pointBorderColor: '#121714',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            yAxisID: 'yBodyFat'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: 'rgba(19, 23, 21, 0.95)',
                            titleColor: '#ffffff',
                            bodyColor: '#e5eae0',
                            borderColor: 'rgba(255, 255, 255, 0.1)',
                            borderWidth: 1,
                            padding: 12,
                            boxPadding: 6,
                            usePointStyle: true
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                color: 'rgba(255, 255, 255, 0.04)',
                                drawBorder: false
                            },
                            ticks: {
                                color: '#9aa296',
                                font: {
                                    family: 'Inter, sans-serif',
                                    size: 12
                                }
                            }
                        },
                        yWeight: {
                            type: 'linear',
                            position: 'left',
                            grid: {
                                color: 'rgba(255, 255, 255, 0.04)',
                                drawBorder: false
                            },
                            ticks: {
                                color: '#c8ff2e',
                                font: {
                                    family: 'Inter, sans-serif',
                                    size: 12
                                },
                                callback: function (val) {
                                    return val + ' kg';
                                }
                            }
                        },
                        yBodyFat: {
                            type: 'linear',
                            position: 'right',
                            grid: {
                                drawOnChartArea: false
                            },
                            ticks: {
                                color: '#48cae4',
                                font: {
                                    family: 'Inter, sans-serif',
                                    size: 12
                                },
                                callback: function (val) {
                                    return val + ' %';
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
