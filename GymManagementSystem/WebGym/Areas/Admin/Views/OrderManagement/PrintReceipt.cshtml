@model WebGym.Models.Entities.Order
@{
    Layout = null;
    var customerName = Model.Member?.User?.FullName ?? (Model.User?.FullName ?? (Model.ShippingAddress?.StartsWith("Khách vãng lai: ") == true ? Model.ShippingAddress.Replace("Khách vãng lai: ", "") : "Khách lẻ"));
    var customerPhone = Model.PhoneNumber ?? (Model.Member?.User?.PhoneNumber ?? Model.User?.PhoneNumber ?? "---");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hóa Đơn Bán Lẻ #OD-@Model.OrderId.ToString("D4") - WebGym</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
            padding: 20px 0;
        }

        .receipt-container {
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
            background: #ffffff;
            padding: 30px 24px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .receipt-header {
            text-align: center;
            border-bottom: 2px dashed #cbd5e1;
            padding-bottom: 18px;
            margin-bottom: 18px;
        }

        .brand-title {
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #0f172a;
            margin-bottom: 2px;
        }

        .receipt-meta {
            font-size: 0.825rem;
            color: #475569;
            line-height: 1.4;
        }

        .dashed-line {
            border-top: 1px dashed #cbd5e1;
            margin: 14px 0;
        }

        .item-table th {
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 700;
            color: #64748b;
            padding-bottom: 8px;
            border-bottom: 1px solid #e2e8f0;
        }

        .item-table td {
            font-size: 0.85rem;
            padding: 8px 0;
            vertical-align: top;
            border-bottom: 1px dashed #f1f5f9;
        }

        .price-mono {
            font-family: 'Space Mono', monospace;
            font-weight: 600;
        }

        .receipt-footer {
            text-align: center;
            border-top: 2px dashed #cbd5e1;
            padding-top: 18px;
            margin-top: 18px;
            font-size: 0.8rem;
            color: #64748b;
        }

        .action-bar {
            max-width: 480px;
            margin: 0 auto 16px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        @@media print {
            body {
                background: white;
                padding: 0;
            }
            .action-bar {
                display: none !important;
            }
            .receipt-container {
                box-shadow: none;
                padding: 0;
                max-width: 100%;
                border-radius: 0;
            }
        }
    </style>
</head>
<body>
    <!-- Action Bar (Hidden on print) -->
    <div class="action-bar">
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="window.close()">
            <i class="bi bi-arrow-left"></i> Đóng
        </button>
        <button type="button" class="btn btn-primary btn-sm rounded-pill shadow-sm" onclick="window.print()">
            <i class="bi bi-printer-fill me-1"></i> In Biên Lai Ngay
        </button>
    </div>

    <!-- Receipt Container -->
    <div class="receipt-container">
        <!-- Header -->
        <div class="receipt-header">
            <div class="brand-title">WEBGÝM FITNESS & YOGA</div>
            <div class="receipt-meta">
                <div>Địa chỉ: Tầng 3, Tòa nhà Thể Thao WebGym, Hà Nội</div>
                <div>Hotline: 1900 6868 &bull; Website: webgym.vn</div>
            </div>
            <div class="mt-2 fw-bold text-uppercase fs-6">HÓA ĐƠN BÁN LẺ</div>
            <div class="receipt-meta">Mã đơn: <strong class="price-mono">#OD-@Model.OrderId.ToString("D4")</strong></div>
        </div>

        <!-- Order Meta -->
        <div class="receipt-meta">
            <div class="d-flex justify-content-between mb-1">
                <span>Thời gian:</span>
                <span class="price-mono">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span>Khách hàng:</span>
                <span class="fw-bold text-dark">@customerName</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span>Số điện thoại:</span>
                <span>@customerPhone</span>
            </div>
            <div class="d-flex justify-content-between">
                <span>Thu ngân / POS:</span>
                <span>Quầy Lễ Tân Trung Tâm</span>
            </div>
        </div>

        <div class="dashed-line"></div>

        <!-- Items Table -->
        <table class="w-100 item-table">
            <thead>
                <tr>
                    <th style="width: 50%;">SẢN PHẨM</th>
                    <th class="text-center" style="width: 15%;">SL</th>
                    <th class="text-end" style="width: 35%;">THÀNH TIỀN</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold text-dark">@(item.Product?.ProductName ?? "Sản phẩm")</div>
                            <small class="text-muted price-mono">@item.UnitPrice.ToString("N0") đ</small>
                        </td>
                        <td class="text-center price-mono">@item.Quantity</td>
                        <td class="text-end price-mono fw-bold">@item.TotalPrice.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="dashed-line"></div>

        <!-- Total Calculation -->
        <div class="receipt-meta">
            <div class="d-flex justify-content-between mb-1">
                <span>Tổng số lượng:</span>
                <span class="price-mono">@Model.OrderDetails.Sum(od => od.Quantity) sản phẩm</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span>Tạm tính tiền hàng:</span>
                <span class="price-mono">@Model.TotalAmount.ToString("N0") đ</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span>Chiết khấu / Voucher:</span>
                <span class="price-mono">0 đ</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-dark border-opacity-25">
                <span class="fw-bold text-dark fs-6">TỔNG THANH TOÁN:</span>
                <span class="fw-bold fs-5 text-dark price-mono">@Model.TotalAmount.ToString("N0") đ</span>
            </div>
            <div class="d-flex justify-content-between mt-1">
                <span>Hình thức thanh toán:</span>
                <span class="fw-bold text-dark">@Model.PaymentMethod</span>
            </div>
            <div class="d-flex justify-content-between mt-1">
                <span>Trạng thái:</span>
                <span class="badge bg-light text-dark border">@Model.Status</span>
            </div>
        </div>

        <!-- Footer -->
        <div class="receipt-footer">
            <div class="fw-semibold mb-1">CẢM ƠN QUÝ KHÁCH ĐÃ ĐỒNG HÀNH!</div>
            <div>Chúc Quý khách một buổi tập luyện tràn đầy năng lượng & hiệu quả.</div>
            <div class="small mt-2 text-muted price-mono">*** WebGym Management POS System ***</div>
        </div>
    </div>

    <script>
        // Auto trigger print when loaded
        window.addEventListener('load', function () {
            // setTimeout to let fonts render
            setTimeout(() => {
                window.print();
            }, 500);
        });
    </script>
</body>
</html>

