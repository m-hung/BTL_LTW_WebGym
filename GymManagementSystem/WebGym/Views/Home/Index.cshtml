@model IEnumerable<WebGym.Models.Entities.GymPackage>
@{
    Layout = null;
    ViewData["Title"] = "Pulse Gym - Bứt phá giới hạn";
    var packages = Model ?? (IEnumerable<WebGym.Models.Entities.GymPackage>?)ViewBag.FeaturedPackages ?? Enumerable.Empty<WebGym.Models.Entities.GymPackage>();
    var trainers = (IEnumerable<WebGym.Models.Entities.Trainer>?)ViewBag.Trainers ?? Enumerable.Empty<WebGym.Models.Entities.Trainer>();
    var groupClasses = (IEnumerable<WebGym.Models.Entities.GymClass>?)ViewBag.GroupClasses ?? Enumerable.Empty<WebGym.Models.Entities.GymClass>();

    var bmiConfig = new
    {
        plans = packages.OrderBy(p => p.Price).Select(p => new
        {
            id = p.PackageId,
            name = p.PackageName,
            price = p.Price.ToString("N0") + " VNĐ",
            duration = p.DurationDays >= 365 ? "1 năm" : (p.DurationDays % 30 == 0 ? $"{p.DurationDays / 30} tháng" : $"{p.DurationDays} ngày"),
            desc = p.Description,
            url = Url.Action("Index", "Checkout", new { slug = p.PackageId })
        }),
        areas = new
        {
            weights = Url.Action("FacilityDetail", "Home", new { id = "khu-ta-tu-do" }),
            cardio = Url.Action("FacilityDetail", "Home", new { id = "khu-cardio" }),
            boxing = Url.Action("FacilityDetail", "Home", new { id = "phong-boxing" }),
            yoga = Url.Action("FacilityDetail", "Home", new { id = "studio-yoga" })
        }
    };
    var bmiJson = System.Text.Json.JsonSerializer.Serialize(bmiConfig);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/pulse.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat-widget.css" asp-append-version="true" />
</head>
<body>
    <header class="nav">
        <a href="#top" class="logo"><i class="logo-bars"></i>PULSE <span>GYM</span></a>
        <nav class="nav-links">
            <a href="#khu-vuc">Khu vực tập</a>
            <a href="#lop-nhom">Lớp học nhóm</a>
            <a href="#suc-khoe">Sức khỏe và tư vấn</a>
            <a href="#huan-luyen-vien">Huấn luyện viên</a>
            <a href="#bang-gia">Bảng giá</a>
        </nav>
        <div class="nav-actions"><partial name="_AuthButtons" /></div>
    </header>

    <main id="top">
        <!-- HERO -->
        <section class="hero">
            <div class="hero-text">
                <p class="eyebrow">Không viện cớ. Chỉ kết quả.</p>
                <h1 class="display">Bứt phá<em class="outline">giới hạn</em></h1>
                <p class="lead">Đánh thức phiên bản mạnh mẽ nhất của bạn với không gian tập luyện chuẩn quốc tế và đội ngũ huấn luyện viên tận tâm.</p>
                <div class="hero-cta">
                    <a href="#bang-gia" class="btn">Bắt đầu ngay <b>→</b></a>
                    <button type="button" class="play" id="playIntro" aria-haspopup="dialog"><span>▶</span>Khám phá Pulse</button>
                </div>
                <ul class="stats">
                    <li><strong>2.5K<sup>+</sup></strong><span>Hội viên đang tập luyện</span></li>
                    <li><strong>25<sup>+</sup></strong><span>Huấn luyện viên chuyên nghiệp</span></li>
                    <li><strong>12</strong><span>Năm đồng hành cùng thể hình Việt</span></li>
                </ul>
            </div>
            <div class="hero-media">
                <img src="~/images/hero.jpg" asp-append-version="true" alt="Hội viên Pulse Gym đang tập luyện" />
                <div class="chip chip-open"><small><i class="dot"></i>Mở cửa hôm nay</small><strong>05:00 — 23:00</strong></div>
                <div class="chip chip-sat"><span class="arrow-box">↗</span><div><strong>98%</strong><small>Hội viên hài lòng</small></div></div>
            </div>
        </section>

        <!-- MARQUEE -->
        <div class="marquee" aria-hidden="true">
            <div class="marquee-track">
                <span>Train hard</span><i>✦</i><span>Stay strong</span><i>✦</i><span>No excuses</span><i>✦</i><span>Go beyond</span><i>✦</i>
                <span>Train hard</span><i>✦</i><span>Stay strong</span><i>✦</i><span>No excuses</span><i>✦</i><span>Go beyond</span><i>✦</i>
                <span>Train hard</span><i>✦</i><span>Stay strong</span><i>✦</i><span>No excuses</span><i>✦</i><span>Go beyond</span><i>✦</i>
            </div>
        </div>

        <!-- KHU VỰC TẬP LUYỆN -->
        <section id="khu-vuc" class="section">
            <div class="head">
                <div>
                    <p class="eyebrow">Cơ sở vật chất</p>
                    <h2 class="display">Không gian<em class="outline">của người mạnh</em></h2>
                </div>
                <p class="head-note">Mỗi khu vực được thiết kế riêng với trang thiết bị chuẩn quốc tế, để bạn tập luyện thoải mái và hiệu quả hơn.</p>
            </div>
            <div class="programs">
                <a asp-controller="Home" asp-action="FacilityDetail" asp-route-id="khu-ta-tu-do" class="program"><img src="~/images/gym.jpg" asp-append-version="true" alt="" /><span class="num">01</span><div><small>Sức mạnh • Hình thể</small><h3>Tạ tự do</h3></div><span class="arrow-circle">↗</span></a>
                <a asp-controller="Home" asp-action="FacilityDetail" asp-route-id="khu-cardio" class="program"><img src="~/images/hiit.jpg" asp-append-version="true" alt="" /><span class="num">02</span><div><small>Đốt mỡ • Sức bền</small><h3>Cardio</h3></div><span class="arrow-circle">↗</span></a>
                <a asp-controller="Home" asp-action="FacilityDetail" asp-route-id="phong-boxing" class="program"><img src="~/images/boxing.jpg" asp-append-version="true" alt="" /><span class="num">03</span><div><small>Phản xạ • Bùng nổ</small><h3>Boxing</h3></div><span class="arrow-circle">↗</span></a>
                <a asp-controller="Home" asp-action="FacilityDetail" asp-route-id="studio-yoga" class="program"><img src="~/images/yoga.jpg" asp-append-version="true" alt="" /><span class="num">04</span><div><small>Cân bằng • Linh hoạt</small><h3>Yoga</h3></div><span class="arrow-circle">↗</span></a>
            </div>
        </section>

        <!-- LỚP HỌC NHÓM (GROUP CLASSES) -->
        <section id="lop-nhom" class="section section-alt">
            <div class="head">
                <div>
                    <p class="eyebrow">Năng lượng đồng đội</p>
                    <h2 class="display">Lớp học nhóm<em class="outline">tại Pulse Gym</em></h2>
                </div>
                <p class="head-note">Khám phá các lớp Yoga, Zumba, Boxing, Spinning RPM và BodyPump sôi động dưới sự dẫn dắt của HLV chuyên nghiệp. Đặt chỗ trước để đảm bảo vị trí tập tốt nhất.</p>
            </div>
            
            <div class="classes-grid">
                @if (groupClasses.Any())
                {
                    foreach (var c in groupClasses)
                    {
                        var confirmedCount = c.ClassBookings?.Count(b => b.Status == "Confirmed") ?? c.CurrentCapacity;
                        var maxCap = c.MaxCapacity > 0 ? c.MaxCapacity : 20;
                        var available = Math.Max(0, maxCap - confirmedCount);
                        var isFull = available <= 0 || c.Status == "Full";
                        var percent = (int)Math.Min(100, Math.Round((double)confirmedCount / maxCap * 100));
                        var imgUrl = WebGym.Areas.Member.Controllers.ClassBookingController.ResolveClassImage(c.ImageUrl, c.ClassName);
                        var isAuth = User.Identity != null && User.Identity.IsAuthenticated;
                        var isMember = isAuth && User.IsInRole("Member");
                        var bookingUrl = isMember ? Url.Action("Index", "ClassBooking", new { area = "Member" }) : Url.Action("Index", "Profile", new { area = "Member" });

                        var trainerAvatar = WebGym.Areas.Member.Controllers.ClassBookingController.ResolveAvatar(c.Trainer?.AvatarUrl, c.TrainerId, c.Trainer?.UserId ?? 0);

                        <article class="class-card-home">
                            <div class="class-card-home-img">
                                <img src="@imgUrl" alt="@c.ClassName" loading="lazy" />
                                
                                <div class="bento-badges-row">
                                    <span class="bento-room-badge">
                                        <i class="bi bi-geo-alt-fill text-lime"></i>@(c.Room?.RoomName ?? "Studio Trung Tâm")
                                    </span>
                                    <span class="bento-slot-badge @(isFull ? "slot-full" : "slot-open")">
                                        @if (!isFull)
                                        {
                                            <span class="slot-dot"></span>
                                            <span>Còn @available slot</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-lock-fill"></i>
                                            <span>Đã đầy sĩ số</span>
                                        }
                                    </span>
                                </div>
                            </div>

                            <div class="class-card-home-content">
                                <span class="bento-category-tag">PULSE GROUP FITNESS</span>
                                <h3 class="class-home-title">@c.ClassName</h3>
                                <p class="class-home-desc">@(c.Description ?? "Lớp tập nhóm bùng nổ năng lượng tại Pulse Gym.")</p>
                                
                                <div class="bento-widgets-group">
                                    <!-- Widget Lịch học -->
                                    <div class="bento-info-box">
                                        <div class="bento-info-icon">
                                            <i class="bi bi-clock-history"></i>
                                        </div>
                                        <div class="bento-info-text">
                                            <span class="info-label">LỊCH HỌC TRONG TUẦN</span>
                                            <span class="info-value">@c.Schedule</span>
                                        </div>
                                    </div>

                                    <!-- Widget HLV -->
                                    <div class="bento-coach-box">
                                        <img src="@trainerAvatar" alt="@(c.Trainer?.User?.FullName ?? "HLV")" class="bento-coach-avatar" onerror="this.onerror=null; this.src='/images/coach1.jpg';" />
                                        <div class="bento-coach-info">
                                            <span class="info-label">HLV HƯỚNG DẪN</span>
                                            <span class="coach-name">@(c.Trainer?.User?.FullName ?? "HLV Pulse Gym")</span>
                                        </div>
                                        <span class="coach-role-pill">MASTER COACH</span>
                                    </div>
                                </div>

                                <div class="bento-capacity-wrap">
                                    <div class="bento-capacity-meta">
                                        <span>Sĩ số: <strong>@confirmedCount</strong>/@maxCap học viên</span>
                                        <span class="@(isFull ? "text-danger" : "text-lime") fw-semibold">
                                            @(isFull ? "Đã kín chỗ" : $"{percent}% lấp đầy")
                                        </span>
                                    </div>
                                    <div class="bento-progress-track">
                                        <div class="bento-progress-bar @(isFull ? "bar-full" : "bar-open")" style="width: @percent%;"></div>
                                    </div>
                                </div>

                                @if (isFull)
                                {
                                    <button type="button" class="bento-btn-action btn-full" disabled style="cursor: not-allowed; opacity: 0.65; pointer-events: none;">
                                        <span>Lớp học đã hết chỗ</span>
                                        <i class="bi bi-slash-circle"></i>
                                    </button>
                                }
                                else if (isMember)
                                {
                                    <a href="@bookingUrl" class="bento-btn-action btn-register">
                                        <span>Đăng ký tham gia ngay</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                }
                                else if (isAuth)
                                {
                                    <a href="@Url.Action("Index", "Home")" class="bento-btn-action btn-full">
                                        <span>Dành cho Hội Viên Pulse</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                }
                                else
                                {
                                    <a href="#lop-nhom" data-auth-login class="bento-btn-action btn-register">
                                        <span>Đăng nhập để đăng ký</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                }
                            </div>
                        </article>
                    }
                }
            </div>
        </section>

        <!-- CÔNG CỤ BMI / TDEE -->
        <section id="suc-khoe" class="section">
            <div class="head">
                <div>
                    <p class="eyebrow">Công cụ miễn phí</p>
                    <h2 class="display">Hiểu cơ thể<em class="outline">chọn đúng gói</em></h2>
                </div>
                <p class="head-note">Nhập vài thông tin cơ bản để biết chỉ số BMI, năng lượng mỗi ngày và nhận gợi ý gói tập phù hợp với tình trạng của bạn.</p>
            </div>

            <div class="bmi">
                <form class="bmi-card" id="bmiForm" novalidate>
                    <h3 class="bmi-title">Thông tin của bạn</h3>
                    <div class="bmi-fields">
                        <div class="bmi-f wide" role="radiogroup" aria-label="Giới tính">
                            <span>Giới tính</span>
                            <div class="bmi-seg">
                                <input type="radio" name="gender" id="g-m" value="m" checked /><label for="g-m">Nam</label>
                                <input type="radio" name="gender" id="g-f" value="f" /><label for="g-f">Nữ</label>
                            </div>
                        </div>
                        <label class="bmi-f">Tuổi
                            <input type="number" id="bmiAge" min="18" max="80" inputmode="numeric" placeholder="25" />
                        </label>
                        <label class="bmi-f">Chiều cao (cm)
                            <input type="number" id="bmiH" min="120" max="220" inputmode="decimal" placeholder="170" />
                        </label>
                        <label class="bmi-f">Cân nặng (kg)
                            <input type="number" id="bmiW" min="30" max="250" step="0.1" inputmode="decimal" placeholder="65" />
                        </label>
                        <label class="bmi-f wide">Mức độ vận động
                            <select id="bmiAct">
                                <option value="1.2">Ít vận động (ngồi nhiều, làm văn phòng)</option>
                                <option value="1.375" selected>Nhẹ (tập 1–3 buổi mỗi tuần)</option>
                                <option value="1.55">Vừa (tập 3–5 buổi mỗi tuần)</option>
                                <option value="1.725">Nhiều (tập 6–7 buổi mỗi tuần)</option>
                                <option value="1.9">Rất nhiều (tập nặng hoặc lao động nặng)</option>
                            </select>
                        </label>
                        <div class="bmi-f wide" role="radiogroup" aria-label="Mục tiêu">
                            <span>Mục tiêu của bạn</span>
                            <div class="bmi-seg">
                                <input type="radio" name="goal" id="go-lose" value="lose" /><label for="go-lose">Giảm mỡ</label>
                                <input type="radio" name="goal" id="go-keep" value="keep" checked /><label for="go-keep">Duy trì</label>
                                <input type="radio" name="goal" id="go-gain" value="gain" /><label for="go-gain">Tăng cơ</label>
                            </div>
                        </div>
                    </div>
                    <p class="bmi-err" id="bmiErr" role="alert"></p>
                    <button type="submit" class="btn">Phân tích cơ thể <b>→</b></button>
                </form>

                <div class="bmi-card bmi-result" id="bmiResult" aria-live="polite">
                    <div class="bmi-empty" id="bmiEmpty">
                        <strong>Kết quả của bạn</strong>
                        <p>Điền thông tin bên cạnh và bấm "Phân tích cơ thể" để xem tình trạng, lời khuyên và gói tập gợi ý.</p>
                    </div>

                    <div id="bmiOut" hidden>
                        <div class="bmi-top">
                            <div class="bmi-val">
                                <small>Chỉ số BMI</small>
                                <strong id="bmiVal">0</strong>
                                <span class="bmi-cat" id="bmiCat"></span>
                            </div>
                            <div class="bmi-scale" aria-hidden="true">
                                <div class="bmi-bar">
                                    <span style="width:20.5%;background:#6f8cff"></span>
                                    <span style="width:20.5%;background:#c8ff2e"></span>
                                    <span style="width:9.1%;background:#ffcf4d"></span>
                                    <span style="width:22.7%;background:#ff9a3d"></span>
                                    <span style="width:27.2%;background:#ff5e5e"></span>
                                    <i class="bmi-mark" id="bmiMark"></i>
                                </div>
                                <div class="bmi-ticks"><span style="left:20.5%">18,5</span><span style="left:40.9%">23</span><span style="left:50%">25</span><span style="left:72.7%">30</span></div>
                            </div>
                        </div>

                        <div class="bmi-nums">
                            <div><small>BMR</small><strong id="bmiBmr">0</strong><em>kcal / ngày nghỉ</em></div>
                            <div><small>TDEE</small><strong id="bmiTdee">0</strong><em>kcal / ngày duy trì</em></div>
                            <div><small>Mục tiêu</small><strong id="bmiTarget">0</strong><em>kcal / ngày</em></div>
                            <div><small>Protein</small><strong id="bmiProtein">0</strong><em>gram / ngày</em></div>
                        </div>

                        <h4 class="bmi-sub">Tình trạng</h4>
                        <p class="bmi-status" id="bmiStatus"></p>
                        <p class="bmi-range" id="bmiRange"></p>
                        <p class="bmi-note" id="bmiNote" hidden></p>

                        <h4 class="bmi-sub">Lời khuyên cho bạn</h4>
                        <ul class="check" id="bmiTips"></ul>

                        <h4 class="bmi-sub">Khu vực nên tập</h4>
                        <ul class="chips" id="bmiAreas"></ul>

                        <div class="bmi-plan" id="bmiPlan" hidden></div>
                        <p class="bmi-disc">Kết quả chỉ mang tính tham khảo, không thay thế tư vấn của bác sĩ hoặc chuyên gia dinh dưỡng. BMI phân loại theo chuẩn Châu Á – Thái Bình Dương.</p>
                    </div>
                </div>
            </div>
            <script type="application/json" id="bmiConfig">@Html.Raw(bmiJson)</script>
        </section>

        <!-- TRAINERS -->
        <section id="huan-luyen-vien" class="section section-alt">
            <div class="head">
                <div>
                    <p class="eyebrow">Đội ngũ chuyên gia</p>
                    <h2 class="display">Người dẫn lối<em class="outline">đến thành công</em></h2>
                </div>
                <p class="head-note">Không chỉ là huấn luyện viên. Họ là những người truyền cảm hứng, đồng hành và giúp bạn vượt qua mọi giới hạn.</p>
            </div>
            <div class="trainers">
                @if (trainers.Any())
                {
                    foreach (var t in trainers)
                    {
                        var info = WebGym.Models.TrainerInfo.FromTrainer(t);
                        var rawImg = (info.Image ?? "").Replace("~/images/", "").Replace("/images/", "");
                        var imgSrc = rawImg.StartsWith("http") ? rawImg : Url.Content("~/images/" + rawImg);
                        if (imgSrc.Contains("w=300")) { imgSrc = imgSrc.Replace("w=300", "w=800"); }
                        <article class="trainer-card">
                            <a asp-controller="Home" asp-action="TrainerDetail" asp-route-id="@t.TrainerId" class="trainer">
                                <div class="photo">
                                    <img src="@imgSrc" asp-append-version="true" alt="@info.FullName" />
                                    <span class="tag">@info.Badge</span>
                                </div>
                                <div class="trainer-info">
                                    <div>
                                        <h3>@info.FullName</h3>
                                        <small>@info.Role</small>
                                    </div>
                                    <span class="arrow-circle">↗</span>
                                </div>
                            </a>
                        </article>
                    }
                }
            </div>
        </section>

        <!-- PRICING -->
        <section id="bang-gia" class="section pricing">
            <p class="eyebrow center">Đầu tư cho chính bạn</p>
            <h2 class="display center">Chọn gói.<em class="outline">Bắt đầu thay đổi.</em></h2>
            <div class="plans">
                @if (packages.Any())
                {
                    foreach (var pkg in packages)
                    {
                        var plan = WebGym.Models.PlanInfo.FromGymPackage(pkg);
                        var isHot = pkg.PackageId == 2;
                        var durationLabel = pkg.DurationDays >= 365 ? "1 năm" : (pkg.DurationDays % 30 == 0 ? $"{pkg.DurationDays / 30} tháng" : $"{pkg.DurationDays} ngày");
                        <article class="plan @(isHot ? "plan-hot" : "")">
                            @if (isHot)
                            {
                                <span class="badge">Phổ biến nhất</span>
                            }
                            <h3>@pkg.PackageName</h3>
                            <p class="price"><strong>@pkg.Price.ToString("N0")</strong><span><b>VNĐ</b>/ @durationLabel</span></p>
                            <p class="plan-desc">@pkg.Description</p>
                            @{
                                var isAuth = User.Identity != null && User.Identity.IsAuthenticated;
                                var checkoutUrl = Url.Action("Index", "Checkout", new { slug = pkg.PackageId });
                            }
                            @if (isAuth)
                            {
                                <a href="@checkoutUrl" class="btn @(isHot ? "" : "btn-ghost")">Đăng ký ngay <b>→</b></a>
                            }
                            else
                            {
                                <a href="@checkoutUrl" data-auth-checkout="@checkoutUrl" class="btn @(isHot ? "" : "btn-ghost")">Đăng ký ngay <b>→</b></a>
                            }
                            <ul>
                                @foreach (var feat in plan.Features)
                                {
                                    <li>@feat</li>
                                }
                            </ul>
                        </article>
                    }
                }
            </div>
            <p class="fine">Không phí ẩn • Hủy bất cứ lúc nào • Trải nghiệm 7 ngày miễn phí</p>
        </section>

        <!-- CTA -->
        <section class="cta">
            <div>
