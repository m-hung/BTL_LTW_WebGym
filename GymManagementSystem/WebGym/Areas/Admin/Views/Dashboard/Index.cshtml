@model WebGym.Models.DTOs.Admin.DashboardStatsDto
@{
    ViewData["Title"] = "Dashboard Tổng Quan";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-grid-1x2-fill text-primary me-2"></i>Dashboard Tổng Quan Hệ Thống
        </h3>
        <p class="text-muted small mb-0">Theo dõi toàn diện doanh thu thẻ tập, bán hàng Shop/POS, vận hành lớp học, thiết bị và kho hàng theo thời gian thực.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="OrderManagement" asp-action="POS" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-calculator me-1"></i> Mở Quầy POS
        </a>
        <a asp-controller="Report" asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Báo Cáo Hợp Nhất
        </a>
        <span class="badge bg-white text-secondary border px-3 py-2 rounded-3 shadow-sm">
            <i class="bi bi-calendar-event me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
        </span>
    </div>
</div>

<!-- ROW 1: 4 Key Stat Cards (Hội viên & Thẻ tập) -->
<div class="row g-3 mb-3">
    <!-- Card 1: Doanh thu Gói tập tháng -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold">DOANH THU GÓI TẬP (THÁNG)</span>
                    <h3 class="fw-bold text-dark mt-2 mb-1">@Model.TotalRevenueThisMonth.ToString("N0") <small class="fs-6 text-muted">đ</small></h3>
                    <small class="text-success fw-semibold">
                        <i class="bi bi-check-circle me-1"></i>Tích lũy: @Model.TotalRevenueOverall.ToString("N0") đ
                    </small>
                </div>
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center flex-shrink-0" 
                     style="background: linear-gradient(135deg, #10b981, #059669); color: white; width: 50px; height: 50px;">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Tổng hội viên -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold">TỔNG SỐ HỘI VIÊN</span>
                    <h3 class="fw-bold text-dark mt-2 mb-1">@Model.TotalMembers</h3>
                    <small class="text-primary fw-semibold">
                        <i class="bi bi-person-check-fill me-1"></i>@Model.TotalActiveSubscriptions gói đang hoạt động
                    </small>
                </div>
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center flex-shrink-0" 
                     style="background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; width: 50px; height: 50px;">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Huấn luyện viên -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold">HUẤN LUYỆN VIÊN (PT)</span>
                    <h3 class="fw-bold text-dark mt-2 mb-1">@Model.TotalTrainers</h3>
                    <small class="text-muted">
                        <i class="bi bi-patch-check-fill text-warning me-1"></i>Chứng chỉ chuyên môn
                    </small>
                </div>
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center flex-shrink-0" 
                     style="background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: white; width: 50px; height: 50px;">
                    <i class="bi bi-person-workspace fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Lịch tập PT -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold">LỊCH TẬP PT HOẠT ĐỘNG</span>
                    <h3 class="fw-bold text-dark mt-2 mb-1">@Model.TotalActiveBookings</h3>
                    <small class="text-warning fw-semibold">
                        <i class="bi bi-calendar2-check me-1"></i>Chờ duyệt hoặc đã duyệt
                    </small>
                </div>
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center flex-shrink-0" 
                     style="background: linear-gradient(135deg, #f59e0b, #d97706); color: white; width: 50px; height: 50px;">
                    <i class="bi bi-calendar2-check-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ROW 2: 4 WIDGET MỚI (SHOP, LỚP HỌC, THIẾT BỊ HỎNG, TỒN KHO) -->
<div class="row g-3 mb-4">
    <!-- Widget 1: Doanh thu Bán hàng Shop -->
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="OrderManagement" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small fw-semibold">DOANH THU BÁN HÀNG SHOP</span>
                        <h3 class="fw-bold text-info mt-2 mb-1">@Model.ShopRevenueThisMonth.ToString("N0") <small class="fs-6 text-muted">đ</small></h3>
                        <small class="text-muted d-block">
                            <i class="bi bi-bag-check-fill text-info me-1"></i>Tháng này: <strong>@Model.ShopOrdersThisMonth đơn</strong>
                        </small>
                        <small class="text-success fw-semibold">
                            Tổng tích lũy: @Model.ShopRevenueOverall.ToString("N0") đ (@Model.ShopOrdersOverall đơn)
                        </small>
                    </div>
                    <div class="rounded-4 p-2 d-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info flex-shrink-0" style="width: 46px; height: 46px;">
                        <i class="bi bi-shop fs-4"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Widget 2: Tỷ lệ lấp đầy Lớp học -->
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="ClassManagement" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="text-muted small fw-semibold">TỶ LỆ LẤP ĐẦY LỚP NHÓM</span>
                        <h3 class="fw-bold text-primary mt-2 mb-0">@Model.ClassFillRatePercent%</h3>
                    </div>
                    <div class="rounded-4 p-2 d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary flex-shrink-0" style="width: 46px; height: 46px;">
                        <i class="bi bi-person-video3 fs-4"></i>
                    </div>
                </div>
                <div class="progress rounded-pill mb-2" style="height: 7px;">
                    <div class="progress-bar bg-primary rounded-pill" role="progressbar" style="width: @(Math.Min(100, Model.ClassFillRatePercent))%" aria-valuenow="@Model.ClassFillRatePercent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <small class="text-muted">
                    <i class="bi bi-people me-1"></i>Đã đặt <strong>@Model.BookedClassSlots / @Model.TotalClassSlots</strong> chỗ (@Model.ActiveClassesCount lớp mở)
                </small>
            </div>
        </a>
    </div>

    <!-- Widget 3: Cảnh báo thiết bị hỏng -->
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="EquipmentManagement" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 border-start border-4 @(Model.AlertEquipmentTotal > 0 ? "border-danger" : "border-success")">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small fw-semibold">CẢNH BÁO THIẾT BỊ HỎNG</span>
                        <h3 class="fw-bold @(Model.AlertEquipmentTotal > 0 ? "text-danger" : "text-success") mt-2 mb-1">
                            @Model.AlertEquipmentTotal <small class="fs-6 text-muted">máy</small>
                        </h3>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            <span class="badge bg-danger bg-opacity-15 text-danger rounded-pill">
                                <i class="bi bi-x-octagon me-1"></i>@Model.BrokenEquipmentCount đang hỏng
                            </span>
                            <span class="badge bg-warning bg-opacity-20 text-dark rounded-pill">
                                <i class="bi bi-tools me-1"></i>@Model.NeedsMaintenanceEquipmentCount cần bảo trì
                            </span>
                        </div>
                    </div>
                    <div class="rounded-4 p-2 d-flex align-items-center justify-content-center @(Model.AlertEquipmentTotal > 0 ? "bg-danger bg-opacity-10 text-danger" : "bg-success bg-opacity-10 text-success") flex-shrink-0" style="width: 46px; height: 46px;">
                        <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Widget 4: Cảnh báo hàng tồn kho (< 5 cái) -->
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="ProductManagement" asp-action="Index" asp-route-stockFilter="low" class="text-decoration-none">
            <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 border-start border-4 @(Model.AlertProductsTotal > 0 ? "border-warning" : "border-success")">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small fw-semibold">CẢNH BÁO HÀNG TỒN KHO</span>
                        <h3 class="fw-bold @(Model.AlertProductsTotal > 0 ? "text-warning" : "text-success") mt-2 mb-1">
                            @Model.AlertProductsTotal <small class="fs-6 text-muted">mặt hàng</small>
                        </h3>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            <span class="badge bg-danger bg-opacity-15 text-danger rounded-pill">
                                <i class="bi bi-x-circle me-1"></i>@Model.OutOfStockProductsCount hết hàng
                            </span>
                            <span class="badge bg-warning bg-opacity-25 text-dark rounded-pill">
                                <i class="bi bi-exclamation-triangle me-1"></i>@Model.LowStockProductsCount sắp hết (&lt; 5)
                            </span>
                        </div>
                    </div>
                    <div class="rounded-4 p-2 d-flex align-items-center justify-content-center @(Model.AlertProductsTotal > 0 ? "bg-warning bg-opacity-15 text-warning" : "bg-success bg-opacity-10 text-success") flex-shrink-0" style="width: 46px; height: 46px;">
                        <i class="bi bi-box-seam-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Revenue Trend Chart (Song song Gói tập vs Shop POS) -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-0">Đối Sánh Doanh Thu: Thẻ Tập vs Cửa Hàng Shop (6 Tháng)</h5>
                    <small class="text-muted">Thống kê song song tiền thẻ hội viên và doanh số bán lẻ POS / Shop</small>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                        Thẻ tập: @Model.TotalRevenueOverall.ToString("N0") đ
                    </span>
                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">
                        Shop POS: @Model.ShopRevenueOverall.ToString("N0") đ
                    </span>
                </div>
            </div>
            <div style="position: relative; height: 290px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Package Distribution Chart -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4 h-100">
            <div class="mb-3">
                <h5 class="fw-bold text-dark mb-0">Tỷ Trọng Gói Tập</h5>
                <small class="text-muted">Phân bổ hội viên theo các gói</small>
            </div>
            <div style="position: relative; height: 245px;" class="d-flex align-items-center justify-content-center">
                <canvas id="packageChart"></canvas>
            </div>
            <div class="mt-3 pt-2 border-top text-center small text-muted">
                <i class="bi bi-info-circle me-1"></i> Dựa trên các hợp đồng Subscription đã tạo
            </div>
        </div>
    </div>
</div>

<!-- Recent Activities: Bookings, Payments & Shop Orders -->
<div class="row g-4 mb-4">
    <!-- Recent Bookings -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-calendar-event text-warning me-2"></i>Lịch Đặt PT Gần Nhất
                </h5>
                <a asp-controller="BookingManagement" asp-action="Index" class="btn btn-light btn-sm rounded-3 border">
                    Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Hội Viên</th>
                            <th>HLV</th>
                            <th>Ngày &amp; Giờ</th>
                            <th>Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentBookings.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Chưa có lịch đặt nào.</td>
                            </tr>
                        }
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">@b.MemberName</td>
                                <td>@b.TrainerName</td>
                                <td>
                                    <div class="small fw-semibold">@b.BookingDate.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@b.TimeSlot</small>
                                </td>
                                <td>
                                    @if (b.Status == "Approved")
                                    {
                                        <span class="badge badge-soft-success">Đã duyệt</span>
                                    }
                                    else if (b.Status == "Pending")
                                    {
                                        <span class="badge badge-soft-warning">Chờ duyệt</span>
                                    }
                                    else if (b.Status == "Completed")
                                    {
                                        <span class="badge badge-soft-primary">Hoàn thành</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-secondary">@b.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Payments -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-wallet2 text-success me-2"></i>Thanh Toán Gói Tập Mới Nhất
                </h5>
                <a asp-controller="Report" asp-action="Index" class="btn btn-light btn-sm rounded-3 border">
                    Chi tiết báo cáo <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Khách Hàng</th>
                            <th>Gói Tập</th>
                            <th>Số Tiền</th>
                            <th>Hình Thức</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentPayments.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Chưa có thanh toán nào.</td>
                            </tr>
                        }
                        @foreach (var p in Model.RecentPayments)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">@p.MemberName</div>
                                    <small class="text-muted">@p.PaymentDate.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@p.PackageName</span>
                                </td>
                                <td class="fw-bold text-success">
                                    +@p.Amount.ToString("N0") đ
                                </td>
                                <td>
                                    <span class="badge badge-soft-info">@p.PaymentMethod</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Recent Shop / POS Orders -->
<div class="card border-0 rounded-4 bg-white shadow-sm p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-bag-check-fill text-info me-2"></i>Đơn Hàng Bán Lẻ Shop / POS Gần Nhất
        </h5>
        <a asp-controller="OrderManagement" asp-action="Index" class="btn btn-light btn-sm rounded-3 border">
            Quản lý đơn hàng <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã Đơn</th>
                    <th>Khách Hàng</th>
                    <th>Số Lượng</th>
                    <th>Ngày Mua</th>
                    <th>Thanh Toán</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentShopOrders.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-3">Chưa có đơn hàng Shop nào.</td>
                    </tr>
                }
                @foreach (var o in Model.RecentShopOrders)
                {
                    <tr>
                        <td>
                            <a asp-controller="OrderManagement" asp-action="Details" asp-route-id="@o.OrderId" class="fw-bold text-primary text-decoration-none">
                                #OD-@o.OrderId.ToString("D4")
                            </a>
                        </td>
                        <td class="fw-semibold text-dark">@o.CustomerName</td>
                        <td><span class="badge bg-light text-dark border">@o.ItemCount món</span></td>
                        <td class="small text-muted">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge badge-soft-info">@o.PaymentMethod</span></td>
                        <td class="fw-bold text-success">+@o.TotalAmount.ToString("N0") đ</td>
                        <td>
                            <span class="badge @(o.Status == "Hoàn thành" || o.Status == "Đã thanh toán" ? "badge-soft-success" : (o.Status == "Đã hủy" ? "badge-soft-danger" : "badge-soft-warning"))">
                                @o.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Dual Bar Chart: So sánh Doanh thu Thẻ tập vs Shop POS (6 tháng)
        const revLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueChart.Select(x => x.MonthLabel)));
        const pkgRevData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueChart.Select(x => x.PackageRevenue)));
        const shopRevData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueChart.Select(x => x.ShopRevenue)));

        const ctxRev = document.getElementById('revenueChart').getContext('2d');

        new Chart(ctxRev, {
            type: 'bar',
            data: {
                labels: revLabels,
                datasets: [
                    {
                        label: 'Tiền Thẻ Tập (Payments)',
                        data: pkgRevData,
                        backgroundColor: '#2563eb',
                        borderRadius: 6
                    },
                    {
                        label: 'Bán Hàng Shop & POS (Orders)',
                        data: shopRevData,
                        backgroundColor: '#06b6d4',
                        borderRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { boxWidth: 12, padding: 15 }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' + new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.raw);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return (value / 1000000) + ' Tr';
                            }
                        },
                        grid: { color: '#f1f5f9' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // 2. Doughnut Chart: Phân bổ gói tập
        const pkgLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PackageDistributionChart.Select(x => x.PackageName)));
        const pkgData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PackageDistributionChart.Select(x => x.Count)));

        const ctxPkg = document.getElementById('packageChart').getContext('2d');
        new Chart(ctxPkg, {
            type: 'doughnut',
            data: {
                labels: pkgLabels,
                datasets: [{
                    data: pkgData,
                    backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 12, padding: 10, font: { size: 11 } }
                    }
                },
                cutout: '65%'
            }
        });
    </script>
}
