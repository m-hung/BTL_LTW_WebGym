@model WebGym.Models.DTOs.Admin.RoomFormViewModel
@{
    ViewData["Title"] = "Thêm Phòng Tập / Studio Mới";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <!-- Breadcrumb & Back -->
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-muted small">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách phòng tập
            </a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm bg-white">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary">
                        <i class="bi bi-door-open-fill fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Thêm Phòng Tập / Studio Mới</h4>
                        <p class="text-muted small mb-0">Nhập đầy đủ thông tin vị trí, sức chứa và công năng của phòng.</p>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="RoomName" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="RoomName" class="form-control rounded-3" placeholder="Ví dụ: Studio Yoga & Pilates Tầng 3" />
                            <span asp-validation-for="RoomName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Status" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Status" class="form-select rounded-3">
                                <option value="Hoạt động">Hoạt động</option>
                                <option value="Bảo trì">Đang bảo trì / Sửa chữa</option>
                                <option value="Tạm đóng">Tạm đóng</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-7">
                            <label asp-for="Location" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="Location" class="form-control rounded-3" placeholder="Ví dụ: Tầng 3 - Cánh Trái" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Capacity" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <input asp-for="Capacity" type="number" class="form-control rounded-start-3" min="1" max="500" />
                                <span class="input-group-text bg-light text-muted">người</span>
                            </div>
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="4" 
                                      placeholder="Mô tả công năng phòng, diện tích (m2), trang bị cách âm, gương, thảm tập..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 px-4">Hủy</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Lưu Phòng Tập
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

