@model IEnumerable<WebGym.Models.Entities.GymClass>
@{
    ViewData["Title"] = "Quản Lý Lớp Học Nhóm";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-person-video3 text-primary me-2"></i>Quản Lý Lớp Học Nhóm (Group Classes)
        </h3>
        <p class="text-muted small mb-0">Quản lý các lớp Yoga, Zumba, HIIT, Spinning, BodyPump, phân công HLV và kiểm soát sĩ số phòng học.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span class="fw-semibold">Tạo Lớp Học Mới</span>
        </a>
        <a asp-controller="ClassBookingManagement" asp-action="Index" class="btn btn-outline-dark d-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm">
            <i class="bi bi-card-checklist"></i>
            <span class="fw-semibold">Điểm Danh Tham Gia Lớp</span>
        </a>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Tổng số lớp học</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@ViewBag.TotalClasses</h3>
                </div>
                <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary">
                    <i class="bi bi-calendar2-week fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Đang mở đăng ký</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@ViewBag.OpenClasses</h3>
                </div>
                <div class="p-3 bg-success bg-opacity-10 rounded-3 text-success">
                    <i class="bi bi-door-open-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Đã đầy sĩ số</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@ViewBag.FullClasses</h3>
                </div>
                <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-warning">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Đã kết thúc / Hủy</span>
                    <h3 class="fw-bold text-secondary mb-0 mt-1">@ViewBag.CompletedClasses</h3>
                </div>
                <div class="p-3 bg-secondary bg-opacity-10 rounded-3 text-secondary">
                    <i class="bi bi-check2-all fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters Card -->
<div class="card border-0 bg-white p-3 mb-4 rounded-4 shadow-sm">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="searchKeyword" class="form-control bg-light border-start-0" 
                       placeholder="Tìm tên lớp hoặc lịch học..." value="@ViewBag.SearchKeyword" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="trainerId" class="form-select bg-light" asp-items="ViewBag.TrainersList">
                <option value="">-- Tất cả HLV đứng lớp --</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="roomId" class="form-select bg-light" asp-items="ViewBag.RoomsList">
                <option value="">-- Tất cả phòng tập --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select bg-light">
                <option value="">-- Trạng thái --</option>
                <option value="Open" selected="@(ViewBag.SelectedStatus == "Open")">Mở đăng ký (Open)</option>
                <option value="Full" selected="@(ViewBag.SelectedStatus == "Full")">Đã đầy (Full)</option>
                <option value="Completed" selected="@(ViewBag.SelectedStatus == "Completed")">Hoàn thành (Completed)</option>
                <option value="Cancelled" selected="@(ViewBag.SelectedStatus == "Cancelled")">Đã hủy (Cancelled)</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-dark w-100 rounded-3" title="Lọc dữ liệu">
                <i class="bi bi-funnel"></i>
            </button>
        </div>
    </form>
</div>

<!-- Classes Grid / Table -->
<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;">Hình ảnh</th>
                    <th>Tên Lớp Học</th>
                    <th>HLV Phụ Trách</th>
                    <th>Phòng Học / Studio</th>
                    <th>Lịch Học (Thứ & Giờ)</th>
                    <th>Sĩ Số (Hiện Tại / Max)</th>
                    <th>Trạng Thái</th>
                    <th class="text-end" style="min-width: 170px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                            Không tìm thấy lớp học nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        var percent = c.MaxCapacity > 0 ? (c.CurrentCapacity * 100 / c.MaxCapacity) : 0;
                        <tr>
                            <td>
                                @{
                                    var resolvedImg = WebGym.Areas.Member.Controllers.ClassBookingController.ResolveClassImage(c.ImageUrl, c.ClassName);
                                }
                                <img src="@resolvedImg" alt="@c.ClassName" class="rounded-3 border object-fit-cover" style="width: 50px; height: 50px;"
                                     onerror="this.onerror=null; this.src='/images/default-class.png';" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-6">@c.ClassName</div>
                                @if (!string.IsNullOrWhiteSpace(c.Description))
                                {
                                    <small class="text-muted text-truncate-1 d-inline-block" style="max-width: 200px;">@c.Description</small>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@c.Trainer.User.FullName</div>
                                <small class="text-muted">@c.Trainer.Specialization</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">
                                    <i class="bi bi-door-open me-1 text-primary"></i>@(c.Room != null ? c.Room.RoomName : "Chưa xếp phòng")
                                </span>
                            </td>
                            <td>
                                <div class="small fw-semibold text-primary">
                                    <i class="bi bi-clock me-1"></i>@c.Schedule
                                </div>
                                @if (c.StartDate.HasValue)
                                {
                                    <small class="text-muted">Từ: @c.StartDate.Value.ToString("dd/MM/yyyy")</small>
                                }
                            </td>
                            <td style="min-width: 140px;">
                                <div class="d-flex justify-content-between small fw-bold mb-1">
                                    <span>@c.CurrentCapacity / @c.MaxCapacity</span>
                                    <span class="text-muted">@percent%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @(percent >= 100 ? "bg-danger" : (percent >= 80 ? "bg-warning" : "bg-success"))" 
                                         role="progressbar" style="width: @percent%"></div>
                                </div>
                            </td>
                            <td>
                                @if (c.Status == "Open")
                                {
                                    <span class="badge badge-soft-success rounded-pill px-3 py-2 small">
                                        <i class="bi bi-check-circle me-1"></i> Mở ĐK
                                    </span>
                                }
                                else if (c.Status == "Full")
                                {
                                    <span class="badge badge-soft-danger rounded-pill px-3 py-2 small">
                                        <i class="bi bi-exclamation-circle me-1"></i> Đã đầy
                                    </span>
                                }
                                else if (c.Status == "Completed")
                                {
                                    <span class="badge badge-soft-secondary rounded-pill px-3 py-2 small">Hoàn thành</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-warning rounded-pill px-3 py-2 small">Đã hủy</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@c.ClassId" 
                                       class="btn btn-sm btn-light border rounded-2" title="Xem danh sách học viên đăng ký">
                                        <i class="bi bi-people-fill text-primary"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.ClassId" 
                                       class="btn btn-sm btn-light border rounded-2" title="Chỉnh sửa thông tin">
                                        <i class="bi bi-pencil-square text-warning"></i>
                                    </a>
                                    <div class="dropdown d-inline">
                                        <button class="btn btn-sm btn-light border rounded-2 dropdown-toggle" type="button" data-bs-toggle="dropdown" title="Đổi trạng thái">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 small">
                                            <li>
                                                <form asp-action="ChangeStatus" asp-route-id="@c.ClassId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="newStatus" value="Open" />
                                                    <button type="submit" class="dropdown-item py-2 text-success">Mở đăng ký (Open)</button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-action="ChangeStatus" asp-route-id="@c.ClassId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="newStatus" value="Full" />
                                                    <button type="submit" class="dropdown-item py-2 text-warning">Đã đầy sĩ số (Full)</button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-action="ChangeStatus" asp-route-id="@c.ClassId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="newStatus" value="Completed" />
                                                    <button type="submit" class="dropdown-item py-2 text-secondary">Hoàn thành khóa (Completed)</button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-action="ChangeStatus" asp-route-id="@c.ClassId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="newStatus" value="Cancelled" />
                                                    <button type="submit" class="dropdown-item py-2 text-danger">Tạm ngưng / Hủy lớp</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                    <form asp-action="Delete" asp-route-id="@c.ClassId" method="post" id="deleteClass-@c.ClassId" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-sm btn-light border rounded-2 text-danger btn-delete-class" 
                                                data-form-id="deleteClass-@c.ClassId"
                                                data-class-name="@c.ClassName"
                                                title="Xóa lớp">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-delete-class').forEach(btn => {
            btn.addEventListener('click', function () {
                const formId = this.getAttribute('data-form-id');
                const className = this.getAttribute('data-class-name') || 'này';
                confirmAction(formId, 'Bạn có chắc muốn xóa lớp "' + className + '"?');
            });
        });
    </script>
}

