@{
    Layout = null;
    ViewData["Title"] = "Pulse Gym - Bứt phá giới hạn";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pulse.css" asp-append-version="true" />
</head>
<body>
    <header class="nav">
        <a href="#top" class="logo"><i class="logo-bars"></i>PULSE <span>GYM</span></a>
        <nav class="nav-links">
            <a href="#chuong-trinh">Chương trình</a>
            <a href="#lich-tap">Lịch tập</a>
            <a href="#huan-luyen-vien">Huấn luyện viên</a>
            <a href="#bang-gia">Bảng giá</a>
        </nav>
        <a href="#bang-gia" class="btn btn-sm">Đăng ký tập thử <b>→</b></a>
    </header>

    <main id="top">
        <!-- HERO -->
        <section class="hero">
            <div class="hero-text">
                <p class="eyebrow">Không viện cớ. Chỉ kết quả.</p>
                <h1 class="display">Bứt phá<em class="outline">giới hạn</em></h1>
                <p class="lead">Đánh thức phiên bản mạnh mẽ nhất của bạn với không gian tập luyện chuẩn quốc tế và đội ngũ huấn luyện viên tận tâm.</p>
                <div class="hero-cta">
                    <a href="#bang-gia" class="btn">Bắt đầu ngay <b>→</b></a>
                    <button type="button" class="play" id="playIntro" aria-haspopup="dialog"><span>▶</span>Khám phá Pulse</button>
                </div>
                <ul class="stats">
                    <li><strong>2.5K<sup>+</sup></strong><span>Hội viên đang tập luyện</span></li>
                    <li><strong>25<sup>+</sup></strong><span>Huấn luyện viên chuyên nghiệp</span></li>
                    <li><strong>12</strong><span>Năm đồng hành cùng thể hình Việt</span></li>
                </ul>
            </div>
            <div class="hero-media">
                <img src="~/images/hero.jpg" alt="Hội viên Pulse Gym đang tập luyện" />
                <div class="chip chip-open"><small><i class="dot"></i>Mở cửa hôm nay</small><strong>05:00 — 23:00</strong></div>
                <div class="chip chip-sat"><span class="arrow-box">↗</span><div><strong>98%</strong><small>Hội viên hài lòng</small></div></div>
            </div>
        </section>

        <!-- MARQUEE -->
        <div class="marquee" aria-hidden="true">
            <div class="marquee-track">
                <span>Train hard</span><i>✦</i><span>Stay strong</span><i>✦</i><span>No excuses</span><i>✦</i><span>Go beyond</span><i>✦</i>
                <span>Train hard</span><i>✦</i><span>Stay strong</span><i>✦</i><span>No excuses</span><i>✦</i><span>Go beyond</span><i>✦</i>
                <span>Train hard</span><i>✦</i><span>Stay strong</span><i>✦</i><span>No excuses</span><i>✦</i><span>Go beyond</span><i>✦</i>
            </div>
        </div>

        <!-- PROGRAMS -->
        <section id="chuong-trinh" class="section">
            <div class="head">
                <div>
                    <p class="eyebrow">Chọn thử thách của bạn</p>
                    <h2 class="display">Tập luyện theo<em class="outline">cách của bạn</em></h2>
                </div>
                <p class="head-note">Từ sức mạnh đến sự linh hoạt, mỗi chương trình đều được thiết kế để đưa bạn tiến gần hơn đến mục tiêu.</p>
            </div>
            <div class="programs">
                <a asp-controller="Home" asp-action="ProgramDetail" asp-route-id="gym" class="program"><img src="~/images/gym.jpg" alt="" /><span class="num">01</span><div><small>Sức mạnh • Hình thể</small><h3>Gym</h3></div><span class="arrow-circle">↗</span></a>
                <a asp-controller="Home" asp-action="ProgramDetail" asp-route-id="hiit" class="program"><img src="~/images/hiit.jpg" alt="" /><span class="num">02</span><div><small>Đốt mỡ • Sức bền</small><h3>HIIT</h3></div><span class="arrow-circle">↗</span></a>
                <a asp-controller="Home" asp-action="ProgramDetail" asp-route-id="boxing" class="program"><img src="~/images/boxing.jpg" alt="" /><span class="num">03</span><div><small>Phản xạ • Bùng nổ</small><h3>Boxing</h3></div><span class="arrow-circle">↗</span></a>
                <a asp-controller="Home" asp-action="ProgramDetail" asp-route-id="yoga" class="program"><img src="~/images/yoga.jpg" alt="" /><span class="num">04</span><div><small>Cân bằng • Linh hoạt</small><h3>Yoga</h3></div><span class="arrow-circle">↗</span></a>
            </div>
        </section>

        <!-- SCHEDULE -->
        <section id="lich-tap" class="section">
            <div class="head">
                <div>
                    <p class="eyebrow">Lịch tập tuần này</p>
                    <h2 class="display">Sắp xếp thời gian<em class="outline">nâng tầm bản thân.</em></h2>
                </div>
                <a href="#" class="link-ul">Xem lịch đầy đủ →</a>
            </div>
            <div class="schedule">
                <div class="tabs" id="tabs"></div>
                <div id="classes"></div>
            </div>
        </section>

        <!-- TRAINERS -->
        <section id="huan-luyen-vien" class="section section-alt">
            <div class="head">
                <div>
                    <p class="eyebrow">Đội ngũ chuyên gia</p>
                    <h2 class="display">Người dẫn lối<em class="outline">đến thành công</em></h2>
                </div>
                <p class="head-note">Không chỉ là huấn luyện viên. Họ là những người truyền cảm hứng, đồng hành và giúp bạn vượt qua mọi giới hạn.</p>
            </div>
            <div class="trainers">
                <a asp-controller="Home" asp-action="TrainerDetail" asp-route-id="alex-tokuda" class="trainer"><div class="photo"><img src="~/images/coach1.jpg" alt="Alex Tokuda" /><span class="tag">10+ năm kinh nghiệm</span></div><div class="trainer-info"><div><h3>Alex Tokuda</h3><small>Strength &amp; Conditioning</small></div><span class="arrow-circle">↗</span></div></a>
                <a asp-controller="Home" asp-action="TrainerDetail" asp-route-id="mina-tran" class="trainer"><div class="photo"><img src="~/images/coach2.jpg" alt="Mina Tran" /><span class="tag">NASM Certified</span></div><div class="trainer-info"><div><h3>Mina Tran</h3><small>HIIT &amp; Functional</small></div><span class="arrow-circle">↗</span></div></a>
                <a asp-controller="Home" asp-action="TrainerDetail" asp-route-id="lil-baby" class="trainer"><div class="photo"><img src="~/images/coach3.jpg" alt="Lil Baby" /><span class="tag">Vô địch toàn quốc</span></div><div class="trainer-info"><div><h3>Lil Baby</h3><small>Boxing Coach</small></div><span class="arrow-circle">↗</span></div></a>
            </div>
        </section>

        <!-- PRICING -->
        <section id="bang-gia" class="section pricing">
            <p class="eyebrow center">Đầu tư cho chính bạn</p>
            <h2 class="display center">Chọn gói.<em class="outline">Bắt đầu thay đổi.</em></h2>
            <div class="billing" id="billing">
                <button class="on" data-mode="month">Hàng tháng</button>
                <button data-mode="year">Hàng năm <b>-20%</b></button>
            </div>
            <div class="plans">
                <article class="plan">
                    <h3>Starter</h3>
                    <p class="price"><strong data-price="590">590</strong><span><b>Nghìn</b>/ tháng</span></p>
                    <p class="plan-desc">Bắt đầu hành trình mạnh mẽ hơn.</p>
                    <a asp-controller="Checkout" asp-action="Index" asp-route-slug="starter" data-plan-link class="btn btn-ghost">Chọn gói Starter <b>→</b></a>
                    <ul><li>Tập không giới hạn</li><li>Phòng tắm &amp; tủ đồ</li><li>Đánh giá thể lực cơ bản</li></ul>
                </article>
                <article class="plan plan-hot">
                    <span class="badge">Phổ biến nhất</span>
                    <h3>Pro</h3>
                    <p class="price"><strong data-price="990">990</strong><span><b>Nghìn</b>/ tháng</span></p>
                    <p class="plan-desc">Lựa chọn tốt nhất để bứt phá.</p>
                    <a asp-controller="Checkout" asp-action="Index" asp-route-slug="pro" data-plan-link class="btn">Chọn gói Pro <b>→</b></a>
                    <ul><li>Tất cả quyền lợi Starter</li><li>Toàn bộ lớp nhóm</li><li>2 buổi PT mỗi tháng</li><li>Theo dõi chỉ số chuyên sâu</li></ul>
                </article>
                <article class="plan">
                    <h3>Elite</h3>
                    <p class="price"><strong data-price="1590">1.590</strong><span><b>Nghìn</b>/ tháng</span></p>
                    <p class="plan-desc">Huấn luyện cá nhân không giới hạn.</p>
                    <a asp-controller="Checkout" asp-action="Index" asp-route-slug="elite" data-plan-link class="btn btn-ghost">Chọn gói Elite <b>→</b></a>
                    <ul><li>Tất cả quyền lợi Pro</li><li>8 buổi PT mỗi tháng</li><li>Giáo án dinh dưỡng</li><li>Khu vực phục hồi riêng</li></ul>
                </article>
            </div>
            <p class="fine">Không phí ẩn • Hủy bất cứ lúc nào • Trải nghiệm 7 ngày miễn phí</p>
        </section>

        <!-- CTA -->
        <section class="cta">
            <div>
                <p class="eyebrow dark">Sẵn sàng chưa?</p>
                <h2 class="display">Hôm nay là ngày<em class="outline dark">để bắt đầu.</em></h2>
            </div>
            <a href="#" class="btn btn-dark">Nhận 7 ngày miễn phí <b>→</b></a>
            <span class="cta-watermark" aria-hidden="true">PULSE</span>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-grid">
            <div>
                <a href="#top" class="logo"><i class="logo-bars"></i>PULSE <span>GYM</span></a>
                <p class="foot-note">Tập mạnh hơn. Sống chất hơn.<br />Bứt phá giới hạn mỗi ngày.</p>
                <div class="social"><a href="#">IG</a><a href="#">FB</a><a href="#">YT</a><a href="#">TK</a></div>
            </div>
            <div><h4>Khám phá</h4><a href="#chuong-trinh">Chương trình</a><a href="#lich-tap">Lịch tập</a><a href="#huan-luyen-vien">Huấn luyện viên</a><a href="#bang-gia">Bảng giá</a></div>
            <div><h4>Hỗ trợ</h4><a href="#">Về chúng tôi</a><a href="#">Câu hỏi thường gặp</a><a href="#">Liên hệ</a><a href="#">Tuyển dụng</a></div>
            <div>
                <h4 class="news-title">Năng lượng mới<br />trong hộp thư.</h4>
                <p class="foot-note">Nhận bí quyết tập luyện, dinh dưỡng và ưu đãi mới nhất.</p>
                <form class="news" onsubmit="return false"><input type="email" placeholder="Email của bạn" aria-label="Email" /><button aria-label="Đăng ký">→</button></form>
                <div class="stores"><a href="#"><small>Tải trên</small>App Store</a><a href="#"><small>Tải trên</small>Google Play</a></div>
            </div>
        </div>
        <div class="footer-bottom"><span>© 2025 Pulse Gym. All rights reserved.</span><span><a href="#">Quyền riêng tư</a><a href="#">Điều khoản</a></span><span>Made for the strong</span></div>
    </footer>

    <!-- VIDEO GIỚI THIỆU -->
    <div class="video-modal" id="videoModal" role="dialog" aria-modal="true" aria-label="Video giới thiệu Pulse Gym">
        <div class="video-backdrop" data-close></div>
        <div class="video-box">
            <button type="button" class="video-close" data-close aria-label="Đóng video">✕</button>
            <video id="introVideo" controls playsinline preload="none" poster="~/images/hero.jpg">
                <source src="~/videos/intro.mp4" type="video/mp4" />
                Trình duyệt của bạn không hỗ trợ phát video.
            </video>
            <p class="video-error" id="videoError">Chưa tìm thấy video. Hãy đặt file intro.mp4 vào wwwroot/videos/.</p>
        </div>
    </div>

    <script src="~/js/pulse.js" asp-append-version="true"></script>
</body>
</html>
