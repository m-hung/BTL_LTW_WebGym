@model WebGym.Models.DTOs.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-lg rounded-4 p-4">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus-fill text-warning fs-1"></i>
                <h3 class="fw-bold mt-2">Tạo Tài Khoản Mới</h3>
                <p class="text-muted small">Trở thành hội viên hoặc huấn luyện viên của WebGym</p>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold"></label>
                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="user@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="0987654321" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-check mb-4 p-3 bg-light rounded-3">
                    <input asp-for="RegisterAsTrainer" class="form-check-input" />
                    <label asp-for="RegisterAsTrainer" class="form-check-label fw-semibold"></label>
                    <div class="text-muted small">Tích chọn nếu bạn muốn nộp hồ sơ trở thành Huấn luyện viên (PT)</div>
                </div>

                <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mb-3">Đăng Ký Ngay</button>
            </form>

            <div class="text-center border-top pt-3">
                <span class="text-muted small">Đã có tài khoản?</span>
                <a asp-action="Login" class="fw-bold text-decoration-none">Đăng nhập tại đây</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
