@model IEnumerable<WebGym.Models.Entities.MaintenanceLog>
@{
    ViewData["Title"] = "Nhật Ký Bảo Trì & Sửa Chữa Thiết Bị";
    var stats = ViewBag.Stats as WebGym.Models.DTOs.Admin.MaintenanceStatsSummary;
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-tools text-primary me-2"></i>Nhật Ký Bảo Trì & Sửa Chữa Thiết Bị
        </h3>
        <p class="text-muted small mb-0">Theo dõi phiếu sửa chữa máy móc hỏng, ghi nhận chi phí bảo trì và quản lý linh kiện thay thế.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span class="fw-semibold">Lập Phiếu Bảo Trì Mới</span>
        </a>
    </div>
</div>

<!-- Stats Row: Total Cost & Maintenance Status -->
@if (stats != null)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Tổng chi phí bảo trì</span>
                        <h4 class="fw-bold text-danger mb-0 mt-1">@stats.TotalCostOverall.ToString("N0") <small class="text-muted fs-6">VNĐ</small></h4>
                    </div>
                    <div class="p-3 bg-danger bg-opacity-10 rounded-3 text-danger">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Chi phí tháng này</span>
                        <h4 class="fw-bold text-primary mb-0 mt-1">@stats.CostThisMonth.ToString("N0") <small class="text-muted fs-6">VNĐ</small></h4>
                    </div>
                    <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary">
                        <i class="bi bi-calendar-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Chi phí quý hiện tại</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">@stats.CostThisQuarter.ToString("N0") <small class="text-muted fs-6">VNĐ</small></h4>
                    </div>
                    <div class="p-3 bg-info bg-opacity-10 rounded-3 text-info">
                        <i class="bi bi-graph-up-arrow fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Phiếu đang xử lý</span>
                        <h4 class="fw-bold text-warning mb-0 mt-1">@stats.PendingLogsCount <small class="text-muted fs-6">phiếu</small></h4>
                    </div>
                    <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-warning">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Filters Card -->
<div class="card border-0 bg-white p-3 mb-4 rounded-4 shadow-sm">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="status" class="form-select bg-light">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Đang bảo dưỡng" selected="@(ViewBag.SelectedStatus == "Đang bảo dưỡng")">Đang bảo dưỡng</option>
                <option value="Chờ linh kiện" selected="@(ViewBag.SelectedStatus == "Chờ linh kiện")">Chờ linh kiện</option>
                <option value="Hoàn thành" selected="@(ViewBag.SelectedStatus == "Hoàn thành")">Hoàn thành</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="equipmentId" class="form-select bg-light" asp-items="ViewBag.EquipmentList">
                <option value="">-- Tất cả thiết bị --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="year" class="form-select bg-light">
                @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 3; y--)
                {
                    <option value="@y" selected="@(ViewBag.SelectedYear == y)">Năm @y</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="month" class="form-select bg-light">
                <option value="">-- Cả năm --</option>
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(ViewBag.SelectedMonth == m)">Tháng @m</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-dark w-100 rounded-3">
                <i class="bi bi-funnel me-1"></i> Lọc
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Đặt lại">
                <i class="bi bi-arrow-clockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Maintenance Logs Table Card -->
<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã Phiếu</th>
                    <th>Ngày Bảo Trì</th>
                    <th>Thiết Bị / Vị Trí</th>
                    <th>Nội Dung Sự Cố & Bảo Dưỡng</th>
                    <th>Chi Phí (VNĐ)</th>
                    <th>Đơn Vị Thực Hiện</th>
                    <th>Trạng Thái</th>
                    <th>Ghi Chú Linh Kiện</th>
                    <th class="text-end">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-clipboard2-check fs-2 d-block mb-2 text-muted"></i>
                            Không có nhật ký bảo trì nào phù hợp với điều kiện lọc.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border fw-bold">#@log.LogId</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@log.MaintenanceDate.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@log.Equipment.EquipmentName</div>
                                <small class="text-muted">
                                    <i class="bi bi-geo-alt me-1"></i>@(log.Equipment.GymRoom != null ? log.Equipment.GymRoom.RoomName : log.Equipment.Area)
                                </small>
                            </td>
                            <td>
                                <span class="text-secondary fw-semibold">@log.Description</span>
                            </td>
                            <td>
                                <span class="fw-bold text-danger">@log.Cost.ToString("N0") <small>đ</small></span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@log.PerformedBy</span>
                            </td>
                            <td>
                                @if (log.Status == "Hoàn thành")
                                {
                                    <span class="badge badge-soft-success rounded-pill px-3 py-2 small">
                                        <i class="bi bi-check-circle me-1"></i> Hoàn thành
                                    </span>
                                }
                                else if (log.Status == "Đang bảo dưỡng")
                                {
                                    <span class="badge badge-soft-warning rounded-pill px-3 py-2 small">
                                        <i class="bi bi-tools me-1"></i> Đang bảo dưỡng
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-danger rounded-pill px-3 py-2 small">
                                        <i class="bi bi-pause-circle me-1"></i> Chờ linh kiện
                                    </span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@(log.Notes ?? "Không có")</small>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@log.LogId" 
                                       class="btn btn-sm btn-light border rounded-2" title="Cập nhật chi phí & trạng thái">
                                        <i class="bi bi-pencil-square text-warning"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@log.LogId" method="post" id="deleteLog-@log.LogId" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-sm btn-light border rounded-2 text-danger" 
                                                onclick="confirmAction('deleteLog-@log.LogId', 'Bạn có chắc muốn xóa phiếu bảo trì #@log.LogId?')"
                                                title="Xóa phiếu">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Monthly Breakdown Grid (Thống kê chi phí theo từng tháng của năm) -->
@if (stats != null && stats.MonthlyCosts.Any())
{
    <div class="card border-0 rounded-4 shadow-sm bg-white p-4">
        <h5 class="fw-bold text-dark mb-3">
            <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Thống Kê Chi Phí Bảo Trì 12 Tháng Năm @ViewBag.SelectedYear
        </h5>
        <div class="row g-2">
            @foreach (var item in stats.MonthlyCosts)
            {
                <div class="col-6 col-md-3 col-xl-2">
                    <div class="p-3 rounded-3 border @(item.Cost > 0 ? "bg-light border-warning" : "bg-white") text-center">
                        <small class="text-muted d-block mb-1">@item.Label</small>
                        <div class="fw-bold @(item.Cost > 0 ? "text-danger" : "text-secondary") fs-6">
                            @item.Cost.ToString("N0") <small>đ</small>
                        </div>
                        <small class="text-muted" style="font-size: 0.75rem;">@item.Count phiếu</small>
                    </div>
                </div>
            }
        </div>
    </div>
}

