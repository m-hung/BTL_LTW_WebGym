@model IEnumerable<WebGym.Models.Entities.Member>
@{
    ViewData["Title"] = "Học Viên Phụ Trách";
    var memberList = Model?.ToList() ?? new List<WebGym.Models.Entities.Member>();
}

<div class="portal-card p-4">
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
        <div>
            <h3 class="portal-title-accent fs-3 mb-0">DANH SÁCH <span>HỌC VIÊN PHỤ TRÁCH</span></h3>
            <div style="color: #a6ada2; font-size: 13.5px;" class="mt-1">
                Theo dõi sát sao thể chất học viên, đo đạc tiến trình định kỳ và xây dựng lộ trình đạt mục tiêu
            </div>
        </div>
        <span class="portal-badge portal-badge-approved">
            Tổng cộng: @memberList.Count học viên
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="color: #cfd5ca !important;">HỌC VIÊN</th>
                    <th style="color: #cfd5ca !important;">THÔNG TIN LIÊN HỆ</th>
                    <th style="color: #cfd5ca !important;">CHỈ SỐ THỂ HÌNH HIỆN TẠI</th>
                    <th style="color: #cfd5ca !important;">GÓI TẬP</th>
                    <th class="text-end" style="color: #cfd5ca !important;">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @if (memberList.Any())
                {
                    foreach (var m in memberList)
                    {
                        var activeSub = m.Subscriptions.OrderByDescending(s => s.StartDate).FirstOrDefault(s => s.Status == "Active");
                        <tr>
                            <td>
                                <div>
                                    <strong class="d-block" style="color: #f2f5ef; font-size: 15px;">@m.User.FullName</strong>
                                    <small style="color: #a6ada2;">Giới tính: @(m.Gender ?? "Chưa rõ")</small>
                                </div>
                            </td>
                            <td>
                                <div style="font-size: 13.5px;">
                                    <span class="d-block" style="color: #dbe0d7;">@m.User.Email</span>
                                    <span style="color: #a6ada2;">@(string.IsNullOrEmpty(m.User.PhoneNumber) ? "Chưa có SĐT" : m.User.PhoneNumber)</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge" style="background: rgba(255,255,255,0.05); border: 1px solid var(--portal-line); color: #f2f5ef; font-size: 13px; padding: 6px 10px;">
                                        @(m.Weight.HasValue ? $"{m.Weight:0.0} kg" : "-- kg")
                                    </span>
                                    <span class="badge" style="background: rgba(248, 194, 145, 0.12); color: #f8c291; border: 1px solid rgba(248, 194, 145, 0.25); font-size: 13px; padding: 6px 10px;">
                                        @(m.BodyFatPercentage.HasValue ? $"{m.BodyFatPercentage:0.0}% mỡ" : "--% mỡ")
                                    </span>
                                </div>
                            </td>
                            <td>
                                @if (activeSub != null)
                                {
                                    <span class="portal-badge portal-badge-approved">
                                        @activeSub.Package.PackageName
                                    </span>
                                }
                                else
                                {
                                    <span class="portal-badge portal-badge-cancelled">
                                        Chưa có gói tập
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="RecordProgress" asp-route-memberId="@m.MemberId" class="btn-pulse-primary btn-sm py-1 px-3" style="font-size: 13px;">
                                        Đo InBody
                                    </a>
                                    <a asp-action="CreatePlan" asp-route-memberId="@m.MemberId" class="btn-pulse-outline btn-sm py-1 px-3" style="font-size: 13px;">
                                        Lên Giáo Án
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="py-4">
                                <h5 class="portal-stat-val fs-5 mt-3" style="color: #b0b7ad;">CHƯA CÓ HỌC VIÊN NÀO</h5>
                                <p class="small mb-0" style="color: #a0a79c;">Học viên khi đặt ca tập và được bạn duyệt sẽ xuất hiện trong danh sách này.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
