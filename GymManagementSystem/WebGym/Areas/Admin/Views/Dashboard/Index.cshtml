@model WebGym.Models.DTOs.Admin.DashboardStatsDto
@{
    ViewData["Title"] = "Dashboard Tổng Quan";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-grid-1x2-fill text-primary me-2"></i>Dashboard Tổng Quan Hệ Thống
        </h3>
        <p class="text-muted small mb-0">Theo dõi toàn diện số liệu hội viên, doanh thu và lịch tập theo thời gian thực.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-white text-secondary border px-3 py-2 rounded-3 shadow-sm">
            <i class="bi bi-calendar-event me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
        </span>
    </div>
</div>

<!-- 4 Key Stat Cards -->
<div class="row g-3 mb-4">
    <!-- Card 1: Doanh thu tháng -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold">DOANH THU THÁNG</span>
                    <h3 class="fw-bold text-dark mt-2 mb-1">@Model.TotalRevenueThisMonth.ToString("N0") <small class="fs-6 text-muted">đ</small></h3>
                    <small class="text-success fw-semibold">
                        <i class="bi bi-check-circle me-1"></i>Đã thanh toán
                    </small>
                </div>
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center" 
                     style="background: linear-gradient(135deg, #10b981, #059669); color: white; width: 52px; height: 52px;">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Tổng hội viên -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold">TỔNG SỐ HỘI VIÊN</span>
                    <h3 class="fw-bold text-dark mt-2 mb-1">@Model.TotalMembers</h3>
                    <small class="text-primary fw-semibold">
                        <i class="bi bi-person-check-fill me-1"></i>@Model.TotalActiveSubscriptions đang hoạt động
                    </small>
                </div>
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center" 
                     style="background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; width: 52px; height: 52px;">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Huấn luyện viên -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold">HUẤN LUYỆN VIÊN (PT)</span>
                    <h3 class="fw-bold text-dark mt-2 mb-1">@Model.TotalTrainers</h3>
                    <small class="text-muted">
                        <i class="bi bi-patch-check-fill text-warning me-1"></i>Chứng chỉ chuyên môn
                    </small>
                </div>
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center" 
                     style="background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: white; width: 52px; height: 52px;">
                    <i class="bi bi-person-workspace fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Lịch tập -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-3 h-100 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold">LỊCH TẬP PT HOẠT ĐỘNG</span>
                    <h3 class="fw-bold text-dark mt-2 mb-1">@Model.TotalActiveBookings</h3>
                    <small class="text-danger fw-semibold">
                        <i class="bi bi-bell-fill me-1"></i>Chờ hoặc đã duyệt
                    </small>
                </div>
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center" 
                     style="background: linear-gradient(135deg, #f59e0b, #d97706); color: white; width: 52px; height: 52px;">
                    <i class="bi bi-calendar2-check-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Revenue Trend Chart -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-0">Biến Động Doanh Thu (6 Tháng Gần Nhất)</h5>
                    <small class="text-muted">Số liệu thực tế từ các đơn hàng thanh toán thành công</small>
                </div>
                <span class="badge bg-light text-dark border">
                    Tổng tích lũy: <strong class="text-success ms-1">@Model.TotalRevenueOverall.ToString("N0") đ</strong>
                </span>
            </div>
            <div style="position: relative; height: 280px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Package Distribution Chart -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4 h-100">
            <div class="mb-3">
                <h5 class="fw-bold text-dark mb-0">Tỷ Trọng Gói Tập</h5>
                <small class="text-muted">Phân bổ hội viên theo các gói</small>
            </div>
            <div style="position: relative; height: 240px;" class="d-flex align-items-center justify-content-center">
                <canvas id="packageChart"></canvas>
            </div>
            <div class="mt-3 pt-2 border-top text-center small text-muted">
                <i class="bi bi-info-circle me-1"></i> Dựa trên các hợp đồng Subscription đã tạo
            </div>
        </div>
    </div>
</div>

<!-- Recent Activities: Bookings & Payments -->
<div class="row g-4">
    <!-- Recent Bookings -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-calendar-event text-warning me-2"></i>Lịch Đặt PT Gần Nhất
                </h5>
                <a asp-controller="BookingManagement" asp-action="Index" class="btn btn-light btn-sm rounded-3 border">
                    Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Hội Viên</th>
                            <th>HLV</th>
                            <th>Ngày & Giờ</th>
                            <th>Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentBookings.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Chưa có lịch đặt nào.</td>
                            </tr>
                        }
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">@b.MemberName</td>
                                <td>@b.TrainerName</td>
                                <td>
                                    <div class="small fw-semibold">@b.BookingDate.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@b.TimeSlot</small>
                                </td>
                                <td>
                                    @if (b.Status == "Approved")
                                    {
                                        <span class="badge badge-soft-success">Đã duyệt</span>
                                    }
                                    else if (b.Status == "Pending")
                                    {
                                        <span class="badge badge-soft-warning">Chờ duyệt</span>
                                    }
                                    else if (b.Status == "Completed")
                                    {
                                        <span class="badge badge-soft-primary">Hoàn thành</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-secondary">@b.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Payments -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 rounded-4 bg-white shadow-sm p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-wallet2 text-success me-2"></i>Thanh Toán Mới Nhất
                </h5>
                <a asp-controller="Report" asp-action="Index" class="btn btn-light btn-sm rounded-3 border">
                    Chi tiết báo cáo <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Khách Hàng</th>
                            <th>Gói Tập</th>
                            <th>Số Tiền</th>
                            <th>Hình Thức</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentPayments.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Chưa có thanh toán nào.</td>
                            </tr>
                        }
                        @foreach (var p in Model.RecentPayments)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">@p.MemberName</div>
                                    <small class="text-muted">@p.PaymentDate.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@p.PackageName</span>
                                </td>
                                <td class="fw-bold text-success">
                                    +@p.Amount.ToString("N0") đ
                                </td>
                                <td>
                                    <span class="badge badge-soft-info">@p.PaymentMethod</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Line Chart: Doanh thu 6 tháng
        const revLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueChart.Select(x => x.MonthLabel)));
        const revData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueChart.Select(x => x.Revenue)));

        const ctxRev = document.getElementById('revenueChart').getContext('2d');
        const gradient = ctxRev.createLinearGradient(0, 0, 0, 250);
        gradient.addColorStop(0, 'rgba(37, 99, 235, 0.35)');
        gradient.addColorStop(1, 'rgba(37, 99, 235, 0.0)');

        new Chart(ctxRev, {
            type: 'line',
            data: {
                labels: revLabels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: revData,
                    borderColor: '#2563eb',
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.35,
                    borderWidth: 3,
                    pointBackgroundColor: '#2563eb',
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.raw);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return (value / 1000000) + ' Tr';
                            }
                        },
                        grid: { color: '#f1f5f9' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // 2. Doughnut Chart: Phân bổ gói tập
        const pkgLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PackageDistributionChart.Select(x => x.PackageName)));
        const pkgData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PackageDistributionChart.Select(x => x.Count)));

        const ctxPkg = document.getElementById('packageChart').getContext('2d');
        new Chart(ctxPkg, {
            type: 'doughnut',
            data: {
                labels: pkgLabels,
                datasets: [{
                    data: pkgData,
                    backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 12, padding: 10, font: { size: 11 } }
                    }
                },
                cutout: '65%'
            }
        });
    </script>
}
