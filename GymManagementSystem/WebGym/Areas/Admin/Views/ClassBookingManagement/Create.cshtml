@model WebGym.Models.DTOs.Admin.ClassBookingCreateViewModel
@{
    ViewData["Title"] = "Thêm Học Viên Vào Lớp Tại Quầy";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-muted small">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách đăng ký
            </a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm bg-white">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary">
                        <i class="bi bi-person-plus-fill fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Đăng Ký Học Viên Vào Lớp (Tại Quầy)</h4>
                        <p class="text-muted small mb-0">Hỗ trợ lễ tân tiếp nhận đăng ký lớp học trực tiếp, ghi danh hội viên vào lớp.</p>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="ClassId" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="ClassId" class="form-select rounded-3" asp-items="ViewBag.ClassesList">
                                <option value="">-- Chọn lớp học nhóm muốn đăng ký --</option>
                            </select>
                            <span asp-validation-for="ClassId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="MemberId" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="MemberId" class="form-select rounded-3" asp-items="ViewBag.MembersList">
                                <option value="">-- Chọn hội viên đăng ký (Họ tên, SĐT, Email) --</option>
                            </select>
                            <span asp-validation-for="MemberId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BookingDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="BookingDate" type="date" class="form-control rounded-3" />
                            <span asp-validation-for="BookingDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Status" class="form-select rounded-3">
                                <option value="Confirmed">Chờ tham gia (Confirmed)</option>
                                <option value="Attended">Đã có mặt điểm danh ngay (Attended)</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Notes" class="form-control rounded-3" rows="3" 
                                      placeholder="Ghi chú: Đăng ký trực tiếp tại quầy lễ tân, tập thử 1 buổi, mang thảm cá nhân..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 px-4">Hủy</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Xác Nhận Đăng Ký
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

