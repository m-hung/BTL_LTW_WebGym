@{
    ViewData["Title"] = "Về Chúng Tôi";
}

<div class="text-center mb-5">
    <h1 class="fw-bold">Về Pulse Gym &amp; Fitness Center</h1>
    <p class="text-muted">Hệ thống phòng tập hiện đại kết hợp huấn luyện viên chuyên nghiệp và giáo án AI cá nhân hóa</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 text-center">
                <i class="bi bi-trophy fs-1 text-warning mb-3"></i>
                <h5 class="fw-bold">Sứ Mệnh</h5>
                <p class="text-muted mb-0">Đồng hành cùng từng hội viên xây dựng vóc dáng khỏe mạnh, nâng cao thể lực và duy trì thói quen vận động bền vững.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 text-center">
                <i class="bi bi-people fs-1 text-primary mb-3"></i>
                <h5 class="fw-bold">Đội Ngũ HLV</h5>
                <p class="text-muted mb-0">Hội tụ các HLV cá nhân 1-1 giàu kinh nghiệm cùng đội ngũ HLV lớp học nhóm Yoga, Spinning, BodyPump, Kickfit và Pilates.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 text-center">
                <i class="bi bi-cpu fs-1 text-success mb-3"></i>
                <h5 class="fw-bold">Công Nghệ Thông Minh</h5>
                <p class="text-muted mb-0">Check-in mã QR nhanh chóng, theo dõi chỉ số InBody định kỳ và lập giáo án luyện tập AI có PT chuyên môn kiểm duyệt.</p>
            </div>
        </div>
    </div>
</div>
