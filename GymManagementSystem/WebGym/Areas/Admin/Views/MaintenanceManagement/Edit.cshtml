@model WebGym.Models.DTOs.Admin.MaintenanceLogFormViewModel
@{
    ViewData["Title"] = $"Chỉnh Sửa Phiếu Bảo Trì #{Model.LogId}";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-muted small">
                <i class="bi bi-arrow-left me-1"></i> Quay lại nhật ký bảo trì
            </a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm bg-white">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-warning">
                        <i class="bi bi-pencil-square fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Cập Nhật Thông Tin Sửa Chữa #@Model.LogId</h4>
                        <p class="text-muted small mb-0">Cập nhật chi phí thực tế, ghi chú linh kiện thay thế và nghiệm thu hoàn thành.</p>
                    </div>
                </div>

                <form asp-action="Edit" asp-route-id="@Model.LogId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LogId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="EquipmentId" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="EquipmentId" class="form-select rounded-3" asp-items="ViewBag.EquipmentsList"></select>
                            <span asp-validation-for="EquipmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaintenanceDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="MaintenanceDate" type="date" class="form-control rounded-3" />
                            <span asp-validation-for="MaintenanceDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Status" class="form-select rounded-3">
                                <option value="Đang bảo dưỡng">Đang bảo dưỡng</option>
                                <option value="Chờ linh kiện">Chờ linh kiện thay thế</option>
                                <option value="Hoàn thành">Hoàn thành (Đã nghiệm thu xong)</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Cost" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <input asp-for="Cost" type="number" class="form-control rounded-start-3" min="0" step="10000" />
                                <span class="input-group-text bg-light text-muted">VNĐ</span>
                            </div>
                            <span asp-validation-for="Cost" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PerformedBy" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="PerformedBy" class="form-control rounded-3" />
                            <span asp-validation-for="PerformedBy" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Notes" class="form-control rounded-3" rows="3" 
                                      placeholder="Ghi chú chi tiết: Đã thay cáp thép 5mm, tra dầu bôi trơn trục chính, nghiệm thu đạt chuẩn an toàn..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input asp-for="SyncEquipmentStatus" class="form-check-input ms-0 me-3" type="checkbox" id="syncStatusSwitchEdit" checked />
                                <label class="form-check-label fw-semibold text-dark small" for="syncStatusSwitchEdit">
                                    Tự động đồng bộ tình trạng máy khi hoàn thành sửa chữa
                                </label>
                                <div class="text-muted small ps-5">
                                    Khi chọn "Hoàn thành", thiết bị sẽ được đưa về "Hoạt động tốt" và cập nhật ngày bảo dưỡng gần nhất.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 px-4">Hủy</a>
                        <button type="submit" class="btn btn-warning rounded-3 px-4 fw-semibold text-dark">
                            <i class="bi bi-check-lg me-1"></i> Lưu Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

