@model IEnumerable<WebGym.Models.Entities.GymPackage>
@{
    Layout = null;
    ViewData["Title"] = "Pulse Gym - Bứt phá giới hạn";
    var packages = Model ?? (IEnumerable<WebGym.Models.Entities.GymPackage>?)ViewBag.FeaturedPackages ?? Enumerable.Empty<WebGym.Models.Entities.GymPackage>();
    var trainers = (IEnumerable<WebGym.Models.Entities.Trainer>?)ViewBag.Trainers ?? Enumerable.Empty<WebGym.Models.Entities.Trainer>();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pulse.css" asp-append-version="true" />
</head>
<body>
    <header class="nav">
        <a href="#top" class="logo"><i class="logo-bars"></i>PULSE <span>GYM</span></a>
        <nav class="nav-links">
            <a href="#khu-vuc">Khu vực tập</a>
            <a href="#lich-tap">Lịch tập</a>
            <a href="#huan-luyen-vien">Huấn luyện viên</a>
            <a href="#bang-gia">Bảng giá</a>
        </nav>
        <div class="nav-actions"><a href="~/Auth/Login" class="btn btn-sm btn-ghost">Đăng nhập</a><a href="~/Auth/Register" class="btn btn-sm">Đăng ký</a></div>
    </header>

    <main id="top">
        <!-- HERO -->
        <section class="hero">
            <div class="hero-text">
                <p class="eyebrow">Không viện cớ. Chỉ kết quả.</p>
                <h1 class="display">Bứt phá<em class="outline">giới hạn</em></h1>
                <p class="lead">Đánh thức phiên bản mạnh mẽ nhất của bạn với không gian tập luyện chuẩn quốc tế và đội ngũ huấn luyện viên tận tâm.</p>
                <div class="hero-cta">
                    <a href="#bang-gia" class="btn">Bắt đầu ngay <b>→</b></a>
                    <button type="button" class="play" id="playIntro" aria-haspopup="dialog"><span>▶</span>Khám phá Pulse</button>
                </div>
                <ul class="stats">
                    <li><strong>2.5K<sup>+</sup></strong><span>Hội viên đang tập luyện</span></li>
                    <li><strong>25<sup>+</sup></strong><span>Huấn luyện viên chuyên nghiệp</span></li>
                    <li><strong>12</strong><span>Năm đồng hành cùng thể hình Việt</span></li>
                </ul>
            </div>
            <div class="hero-media">
                <img src="~/images/hero.jpg" asp-append-version="true" alt="Hội viên Pulse Gym đang tập luyện" />
                <div class="chip chip-open"><small><i class="dot"></i>Mở cửa hôm nay</small><strong>05:00 — 23:00</strong></div>
                <div class="chip chip-sat"><span class="arrow-box">↗</span><div><strong>98%</strong><small>Hội viên hài lòng</small></div></div>
            </div>
        </section>

        <!-- MARQUEE -->
        <div class="marquee" aria-hidden="true">
            <div class="marquee-track">
                <span>Train hard</span><i>✦</i><span>Stay strong</span><i>✦</i><span>No excuses</span><i>✦</i><span>Go beyond</span><i>✦</i>
                <span>Train hard</span><i>✦</i><span>Stay strong</span><i>✦</i><span>No excuses</span><i>✦</i><span>Go beyond</span><i>✦</i>
                <span>Train hard</span><i>✦</i><span>Stay strong</span><i>✦</i><span>No excuses</span><i>✦</i><span>Go beyond</span><i>✦</i>
            </div>
        </div>

        <!-- KHU VỰC TẬP LUYỆN -->
        <section id="khu-vuc" class="section">
            <div class="head">
                <div>
                    <p class="eyebrow">Cơ sở vật chất</p>
                    <h2 class="display">Không gian<em class="outline">của người mạnh</em></h2>
                </div>
                <p class="head-note">Mỗi khu vực được thiết kế riêng với trang thiết bị chuẩn quốc tế, để bạn tập luyện thoải mái và hiệu quả hơn.</p>
            </div>
            <div class="programs">
                <a asp-controller="Home" asp-action="FacilityDetail" asp-route-id="khu-ta-tu-do" class="program"><img src="~/images/gym.jpg" asp-append-version="true" alt="" /><span class="num">01</span><div><small>Sức mạnh • Hình thể</small><h3>Tạ tự do</h3></div><span class="arrow-circle">↗</span></a>
                <a asp-controller="Home" asp-action="FacilityDetail" asp-route-id="khu-cardio" class="program"><img src="~/images/hiit.jpg" asp-append-version="true" alt="" /><span class="num">02</span><div><small>Đốt mỡ • Sức bền</small><h3>Cardio</h3></div><span class="arrow-circle">↗</span></a>
                <a asp-controller="Home" asp-action="FacilityDetail" asp-route-id="phong-boxing" class="program"><img src="~/images/boxing.jpg" asp-append-version="true" alt="" /><span class="num">03</span><div><small>Phản xạ • Bùng nổ</small><h3>Boxing</h3></div><span class="arrow-circle">↗</span></a>
                <a asp-controller="Home" asp-action="FacilityDetail" asp-route-id="studio-yoga" class="program"><img src="~/images/yoga.jpg" asp-append-version="true" alt="" /><span class="num">04</span><div><small>Cân bằng • Linh hoạt</small><h3>Yoga</h3></div><span class="arrow-circle">↗</span></a>
            </div>
        </section>

        <!-- SCHEDULE -->
        <section id="lich-tap" class="section">
            <div class="head">
                <div>
                    <p class="eyebrow">Lịch tập tuần này</p>
                    <h2 class="display">Sắp xếp thời gian<em class="outline">nâng tầm bản thân.</em></h2>
                </div>
                <a href="#" class="link-ul">Xem lịch đầy đủ →</a>
            </div>
            <div class="schedule">
                <div class="tabs" id="tabs"></div>
                <div id="classes"></div>
            </div>
        </section>

        <!-- TRAINERS -->
        <section id="huan-luyen-vien" class="section section-alt">
            <div class="head">
                <div>
                    <p class="eyebrow">Đội ngũ chuyên gia</p>
                    <h2 class="display">Người dẫn lối<em class="outline">đến thành công</em></h2>
                </div>
                <p class="head-note">Không chỉ là huấn luyện viên. Họ là những người truyền cảm hứng, đồng hành và giúp bạn vượt qua mọi giới hạn.</p>
            </div>
            <!-- Toolbar: Tìm kiếm & Bộ lọc -->
            <div class="tr-toolbar">
                <div class="tr-search-box">
                    <span class="tr-search-icon" aria-hidden="true">🔍</span>
                    <input type="text" id="ptSearch" placeholder="Tìm theo tên HLV, chuyên môn (Gym, Boxing, Yoga, HIIT...)" aria-label="Tìm kiếm huấn luyện viên" />
                    <button type="button" id="ptClearSearch" class="tr-search-clear" title="Xóa tìm kiếm" style="display:none;">✕</button>
                </div>
                <div class="tr-filters" id="ptFilters">
                    <button type="button" class="tr-filter-btn active" data-filter="all">Tất cả</button>
                    <button type="button" class="tr-filter-btn" data-filter="gym">Gym & Thể hình</button>
                    <button type="button" class="tr-filter-btn" data-filter="hiit">Cardio & HIIT</button>
                    <button type="button" class="tr-filter-btn" data-filter="boxing">Boxing & Võ thuật</button>
                    <button type="button" class="tr-filter-btn" data-filter="yoga">Yoga & Phục hồi</button>
                </div>
            </div>

            <!-- Slider Danh sách trượt -->
            <div class="tr-slider-wrapper">
                <button type="button" class="tr-arrow tr-prev" id="ptPrev" aria-label="Trượt sang trái">‹</button>
                <div class="trainers-track" id="ptTrack">
                    @if (trainers.Any())
                    {
                        foreach (var t in trainers)
                        {
                            var info = WebGym.Models.TrainerInfo.FromTrainer(t);
                            var imgSrc = info.Image.StartsWith("http") ? info.Image : Url.Content("~/images/" + info.Image);
                            var specText = (t.Specialization + " " + info.Role + " " + info.Bio).ToLower();
                            var cats = new List<string> { "all" };
                            if (specText.Contains("gym") || specText.Contains("bodybuilding") || specText.Contains("tăng cơ") || specText.Contains("thể hình") || specText.Contains("crossfit") || specText.Contains("powerlifting") || specText.Contains("cử tạ")) cats.Add("gym");
                            if (specText.Contains("hiit") || specText.Contains("cardio") || specText.Contains("sức bền") || specText.Contains("calisthenics") || specText.Contains("đốt mỡ") || specText.Contains("giảm cân")) cats.Add("hiit");
                            if (specText.Contains("boxing") || specText.Contains("võ") || specText.Contains("combat") || specText.Contains("đấm")) cats.Add("boxing");
                            if (specText.Contains("yoga") || specText.Contains("pilates") || specText.Contains("phục hồi") || specText.Contains("cột sống") || specText.Contains("dẻo dai")) cats.Add("yoga");
                            var catString = string.Join(" ", cats);
                            var searchContent = $"{info.FullName} {info.Role} {t.Specialization} {info.Bio}".ToLower();

                            <article class="trainer-slide" 
                                     data-categories="@catString" 
                                     data-search="@searchContent">
                                <a asp-controller="Home" asp-action="TrainerDetail" asp-route-id="@t.TrainerId" class="trainer">
                                    <div class="photo">
                                        <img src="@imgSrc" asp-append-version="true" alt="@info.FullName" loading="lazy" />
                                        <span class="tag">@info.Badge</span>
                                    </div>
                                    <div class="trainer-info">
                                        <div>
                                            <h3>@info.FullName</h3>
                                            <small>@info.Role</small>
                                        </div>
                                        <span class="arrow-circle">↗</span>
                                    </div>
                                </a>
                            </article>
                        }
                    }
                </div>
                <button type="button" class="tr-arrow tr-next" id="ptNext" aria-label="Trượt sang phải">›</button>
            </div>

            <!-- Trạng thái trống khi tìm không thấy -->
            <div id="ptEmpty" class="tr-empty" style="display:none;">
                <p>Không tìm thấy huấn luyện viên phù hợp với từ khóa hoặc bộ lọc đã chọn.</p>
                <button type="button" class="btn btn-sm btn-ghost" onclick="resetPtSearch()">Xem tất cả HLV <b>→</b></button>
            </div>
        </section>

        <!-- PRICING -->
        <section id="bang-gia" class="section pricing">
            <p class="eyebrow center">Đầu tư cho chính bạn</p>
            <h2 class="display center">Chọn gói.<em class="outline">Bắt đầu thay đổi.</em></h2>
            <div class="billing" id="billing">
                <button class="on" data-mode="month">Hàng tháng</button>
                <button data-mode="year">Hàng năm <b>-20%</b></button>
            </div>
            <div class="plans">
                @if (packages.Any())
                {
                    foreach (var pkg in packages)
                    {
                        var plan = WebGym.Models.PlanInfo.FromGymPackage(pkg);
                        var priceInK = (long)Math.Round(plan.MonthlyPrice / 1000m);
                        <article class="plan @(plan.Popular ? "plan-hot" : "")">
                            @if (plan.Popular)
                            {
                                <span class="badge">Phổ biến nhất</span>
                            }
                            <h3>@plan.Name</h3>
                            <p class="price"><strong data-price="@priceInK">@priceInK.ToString("N0")</strong><span><b>Nghìn</b>/ tháng</span></p>
                            <p class="plan-desc">@plan.Description</p>
                            <a asp-controller="Checkout" asp-action="Index" asp-route-slug="@pkg.PackageId" data-plan-link class="btn @(plan.Popular ? "" : "btn-ghost")">Chọn gói @plan.Name <b>→</b></a>
                            <ul>
                                @foreach (var feat in plan.Features)
                                {
                                    <li>@feat</li>
                                }
                            </ul>
                        </article>
                    }
                }
            </div>
            <p class="fine">Không phí ẩn • Hủy bất cứ lúc nào • Trải nghiệm 7 ngày miễn phí</p>
        </section>

        <!-- CTA -->
        <section class="cta">
            <div>
                <p class="eyebrow dark">Sẵn sàng chưa?</p>
                <h2 class="display">Hôm nay là ngày<em class="outline dark">để bắt đầu.</em></h2>
            </div>
            <a href="#" class="btn btn-dark">Nhận 7 ngày miễn phí <b>→</b></a>
            <span class="cta-watermark" aria-hidden="true">PULSE</span>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-grid">
            <div>
                <a href="#top" class="logo"><i class="logo-bars"></i>PULSE <span>GYM</span></a>
                <p class="foot-note">Tập mạnh hơn. Sống chất hơn.<br />Bứt phá giới hạn mỗi ngày.</p>
                <div class="social"><a href="#">IG</a><a href="#">FB</a><a href="#">YT</a><a href="#">TK</a></div>
            </div>
            <div><h4>Khám phá</h4><a href="#khu-vuc">Khu vực tập</a><a href="#lich-tap">Lịch tập</a><a href="#huan-luyen-vien">Huấn luyện viên</a><a href="#bang-gia">Bảng giá</a></div>
            <div><h4>Hỗ trợ</h4><a href="#">Về chúng tôi</a><a href="#">Câu hỏi thường gặp</a><a href="#">Liên hệ</a><a href="#">Tuyển dụng</a></div>
            <div>
                <h4 class="news-title">Năng lượng mới<br />trong hộp thư.</h4>
                <p class="foot-note">Nhận bí quyết tập luyện, dinh dưỡng và ưu đãi mới nhất.</p>
                <form class="news" onsubmit="return false"><input type="email" placeholder="Email của bạn" aria-label="Email" /><button aria-label="Đăng ký">→</button></form>
                <div class="stores"><a href="#"><small>Tải trên</small>App Store</a><a href="#"><small>Tải trên</small>Google Play</a></div>
            </div>
        </div>
        <div class="footer-bottom"><span>© 2025 Pulse Gym. All rights reserved.</span><span><a href="#">Quyền riêng tư</a><a href="#">Điều khoản</a></span><span>Made for the strong</span></div>
    </footer>

    <!-- VIDEO GIỚI THIỆU -->
    <div class="video-modal" id="videoModal" role="dialog" aria-modal="true" aria-label="Video giới thiệu Pulse Gym">
        <div class="video-backdrop" data-close></div>
        <div class="video-box">
            <button type="button" class="video-close" data-close aria-label="Đóng video">✕</button>
            <video id="introVideo" controls playsinline preload="none" poster="~/images/hero.jpg">
                <source src="~/videos/intro.mp4" type="video/mp4" />
                Trình duyệt của bạn không hỗ trợ phát video.
            </video>
            <p class="video-error" id="videoError">Chưa tìm thấy video. Hãy đặt file intro.mp4 vào wwwroot/videos/.</p>
        </div>
    </div>

    <script src="~/js/pulse.js" asp-append-version="true"></script>
</body>
</html>
