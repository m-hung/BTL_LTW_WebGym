@model WebGym.Models.DTOs.Admin.ProductFilterViewModel
@{
    ViewData["Title"] = "Quản Lý Sản Phẩm & Kho Hàng";
}

<div class="container-fluid px-0">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center">
                <span class="badge bg-primary bg-opacity-10 text-primary p-2 me-2 rounded-3">
                    <i class="bi bi-box-seam-fill"></i>
                </span>
                Quản Lý Sản Phẩm & Kho Hàng
            </h3>
            <p class="text-muted mb-0 small">Theo dõi tồn kho, cảnh báo hàng sắp hết, định giá bán và quản lý danh mục sản phẩm.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Categories" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
                <i class="bi bi-tags-fill me-1"></i> Danh Mục Nhóm Hàng
            </a>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Thêm Sản Phẩm Mới
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 me-3 fs-4">
                        <i class="bi bi-boxes"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Tổng Sản Phẩm</div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalProducts</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-4 me-3 fs-4">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Sắp Hết Hàng (&lt; 5)</div>
                        <h4 class="fw-bold mb-0 text-warning">@Model.LowStockCount</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-4 me-3 fs-4">
                        <i class="bi bi-x-octagon-fill"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Đã Hết Hàng</div>
                        <h4 class="fw-bold mb-0 text-danger">@Model.OutOfStockCount</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-4 me-3 fs-4">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Giá Trị Kho Hàng</div>
                        <h5 class="fw-bold mb-0 text-success">@Model.TotalInventoryValue.ToString("N0") <small class="fs-6">đ</small></h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control bg-light border-0" placeholder="Tìm theo tên sản phẩm hoặc mô tả..." />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="categoryFilter" class="form-select bg-light border-0">
                        <option value="">-- Tất cả nhóm hàng --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">@cat.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select name="stockFilter" class="form-select bg-light border-0">
                        <option value="">-- Tất cả mức tồn kho --</option>
                        <option value="low" selected="@(Model.StockStatus == "low")">⚠️ Cảnh báo: Sắp hết (&lt; 5 cái)</option>
                        <option value="out" selected="@(Model.StockStatus == "out")">⛔ Hết hàng (0 cái)</option>
                        <option value="instock" selected="@(Model.StockStatus == "instock")">✅ Còn nhiều (≥ 5 cái)</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-3 w-100">
                        <i class="bi bi-funnel"></i> Lọc
                    </button>
                    @if (Model.CategoryId.HasValue || !string.IsNullOrEmpty(Model.StockStatus) || !string.IsNullOrEmpty(Model.SearchKeyword))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Đặt lại bộ lọc">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Products List Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 70px;">ẢNH</th>
                        <th>TÊN SẢN PHẨM</th>
                        <th>DANH MỤC</th>
                        <th>GIÁ BÁN</th>
                        <th>TỒN KHO & CẢNH BÁO</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-4" style="width: 140px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Products.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-box2 display-6 d-block mb-2 text-secondary opacity-50"></i>
                                Không tìm thấy sản phẩm nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Products)
                        {
                            var isLowStock = item.StockQuantity > 0 && item.StockQuantity < 5;
                            var isOutOfStock = item.StockQuantity <= 0;
                            var rowBg = isOutOfStock ? "bg-danger bg-opacity-10" : (isLowStock ? "bg-warning bg-opacity-10" : "");

                            <tr class="@rowBg">
                                <td class="ps-4">
                                    <div class="rounded-3 overflow-hidden bg-light d-flex align-items-center justify-content-center border" style="width: 52px; height: 52px;">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@Url.Content(item.ImageUrl)" alt="@item.ProductName" class="img-fluid object-fit-cover w-100 h-100" onerror="this.onerror=null; this.src='/images/default-product.svg';" />
                                        }
                                        else
                                        {
                                            <img src="/images/default-product.svg" alt="Sản phẩm" class="img-fluid object-fit-cover w-100 h-100" />
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.ProductName</div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <div class="text-muted small text-truncate" style="max-width: 280px;" title="@item.Description">@item.Description</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 rounded-pill small">
                                        <i class="bi bi-tag me-1"></i>@(item.Category?.CategoryName ?? "Chưa phân loại")
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">@item.Price.ToString("N0") đ</span>
                                </td>
                                <td>
                                    @if (isOutOfStock)
                                    {
                                        <span class="badge bg-danger px-2 py-1 rounded-pill animate__animated animate__pulse animate__infinite">
                                            <i class="bi bi-x-circle me-1"></i> Hết hàng (0)
                                        </span>
                                    }
                                    else if (isLowStock)
                                    {
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <span class="badge bg-danger text-white px-2 py-1 rounded-pill shadow-sm">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Sắp hết: @item.StockQuantity cái
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill">
                                            <i class="bi bi-check2-circle me-1"></i> @item.StockQuantity cái
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-2 py-1">Đang bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary rounded-pill px-2 py-1">Ngưng bán</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-outline-primary" title="Chỉnh sửa sản phẩm">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@item.ProductId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="@(item.IsActive ? "Tạm ngưng bán" : "Mở bán lại")">
                                                <i class="bi bi-toggle-@(item.IsActive ? "on" : "off")"></i>
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-outline-danger btn-delete-product" 
                                                data-id="@item.ProductId" 
                                                data-name="@item.ProductName" 
                                                title="Xóa sản phẩm">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Hidden Delete Form -->
<form id="deleteProductForm" method="post" asp-action="Delete" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteProductId" name="id" value="" />
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteButtons = document.querySelectorAll('.btn-delete-product');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const prodId = this.getAttribute('data-id');
                    const prodName = this.getAttribute('data-name');

                    Swal.fire({
                        title: 'Xác nhận xóa sản phẩm?',
                        text: `Bạn có chắc chắn muốn xóa "${prodName}"? (Nếu sản phẩm đã từng phát sinh đơn hàng, hệ thống sẽ tự động chuyển sang trạng thái ngưng kinh doanh)`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#ef4444',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'Đồng ý xóa',
                        cancelButtonText: 'Hủy bỏ'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const form = document.getElementById('deleteProductForm');
                            document.getElementById('deleteProductId').value = prodId;
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}

