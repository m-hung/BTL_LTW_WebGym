@model IEnumerable<WebGym.Models.Entities.Trainer>
@{
    ViewData["Title"] = "Quản Lý Huấn Luyện Viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-person-badge-fill text-success"></i> Đội Ngũ Huấn Luyện Viên (PT)</h2>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>HLV</th>
                    <th>Chuyên Môn</th>
                    <th>Tiểu Sử / Chứng Chỉ</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@t.User.FullName</div>
                            <small class="text-muted">@t.User.Email | @t.User.PhoneNumber</small>
                        </td>
                        <td><span class="badge bg-primary">@t.Specialization</span></td>
                        <td><small class="text-muted">@(t.Bio ?? "HLV chuyên nghiệp")</small></td>
                        <td>
                            <span class="badge bg-success">Đang hoạt động</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
