@model WebGym.Models.DTOs.Member.MemberPackageViewModel
@{
    ViewData["Title"] = "Gói Tập Thẻ Hội Viên";
}

<!-- SECTION 1: DIGITAL VIP MEMBERSHIP CARD & ACTIVE PACKAGE INFO (Kích thước cân đối, thông tin to rõ dễ đọc) -->
<div class="row g-3 mb-4 align-items-stretch">
    <!-- Left Column: Thẻ Hội Viên Điện Tử (Gọn gàng, tỉ lệ chuẩn thẻ VIP) -->
    <div class="col-12 col-md-5 col-lg-5">
        <div class="digital-vip-card h-100">
            <!-- Card Header: Brand & Tier Badge -->
            <div class="d-flex justify-content-between align-items-center mb-1">
                <div class="d-flex align-items-center gap-2">
                    <i class="portal-logo-bars" style="width: 16px; height: 14px;"></i>
                    <span style="font-family: var(--portal-display); font-size: 14px; letter-spacing: 0.08em; color: #ffffff;">
                        PULSE FITNESS CLUB
                    </span>
                </div>
                <span class="portal-badge" style="background: rgba(200, 255, 46, 0.16); color: var(--portal-lime); border: 1px solid rgba(200, 255, 46, 0.35); font-size: 10.5px; padding: 2.5px 8px;">
                    @Model.PackageTier
                </span>
            </div>

            <!-- Card Chip Graphic -->
            <div class="my-1">
                <div class="card-chip"></div>
            </div>

            <!-- Card Number -->
            <div class="my-1">
                <div class="card-number-display">
                    @Model.CardNumber
                </div>
            </div>

            <!-- Card Footer: Member Name & Expiry -->
            <div class="d-flex justify-content-between align-items-end pt-2 border-top border-secondary border-opacity-25">
                <div>
                    <span class="d-block small" style="color: #9aa296; font-size: 9.5px; letter-spacing: 0.05em; line-height: 1;">CHỦ THẺ HỘI VIÊN</span>
                    <div class="card-holder-name">
                        @Model.MemberName
                    </div>
                </div>
                <div class="text-end">
                    <span class="d-block small" style="color: #9aa296; font-size: 9.5px; letter-spacing: 0.05em; line-height: 1;">HẠN DÙNG</span>
                    <div class="card-expiry-badge">
                        @(Model.EndDate?.ToString("dd / MM / yyyy") ?? "VÔ THỜI HẠN")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Thông Tin Gói Tập Đang Hoạt Động (Rõ ràng, dễ đọc, cân đối) -->
    <div class="col-12 col-md-7 col-lg-7">
        <div class="portal-card p-3 p-md-3 h-100 d-flex flex-column justify-content-between" style="border-radius: 10px;">
            <div>
                <div class="mb-2 pb-2 border-bottom border-secondary border-opacity-25 d-flex align-items-center gap-2">
                    <i class="bi bi-card-checklist" style="color: var(--portal-lime); font-size: 15px;"></i>
                    <h3 class="portal-title-accent mb-0" style="font-size: 14px; letter-spacing: 0.04em;">
                        THÔNG TIN <span style="color: var(--portal-lime);">GÓI TẬP ĐANG HOẠT ĐỘNG</span>
                    </h3>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <span class="d-block" style="color: #9aa296; font-size: 11.5px; line-height: 1.2; margin-bottom: 2px;">Gói tập:</span>
                        <strong class="d-block text-truncate" style="color: #ffffff; font-size: 13.5px; line-height: 1.3;" title="@Model.PackageName">
                            @Model.PackageName
                        </strong>
                    </div>

                    <div class="col-6">
                        <span class="d-block" style="color: #9aa296; font-size: 11.5px; line-height: 1.2; margin-bottom: 2px;">Trạng thái:</span>
                        @if (Model.HasActivePackage)
                        {
                            <span class="portal-badge portal-badge-approved d-inline-block mt-0" style="font-size: 11px; padding: 2.5px 8px; line-height: 1.2;">
                                • Đang hoạt động (Active)
                            </span>
                        }
                        else
                        {
                            <span class="portal-badge portal-badge-cancelled d-inline-block mt-0" style="font-size: 11px; padding: 2.5px 8px; line-height: 1.2;">
                                • Chưa kích hoạt / Hết hạn
                            </span>
                        }
                    </div>

                    <div class="col-6">
                        <span class="d-block" style="color: #9aa296; font-size: 11.5px; line-height: 1.2; margin-bottom: 2px;">Ngày đăng ký:</span>
                        <strong style="color: #dce1d8; font-size: 13px; line-height: 1.3;">
                            @(Model.StartDate?.ToString("dd/MM/yyyy") ?? "--")
                        </strong>
                    </div>

                    <div class="col-6">
                        <span class="d-block" style="color: #9aa296; font-size: 11.5px; line-height: 1.2; margin-bottom: 2px;">Ngày kết thúc:</span>
                        <strong style="color: #dce1d8; font-size: 13px; line-height: 1.3;">
                            @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "--")
                        </strong>
                    </div>

                    <div class="col-6">
                        <span class="d-block" style="color: #9aa296; font-size: 11.5px; line-height: 1.2; margin-bottom: 2px;">Giá gói:</span>
                        <strong style="color: var(--portal-lime); font-family: var(--portal-display); font-size: 15px; line-height: 1.2;">
                            @(Model.Price > 0 ? Model.Price.ToString("N0") + " VNĐ" : "Miễn phí / Quà tặng")
                        </strong>
                    </div>

                    <div class="col-6">
                        <span class="d-block" style="color: #9aa296; font-size: 11.5px; line-height: 1.2; margin-bottom: 2px;">Thời gian còn lại:</span>
                        <strong style="color: #48cae4; font-size: 13.5px; line-height: 1.2;">
                            @(Model.HasActivePackage ? $"{Model.RemainingDays} ngày" : "0 ngày")
                        </strong>
                    </div>
                </div>
            </div>

            <!-- Action Buttons (Mở Pop-up Modal theo yêu cầu ảnh 4) -->
            <div class="pt-2 border-top border-secondary border-opacity-25 d-flex flex-wrap gap-2">
                <button type="button" class="card-action-btn card-action-btn-primary" data-bs-toggle="modal" data-bs-target="#renewPackageModal">
                    <i class="bi bi-arrow-repeat me-1"></i> Gia hạn gói
                </button>
                <button type="button" class="card-action-btn card-action-btn-outline" data-bs-toggle="modal" data-bs-target="#upgradePackageModal">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Nâng cấp gói
                </button>
            </div>
        </div>
    </div>
</div>
<!-- SECTION 2: LỊCH SỬ ĐĂNG KÝ GIAO DỊCH GÓI TẬP -->
<div class="portal-card p-4 mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
        <div>
            <h3 class="portal-title-accent fs-4 mb-0">LỊCH SỬ <span>ĐĂNG KÝ GIAO DỊCH GÓI TẬP</span></h3>
        </div>
        <span style="color: #b0b7ad; font-size: 13.5px;">Tổng cộng: @Model.History.Count giao dịch</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="color: #cfd5ca !important;">MÃ HĐ</th>
                    <th style="color: #cfd5ca !important;">GÓI TẬP</th>
                    <th style="color: #cfd5ca !important;">NGÀY KÍCH HOẠT</th>
                    <th style="color: #cfd5ca !important;">NGÀY HẾT HẠN</th>
                    <th style="color: #cfd5ca !important;">GIÁ TIỀN</th>
                    <th style="color: #cfd5ca !important;">TÌNH TRẠNG</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.History.Any())
                {
                    foreach (var item in Model.History)
                    {
                        <tr>
                            <td>
                                <strong style="color: #e5eae0; font-family: var(--portal-display); font-size: 16px; letter-spacing: 0.04em;">
                                    @item.InvoiceCode
                                </strong>
                            </td>
                            <td>
                                <span class="fw-semibold" style="color: #ffffff; font-size: 15px;">
                                    @item.PackageName
                                </span>
                            </td>
                            <td>
                                <span style="color: #b5bcaf; font-size: 14px;">
                                    @item.StartDate.ToString("dd/MM/yyyy")
                                </span>
                            </td>
                            <td>
                                <span style="color: #b5bcaf; font-size: 14px;">
                                    @item.EndDate.ToString("dd/MM/yyyy")
                                </span>
                            </td>
                            <td>
                                <span class="fw-bold" style="color: var(--portal-lime); font-size: 15px;">
                                    @(item.Amount.ToString("N0")) đ
                                </span>
                            </td>
                            <td>
                                @if (item.Status == "Đã thanh toán" || item.Status == "Active")
                                {
                                    <span class="portal-badge" style="background: rgba(46, 213, 115, 0.16); color: #2ed573; border: 1px solid rgba(46, 213, 115, 0.35);">
                                        Đã thanh toán
                                    </span>
                                }
                                else if (item.Status == "Đã hoàn thành" || item.Status == "Expired")
                                {
                                    <span class="portal-badge" style="background: rgba(72, 202, 228, 0.16); color: #48cae4; border: 1px solid rgba(72, 202, 228, 0.35);">
                                        Đã hoàn thành
                                    </span>
                                }
                                else
                                {
                                    <span class="portal-badge" style="background: rgba(255, 255, 255, 0.05); color: #9da499; border: 1px solid #333d36;">
                                        @item.Status
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4" style="color: #9aa296;">
                            Chưa ghi nhận lịch sử giao dịch nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- SECTION 3: ĐẶC QUYỀN HỘI VIÊN -->
<div class="portal-card p-4">
    <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-25 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <h3 class="portal-title-accent fs-4 mb-0">ĐẶC QUYỀN <span>HỘI VIÊN GÓI @Model.PackageTier</span></h3>
            <div style="color: #a6ada2; font-size: 13.5px;">
                Các quyền lợi và tiện ích đi kèm xuyên suốt thời gian hiệu lực của gói tập (@Model.PackageName)
            </div>
        </div>
        <span class="portal-badge" style="background: rgba(200, 255, 46, 0.12); color: var(--portal-lime); border: 1px solid rgba(200, 255, 46, 0.3); font-size: 11px;">
            @Model.PackageName
        </span>
    </div>

    @if (Model.PackageName.Contains("Đồng", StringComparison.OrdinalIgnoreCase) || Model.PackageId == 1)
    {
        <!-- 6 Đặc quyền chuẩn của Gói Đồng (Basic) -->
        <div class="row g-3">
            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-clock-history me-1" style="color: var(--portal-lime);"></i> Tập luyện không giới hạn khung giờ
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Toàn quyền sử dụng hệ thống máy tập Gym & Cardio chuẩn quốc tế tại mọi khung giờ mở cửa trong ngày (06:00 - 22:00).
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-shield-lock me-1" style="color: var(--portal-lime);"></i> Smart Locker cá nhân an toàn
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Sử dụng hệ thống tủ đồ cá nhân thông minh bảo mật cao bằng thẻ từ trong suốt thời gian tập luyện.
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-droplet-half me-1" style="color: var(--portal-lime);"></i> Phòng tắm nóng lạnh & Thay đồ chuẩn 5 sao
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Khu vực vệ sinh, phòng thay đồ và phòng tắm nóng lạnh riêng biệt, sạch sẽ, máy sấy tóc tiện nghi.
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-cup-straw me-1" style="color: var(--portal-lime);"></i> Nước uống tinh khiết miễn phí
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Hệ thống cây nước lọc tinh khiết tự động hai chế độ nóng/lạnh được trang bị tại các khu vực tập.
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-wifi me-1" style="color: var(--portal-lime);"></i> Wifi tốc độ cao & Âm nhạc truyền cảm hứng
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Không gian tập luyện hiện đại với âm nhạc chuyên dụng kích thích năng lượng và internet không dây tốc độ cao.
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-person-arms-up me-1" style="color: var(--portal-lime);"></i> Hướng dẫn kỹ thuật thiết bị an toàn
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Đội ngũ huấn luyện viên sàn luôn túc trực hỗ trợ hướng dẫn vận hành máy tập chuẩn form và an toàn.
                    </div>
                </div>
            </div>
        </div>

        <!-- Banner thông báo nâng cấp gói có PT & Sauna -->
        <div class="mt-4 p-3 rounded d-flex flex-column flex-md-row align-items-center justify-content-between gap-3" 
             style="background: rgba(200, 255, 46, 0.06); border: 1px dashed rgba(200, 255, 46, 0.35);">
            <div class="d-flex align-items-center gap-3">
                <div style="width: 44px; height: 44px; border-radius: 50%; background: rgba(200, 255, 46, 0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <i class="bi bi-lightning-charge-fill" style="color: var(--portal-lime); font-size: 20px;"></i>
                </div>
                <div>
                    <div class="fw-bold text-white" style="font-size: 14.5px;">Muốn có Huấn luyện viên kèm 1-1 và sử dụng Sauna & Bể bơi?</div>
                    <div class="small" style="color: #a6ada2;">Nâng cấp lên <strong>Gói Vàng (VIP 6 Tháng kèm PT)</strong> hoặc <strong>Gói Kim Cương (VVIP 1 Năm kèm PT)</strong> để mở khóa tính năng Đặt lịch PT!</div>
                </div>
            </div>
            <button type="button" class="btn-pulse-primary text-nowrap py-2 px-3" data-bs-toggle="modal" data-bs-target="#upgradePackageModal" style="font-size: 13.5px;">
                <i class="bi bi-arrow-up-right-circle me-1"></i> Nâng cấp ngay
            </button>
        </div>
    }
    else if (Model.PackageName.Contains("Bạc", StringComparison.OrdinalIgnoreCase) || Model.PackageId == 2)
    {
        <!-- Đặc quyền Gói Bạc (Standard) -->
        <div class="row g-3">
            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-clock-history me-1" style="color: var(--portal-lime);"></i> Tập luyện không giới hạn khung giờ
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Toàn quyền sử dụng hệ thống máy tập chuẩn Olympic quốc tế tại mọi khung giờ mở cửa trong ngày.
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-activity me-1" style="color: var(--portal-lime);"></i> Đo phân tích chỉ số InBody miễn phí
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Được đo và theo dõi các chỉ số cơ thể định kỳ 2 lần/tháng bằng máy InBody chuyên dụng.
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-shield-lock me-1" style="color: var(--portal-lime);"></i> Smart Locker cá nhân & Khăn tập
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Tủ đồ thông minh bảo mật cao và khăn tập kháng khuẩn sạch sẽ được cấp mỗi buổi tập.
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-droplet-half me-1" style="color: var(--portal-lime);"></i> Phòng tắm nước nóng & Khu vực thư giãn
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Miễn phí phòng tắm nước nóng hiện đại, máy sấy tóc và khu vực thư giãn sau tập.
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-percent me-1" style="color: var(--portal-lime);"></i> Ưu đãi giảm giá 5% tại quầy Pulse Bar
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Chiết khấu trực tiếp khi mua Whey Protein, BCAA, đồ uống bổ sung dinh dưỡng tại phòng tập.
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-person-arms-up me-1" style="color: var(--portal-lime);"></i> Hướng dẫn kỹ thuật thiết bị an toàn
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Đội ngũ huấn luyện viên sàn luôn túc trực hỗ trợ hướng dẫn vận hành máy tập chuẩn form.
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Đặc quyền VIP (Gói Vàng & Kim Cương kèm PT) -->
        <div class="row g-3">
            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-clock-history me-1" style="color: var(--portal-lime);"></i> Tập luyện không giới hạn khung giờ
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Toàn quyền sử dụng hệ thống máy tập chuẩn Olympic quốc tế tại mọi khung giờ mở cửa trong ngày.
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-activity me-1" style="color: var(--portal-lime);"></i> Đo phân tích chỉ số InBody miễn phí
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Được đo và theo dõi các chỉ số cơ thể định kỳ 2 lần/tháng bằng máy InBody chuyên dụng.
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-water me-1" style="color: var(--portal-lime);"></i> Phòng xông hơi & khu vực thư giãn cao cấp
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Miễn phí phòng xông hơi đá muối Himalaya, bể bơi 4 mùa và phòng tắm nóng lạnh hiện đại.
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-person-badge-fill me-1" style="color: var(--portal-lime);"></i> Kèm huấn luyện viên 1-1 chuyên nghiệp (PT)
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Kèm theo các buổi hướng dẫn kỹ thuật bài tập, lên giáo án và chế độ dinh dưỡng tối ưu từ HLV.
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-shield-lock me-1" style="color: var(--portal-lime);"></i> Smart Locker cá nhân & khăn tập riêng
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Tủ đồ thông minh bảo mật cao và khăn tập kháng khuẩn sạch sẽ được cấp mỗi buổi tập.
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="perk-box">
                    <div class="fw-semibold mb-1" style="color: #f2f5ef; font-size: 15px;">
                        <i class="bi bi-percent me-1" style="color: var(--portal-lime);"></i> Ưu đãi giảm giá 15% thực phẩm bổ sung
                    </div>
                    <div class="small" style="color: #9aa296; line-height: 1.5;">
                        Chiết khấu trực tiếp khi mua Whey Protein, BCAA, Pre-workout và phụ kiện tập luyện tại quầy Pulse Bar.
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- ==========================================
     MODAL 1: GIA HẠN GÓI TẬP (Yêu cầu ảnh 4)
     ========================================== -->
<div class="modal fade" id="renewPackageModal" tabindex="-1" aria-labelledby="renewPackageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #141916; border: 1px solid rgba(200, 255, 46, 0.35); border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.7); color: #f2f5ef;">
            <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-bold" id="renewPackageModalLabel" style="font-family: var(--portal-display); font-size: 19px; letter-spacing: 0.04em; color: #ffffff;">
                    <i class="bi bi-arrow-repeat" style="color: var(--portal-lime); font-size: 20px;"></i>
                    GIA HẠN <span style="color: var(--portal-lime);">GÓI TẬP HIỆN TẠI</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                @if (Model.HasActivePackage)
                {
                    <div class="p-3 mb-3 rounded" style="background: rgba(200, 255, 46, 0.06); border: 1px solid rgba(200, 255, 46, 0.2);">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                            <span class="small" style="color: #9aa296;">Gói tập đang dùng:</span>
                            <strong class="text-white" style="font-size: 14.5px;">@Model.PackageName</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                            <span class="small" style="color: #9aa296;">Hạn sử dụng hiện tại:</span>
                            <strong style="color: #dce1d8;">@(Model.EndDate?.ToString("dd/MM/yyyy") ?? "--")</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                            <span class="small" style="color: #9aa296;">Thời gian gia hạn thêm:</span>
                            <strong style="color: #48cae4;">+ @Model.DurationDays ngày</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small" style="color: #9aa296;">Chi phí gia hạn:</span>
                            <strong style="color: var(--portal-lime); font-family: var(--portal-display); font-size: 18px;">
                                @(Model.Price > 0 ? Model.Price.ToString("N0") + " VNĐ" : "Miễn phí")
                            </strong>
                        </div>
                    </div>
                    <div class="small p-2 rounded" style="background: rgba(0,0,0,0.3); color: #8f968c; line-height: 1.5;">
                        <i class="bi bi-shield-check me-1" style="color: var(--portal-lime);"></i>
                        Hệ thống sẽ tự động cộng dồn thời hạn tiếp nối vào ngày kết thúc hiện tại sau khi thanh toán thành công qua cổng VNPAY an toàn.
                    </div>
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="bi bi-exclamation-circle text-warning fs-1 mb-2 d-block"></i>
                        <h6 class="text-white mb-2">Bạn chưa có gói tập nào đang hoạt động</h6>
                        <p class="small text-secondary mb-0">Vui lòng đăng ký gói tập mới hoặc chọn mục Nâng cấp gói để bắt đầu rèn luyện thể chất.</p>
                    </div>
                }
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 pt-3">
                <button type="button" class="btn-pulse-outline py-2 px-3" data-bs-dismiss="modal" style="font-size: 13px;">Đóng</button>
                @if (Model.HasActivePackage)
                {
                    <a href="/thanh-toan/@(Model.PackageId ?? 1)" class="btn-pulse-primary py-2 px-3" style="font-size: 13px;">
                        <i class="bi bi-credit-card me-1"></i> Xác Nhận Thanh Toán Gia Hạn
                    </a>
                }
                else
                {
                    <button type="button" class="btn-pulse-primary py-2 px-3" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#upgradePackageModal" style="font-size: 13px;">
                        Khám Phá Gói Tập
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     MODAL 2: NÂNG CẤP GÓI TẬP (Yêu cầu ảnh 4)
     ========================================== -->
<div class="modal fade" id="upgradePackageModal" tabindex="-1" aria-labelledby="upgradePackageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: #141916; border: 1px solid rgba(200, 255, 46, 0.35); border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.7); color: #f2f5ef;">
            <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-bold" id="upgradePackageModalLabel" style="font-family: var(--portal-display); font-size: 20px; letter-spacing: 0.04em; color: #ffffff;">
                    <i class="bi bi-lightning-charge-fill" style="color: var(--portal-lime); font-size: 21px;"></i>
                    NÂNG CẤP <span style="color: var(--portal-lime);">GÓI TẬP VIP & HUẤN LUYỆN VIÊN (PT)</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="mb-3 text-secondary small">
                    Chọn gói tập phù hợp để nâng tầm vóc dáng, mở khóa đặc quyền phòng Sauna, bể bơi và Huấn luyện viên kèm 1-1 chuyên nghiệp:
                </div>

                @{
                    var availablePackages = ViewBag.AvailablePackages as List<WebGym.Models.Entities.GymPackage> ?? new List<WebGym.Models.Entities.GymPackage>();
                }

                <div class="row g-3">
                    @if (availablePackages.Any())
                    {
                        foreach (var pkg in availablePackages)
                        {
                            bool isCurrent = Model.PackageName == pkg.PackageName;
                            <div class="col-md-6">
                                <div class="p-3 h-100 d-flex flex-column justify-content-between rounded position-relative" 
                                     style="background: #18201b; border: 1px solid @(pkg.IncludesPT ? "rgba(200, 255, 46, 0.45)" : "rgba(255, 255, 255, 0.1)"); box-shadow: @(pkg.IncludesPT ? "0 4px 15px rgba(200, 255, 46, 0.08)" : "none");">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="fw-bold text-white mb-0" style="font-size: 15px;">@pkg.PackageName</h6>
                                            @if (pkg.IncludesPT)
                                            {
                                                <span class="portal-badge" style="background: rgba(200, 255, 46, 0.18); color: var(--portal-lime); border: 1px solid rgba(200, 255, 46, 0.4); font-size: 9.5px; padding: 2px 7px;">
                                                    <i class="bi bi-star-fill me-1"></i> KÈM PT 1-1
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="portal-badge" style="background: rgba(255, 255, 255, 0.08); color: #dce1d8; font-size: 9.5px; padding: 2px 7px;">
                                                    CƠ BẢN
                                                </span>
                                            }
                                        </div>

                                        <div class="d-flex align-items-baseline gap-1 mb-2">
                                            <span style="font-family: var(--portal-display); font-size: 20px; font-weight: 700; color: var(--portal-lime);">
                                                @pkg.Price.ToString("N0") VNĐ
                                            </span>
                                            <span class="small" style="color: #9aa296;">/ @pkg.DurationDays ngày</span>
                                        </div>

                                        <p class="small mb-3" style="color: #a2a99e; line-height: 1.45; min-height: 42px;">
                                            @(pkg.Description ?? "Sử dụng đầy đủ hệ thống máy tập chuẩn Olympic, tủ locker và tiện ích cao cấp.")
                                        </p>
                                    </div>

                                    <div>
                                        @if (isCurrent)
                                        {
                                            <button type="button" class="btn btn-sm w-100 disabled" style="background: rgba(255,255,255,0.06); color: #889084; border: 1px solid rgba(255,255,255,0.1); font-size: 12.5px;">
                                                ✓ Gói Hiện Tại Đang Sử Dụng
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="/thanh-toan/@pkg.PackageId" class="btn-pulse-primary btn-sm w-100 text-center py-2" style="font-size: 12.5px; text-decoration: none;">
                                                <i class="bi bi-arrow-up-right-circle me-1"></i> Nâng Cấp Ngay
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-3 text-secondary">
                            Không có thông tin gói tập để hiển thị.
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 pt-3">
                <button type="button" class="btn-pulse-outline py-2 px-3" data-bs-dismiss="modal" style="font-size: 13px;">Đóng</button>
                <a href="/#bang-gia" class="btn-pulse-primary py-2 px-3" style="font-size: 13px; text-decoration: none;">
                    <i class="bi bi-grid-fill me-1"></i> Xem Chi Tiết Bảng Giá
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.location.hash === '#upgradePackageModal' || window.location.search.includes('action=upgrade')) {
                const modalEl = document.getElementById('upgradePackageModal');
                if (modalEl && typeof bootstrap !== 'undefined') {
                    const m = new bootstrap.Modal(modalEl);
                    m.show();
                }
            } else if (window.location.hash === '#renewPackageModal' || window.location.search.includes('action=renew')) {
                const modalEl = document.getElementById('renewPackageModal');
                if (modalEl && typeof bootstrap !== 'undefined') {
                    const m = new bootstrap.Modal(modalEl);
                    m.show();
                }
            }
        });
    </script>
}
