@model WebGym.Models.DTOs.Admin.MaintenanceLogFormViewModel
@{
    ViewData["Title"] = "Lập Phiếu Bảo Trì / Ghi Nhận Máy Hỏng";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-muted small">
                <i class="bi bi-arrow-left me-1"></i> Quay lại nhật ký bảo trì
            </a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm bg-white">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <div class="p-3 bg-danger bg-opacity-10 rounded-3 text-danger">
                        <i class="bi bi-tools fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Lập Phiếu Bảo Trì / Ghi Nhận Hỏng Hóc</h4>
                        <p class="text-muted small mb-0">Tạo phiếu sửa chữa định kỳ hoặc ghi nhận sự cố máy tập để kỹ thuật xử lý.</p>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="EquipmentId" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="EquipmentId" class="form-select rounded-3" asp-items="ViewBag.EquipmentsList">
                                <option value="">-- Chọn thiết bị gặp sự cố hoặc cần bảo dưỡng --</option>
                            </select>
                            <span asp-validation-for="EquipmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaintenanceDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="MaintenanceDate" type="date" class="form-control rounded-3" />
                            <span asp-validation-for="MaintenanceDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Status" class="form-select rounded-3">
                                <option value="Đang bảo dưỡng">Đang bảo dưỡng</option>
                                <option value="Chờ linh kiện">Chờ linh kiện thay thế</option>
                                <option value="Hoàn thành">Hoàn thành (Đã nghiệm thu xong)</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="3" 
                                      placeholder="Mô tả hiện tượng hỏng hóc hoặc nội dung bảo trì (ví dụ: đứt cáp giàn tạ, thảm chạy lệch tâm, thay dầu trục...)"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Cost" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <input asp-for="Cost" type="number" class="form-control rounded-start-3" min="0" step="10000" />
                                <span class="input-group-text bg-light text-muted">VNĐ</span>
                            </div>
                            <span asp-validation-for="Cost" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PerformedBy" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="PerformedBy" class="form-control rounded-3" placeholder="Kỹ thuật nội bộ / Công ty dịch vụ Technogym..." />
                            <span asp-validation-for="PerformedBy" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Notes" class="form-control rounded-3" rows="2" 
                                      placeholder="Ghi chú linh kiện cần đặt, mã phụ tùng hoặc thời hạn bảo hành sau sửa chữa..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input asp-for="SyncEquipmentStatus" class="form-check-input ms-0 me-3" type="checkbox" id="syncStatusSwitch" checked />
                                <label class="form-check-label fw-semibold text-dark small" for="syncStatusSwitch">
                                    Tự động cập nhật trạng thái thiết bị tương ứng
                                </label>
                                <div class="text-muted small ps-5">
                                    Nếu chọn "Hoàn thành" -> Máy chuyển về "Hoạt động tốt". Nếu "Chờ linh kiện" -> Máy chuyển về "Đang hỏng".
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 px-4">Hủy</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Lưu Phiếu Bảo Trì
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

